e badge\">\n                            <i class=\"ti ti-truck text-[14px]\" data-kid=\"1-2-3-2-1-1-2-1\" data-name=\"truck icon\" style=\"width:15px;height:15px;color:currentColor\">\n                            </i>\n                            Tanker 01\n                        </span>\n                    </div>\n                    <div class=\"map-frame\" data-kid=\"1-2-3-2-1-2\" data-name=\"schematic route map with selectable stops\">\n                        <div class=\"absolute left-3 top-3 z-10 rounded-[7px] border border-[#43504a] bg-[#0c1110]/90 px-2.5 py-1.5 text-[10px] font-medium text-[#d4ded9]\" data-kid=\"1-2-3-2-1-2-3\" data-name=\"demo map overlay badge\">\n                            DEMO MAP · NOT LIVE\n                        </div>\n                        <svg aria-label=\"Schematic route map around Pune using illustrative locations\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"interactive schematic route map\" data-reason=\"transform scale is set from an internally derived zoom variable by zoom script, masking any authored transform\" id=\"tempo-map\" preserveaspectratio=\"xMidYMid slice\" role=\"img\" viewbox=\"0 0 520 336\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <defs>\n                                <pattern height=\"34\" id=\"map-grid\" patternunits=\"userSpaceOnUse\" width=\"34\">\n                                    <path d=\"M34 0H0V34\" fill=\"none\" stroke=\"#242c29\" stroke-width=\".6\">\n                                    </path>\n                                </pattern>\n                                <pattern height=\"7\" id=\"field-dots\" patternunits=\"userSpaceOnUse\" width=\"7\">\n                                    <circle cx=\"1\" cy=\"1\" fill=\"#344039\" r=\".6\">\n                                    </circle>\n                                </pattern>\n                            </defs>\n                            <rect fill=\"#151b19\" height=\"336\" width=\"520\">\