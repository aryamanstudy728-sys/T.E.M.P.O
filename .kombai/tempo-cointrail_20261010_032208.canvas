-1-2-1\">\n                        </div>\n                        <svg aria-hidden=\"true\" class=\"map-svg\" data-kid=\"1-2-4-2-1-2-2\" preserveaspectratio=\"none\" viewbox=\"0 0 500 318\">\n                            <path class=\"map-river\" d=\"M-20 265 C75 216 105 240 168 179 S272 128 333 148 422 103 535 59\">\n                            </path>\n                            <path class=\"map-minor\" d=\"M-18 45 L118 82 180 52 269 79 352 41 520 89M-30 119 L74 144 163 111 237 132 329 92 409 127 526 97M-20 207 L71 178 164 226 252 188 326 215 407 177 519 208M46 -10 L64 70 47 122 88 202 76 333M143 -15 L128 71 174 140 147 196 173 334M249 -8 L233 67 273 120 252 199 274 332M365 -5 L344 61 388 112 367 182 394 333M465 -5 L438 74 471 143 446 218 478 330\">\n                            </path>\n                            <path class=\"map-road\" d=\"M-10 76 C62 98 93 62 149 95 S234 99 285 126 371 88 505 115M-20 160 C65 128 108 167 164 153 S264 162 323 202 413 158 515 170M18 248 C93 229 107 265 182 233 S282 241 346 267 441 230 514 248M101 -6 C96 67 185 79 181 139 S157 227 202 327M310 -6 C295 54 341 89 323 145 S297 227 353 327\">\n                            </path>\n                            <path class=\"map-main-road\" d=\"M18 282 C108 228 126 203 204 198 S285 167 349 128 427 95 491 43\">\n                            </path>\n                            <path class=\"map-route\" d=\"M150 239 C178 220 190 209 206 198 S278 168 307 150 332 136 356 125\">\n                            </path>\n                            <path class=\"map-route-alt\" d=\"M307 150 C347 180 366 196 406 210\">\n                            </path>\n                            <circle cx=\"150\" cy=\"239\" fill=\"#49d6b1\" r=\"3\">\n                            </circle>\n                            <circle cx=\"206\" cy=\"198\" fill=\"#49d6b1\" r=\"3\">\n                            </circle>\n                            <circle cx=\"307\" cy=\"150\" fill=\"#ff6b7d\" r=\"3\">\n                            </circle>\n                            <circle cx=\"356\" cy=\"125\" fill=\"#49d6b1\" r=\"3\">\n                            </circle>\n                            <text class=\"map-label\" x=\"54\" y=\"109\">\n                                Collection loop\n                            </text>\n                            <text class=\"map-label-bright\" x=\"314\" y=\"117\">\n                                Selected route\n                            </text>\n                            <text class=\"map-label\" x=\"378\" y=\"227\">\n                                BMC-001\n                            </text>\n                            <text class=\"map-label\" x=\"90\" y=\"275\">\n                                VCC-004\n                            </text>\n                        </svg>\n                        <div class=\"map-point selected\" data-kid=\"1-2-4-2-1-2-3\" style=\"left:30%;top:75%\" title=\"Tanker 1 selected\">\n                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-4-2-1-2-3-1\">\n                            </i>\n                        </div>\n                        <div class=\"map-point risk\" data-kid=\"1-2-4-2-1-2-4\" style=\"left:61.5%;top:47%\" title=\"VCC-008 red risk\">\n                            8\n                        </div>\n                        <div class=\"map-point warn\" data-kid=\"1-2-4-2-1-2-5\" style=\"left:81.2%;top:66%\" title=\"VCC-002 warning\">\n                            2\n                        </div>\n                        <div class=\"map-point bmc\" data-kid=\"1-2-4-2-1-2-6\" style=\"left:83%;top:37%\" title=\"Bulk Milk Cooler\">\n                            <i aria-hidden=\"true\" class=\"ti ti-snowflake\" data-kid=\"1-2-4-2-1-2-6-1\">\n                            </i>\n                        </div>\n                        <div class=\"map-point\" data-kid=\"1-2-4-2-1-2-7\" style=\"left:71%;top:38%\" title=\"Village collection center\">\n                            4\n                        </div>\n                        <span class=\"map-status\" data-kid=\"1-2-4-2-1-2-8\">\n                            DEMO MAP · POSITION NOT LIVE\n                        </span>\n                    </div>\n                    <div aria-label=\"Map legend\" class=\"map-legend\" data-kid=\"1-2-4-2-1-3\">\n                        <span class=\"legend-item\" data-kid=\"1-2-4-2-1-3-1\">\n                            <i class=\"legend-shape\" data-kid=\"1-2-4-2-1-3-1-1\">\n                            </i>\n                            Vehicle\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-2-1-3-2\">\n                            <i class=\"legend-shape legend-vcc\" data-kid=\"1-2-4-2-1-3-2-1\">\n                            </i>\n                            VCC\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-2-1-3-3\">\n                            <i class=\"legend-shape legend-bmc\" data-kid=\"1-2-4-2-1-3-3-1\">\n                            </i>\n                            BMC\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-2-1-3-4\">\n                            <i class=\"legend-shape legend-red\" data-kid=\"1-2-4-2-1-3-4-1\">\n                            </i>\n                            Red risk\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-2-1-3-5\">\n                            <i class=\"legend-shape legend-amber\" data-kid=\"1-2-4-2-1-3-5-1\">\n                            </i>\n                            Warning\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-2-1-3-6\">\n                            <i class=\"legend-shape legend-unknown\" data-kid=\"1-2-4-2-1-3-6-1\">\n                            </i>\n                            Unknown\n                        </span>\n                    </div>\n                    <div class=\"selected-readout\" data-kid=\"1-2-4-2-1-4\" id=\"selected-route\">\n                        <div data-kid=\"1-2-4-2-1-4-1\">\n                            <div class=\"readout-kicker\" data-kid=\"1-2-4-2-1-4-1-1\">\n                                SELECTED VEHICLE · DEMO\n                            </div>\n                            <div class=\"readout-title\" data-kid=\"1-2-4-2-1-4-1-2\">\n                                Tanker 1\n                                <span data-kid=\"1-2-4-2-1-4-1-2-1\" style=\"color:var(--muted);font-weight:500\">\n                                    / VEH-001\n                                </span>\n                            </div>\n                            <div class=\"readout-meta\" data-kid=\"1-2-4-2-1-4-1-3\">\n                                Next stop · VCC-004 · Collection Center 4\n                            </div>\n                        </div>\n                        <div class=\"tsb-block\" data-kid=\"1-2-4-2-1-4-2\">\n                            <b data-kid=\"1-2-4-2-1-4-2-1\">\n                                0.4 h\n                            </b>\n                            <span data-kid=\"1-2-4-2-1-4-2-2\">\n                                Demo TSB estimate\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"unknown-panel\" data-kid=\"1-2-4-2-1-5\">\n                        <i class=\"legend-shape\" data-kid=\"1-2-4-2-1-5-1\">\n                        </i>\n                        <span data-kid=\"1-2-4-2-1-5-2\">\n                            Live vehicle position unavailable. Route path shown for the demo scenario only.\n                        </span>\n                    </div>\n                    <div class=\"map-footer\" data-kid=\"1-2-4-2-1-6\">\n                        <span data-kid=\"1-2-4-2-1-6-1\">\n                            <strong data-kid=\"1-2-4-2-1-6-1-1\">\n                                Map layer\n                            </strong>\n                            · illustrative route geometry, not GPS\n                        </span>\n                        <a class=\"action-link\" data-kid=\"1-2-4-2-1-6-2\" href=\"#routes\">\n                            Open route details\n                            <i aria-hidden=\"true\" class=\"icon ti ti-arrow-up-right\" data-kid=\"1-2-4-2-1-6-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                </section>\n                <section aria-labelledby=\"sources-title\" class=\"panel context-panel\" data-kid=\"1-2-4-2-2\">\n                    <div class=\"context-head\" data-kid=\"1-2-4-2-2-1\">\n                        <div class=\"context-title\" data-kid=\"1-2-4-2-2-1-1\" id=\"sources-title\">\n                            Source status\n                        </div>\n                        <span class=\"source-tag\" data-kid=\"1-2-4-2-2-1-2\">\n                            <i class=\"dot\" data-kid=\"1-2-4-2-2-1-2-1\">\n                            </i>\n                            Not connected\n                        </span>\n                    </div>\n                    <p class=\"context-copy\" data-kid=\"1-2-4-2-2-2\">\n                        <strong data-kid=\"1-2-4-2-2-2-1\">\n                            Vehicle and route records:\n                        </strong>\n                        unavailable.\n                        <strong data-kid=\"1-2-4-2-2-2-2\">\n                            Alert stream:\n                        </strong>\n                        unavailable. The records above are kept separate and labeled as examples.\n                    </p>\n                    <div class=\"context-links\" data-kid=\"1-2-4-2-2-3\">\n                        <a class=\"action-link\" data-kid=\"1-2-4-2-2-3-1\" href=\"#alerts\">\n                            Review alerts\n                            <i aria-hidden=\"true\" class=\"icon ti ti-arrow-up-right\" data-kid=\"1-2-4-2-2-3-1-1\">\n                            </i>\n                        </a>\n                        <a class=\"action-link\" data-kid=\"1-2-4-2-2-3-2\" href=\"#routes\">\n                            View routes\n                            <i aria-hidden=\"true\" class=\"icon ti ti-arrow-up-right\" data-kid=\"1-2-4-2-2-3-2-1\">\n                            </i>\n                        </a>\n                    </div>\n                </section>\n                <div class=\"model-note\" data-kid=\"1-2-4-2-3\">\n                    Thermal Safety Buffer bands are model estimates. Demo thresholds are not verified operating guidance.\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
