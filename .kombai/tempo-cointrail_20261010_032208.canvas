        VEH-001\n                                <span class=\"mx-1 text-[#69756e]\" data-kid=\"1-2-3-1-3-5-4-3-1\">\n                                    ·\n                                </span>\n                                VCC not linked\n                            </p>\n                            <button class=\"mt-3 min-h-11 rounded-lg border border-[#46514b] px-4 text-[13px] font-semibold text-[#e3eae6] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-1-3-5-4-4\">\n                                Acknowledge\n                            </button>\n                        </article>\n                    </div>\n                    <div class=\"border-t border-[#29302c] px-5 py-3 text-[13px] text-[#9da8a2] max-md:px-4\" data-kid=\"1-2-3-1-3-3\" data-name=\"acknowledgement disclaimer footer\">\n                        Acknowledging an alert records that it was reviewed. Route risk and quality status remain unchanged.\n                    </div>\n                    <div class=\"border-t border-[#303733] px-5 py-3.5 max-md:px-4\" data-kid=\"1-2-3-1-3-4\" data-name=\"acknowledged history block\">\n                        <div class=\"flex items-center gap-2 text-[13px] font-semibold text-[#bdc7c1]\" data-kid=\"1-2-3-1-3-4-1\" data-name=\"history section label\">\n                            <i class=\"ti ti-history text-[15px]\" data-kid=\"1-2-3-1-3-4-1-1\" data-name=\"history icon\" style=\"width:16px;height:16px\">\n                            </i>\n                            Acknowledged history\n                            <span class=\"font-normal tabular-nums text-[#97a39d]\" data-kid=\"1-2-3-1-3-4-1-2\" data-name=\"history count\">\n                                1\n                            </span>\n                        </div>\n                        <div class=\"mt-3 grid grid-cols-[1fr_auto_auto] items-center gap-4 text-[13px] max-md:grid-cols-1 max-md:gap-2\" data-kid=\"1-2-3-1-3-4-2\" data-name=\"acknowledged record row\">\n                            <span class=\"text-[#d1dad5]\" data-kid=\"1-2-3-1-3-4-2-1\" data-name=\"acknowledged alert description\">\n                                Route change · Collection order updated for next stop\n                            </span>\n                            <span class=\"text-[#a6b0aa]\" data-kid=\"1-2-3-1-3-4-2-2\" data-name=\"acknowledged vehicle time\">\n                                VEH-002 · 08:54\n                            </span>\n                            <span class=\"text-[#80d7b5]\" data-kid=\"1-2-3-1-3-4-2-3\" data-name=\"acknowledged status label\">\n                                Acknowledged\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <p class=\"mt-3 text-[12px] text-[#86918b]\" data-kid=\"1-2-3-1-4\" data-name=\"worklist demo disclaimer\">\n                    Records in this preview use a demo scenario and do not represent live cooperative data.\n                </p>\n            </section>\n            <aside aria-label=\"Selected alert context\" class=\"space-y-5 max-md:order-last\" data-kid=\"1-2-3-2\" data-name=\"right sidebar for selected alert context\">\n                <section class=\"rounded-xl border border-[#303733] bg-[#111513] p-5\" data-kid=\"1-2-3-2-1\" data-name=\"selected alert detail card\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-2-3-2-1-1\" data-name=\"selected alert header\">\n                        <h2 class=\"font-['Space_Grotesk',sans-serif] text-[16px] font-semibold\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"selected alert heading\">\n                            Selected alert\n                        </h2>\n                        <span class=\"inline-flex min-h-7 items-center gap-1.5 rounded-md bg-[#332027] px-2.5 text-[12px] font-medium text-[#ff9ba5]\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"severity badge\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff7284]\" data-kid=\"1-2-3-2-1-1-2-1\" data-name=\"severity dot\">\n                            </span>\n                            Critical\n                        </span>\n                    </div>\n                    <div class=\"mt-5 border-t border-[#2c332f] pt-4\" data-kid=\"1-2-3-2-1-2\" data-name=\"detail content\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"alert summary block\">\n                            <span class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#332027] text-[#ff8b98]\" data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"alert type icon container\">\n                                <i class=\"ti ti-temperature\" data-kid=\"1-2-3-2-1-2-1-1-1\" data-name=\"temperature icon\" style=\"width:19px;height:19px\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-2-3-2-1-2-1-2\" data-name=\"alert summary text wrapper\">\n                                <div class=\"text-[13px] font-medium text-[#b5c0ba]\" data-kid=\"1-2-3-2-1-2-1-2-1\" data-name=\"alert type label\">\n                                    Thermal risk\n                                </div>\n                                <p class=\"mt-1 text-[14px] leading-5 text-[#e5ece8]\" data-kid=\"1-2-3-2-1-2-1-2-2\" data-name=\"alert description text\">\n                                    Thermal buffer below critical threshold at next stop\n                                </p>\n                            </div>\n                        </div>\n                        <dl class=\"mt-5 divide-y divide-[#29302c] border-y border-[#29302c] text-[13px]\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"alert details list\">\n                            <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"1-2-3-2-1-2-2-1\" data-name=\"recorded time detail row\">\n                                <dt class=\"text-[#9da8a2]\" data-kid=\"1-2-3-2-1-2-2-1-1\" data-name=\"recorded time label\">\n                                    Recorded\n                                </dt>\n                                <dd class=\"tabular-nums text-[#d8e0dc]\" data-kid=\"1-2-3-2-1-2-2-1-2\" data-name=\"recorded time value\">\n                                    09:42 · 18 Oct\n                                </dd>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"1-2-3-2-1-2-2-2\" data-name=\"vehicle detail row\">\n                                <dt class=\"text-[#9da8a2]\" data-kid=\"1-2-3-2-1-2-2-2-1\" data-name=\"vehicle label\">\n                                    Vehicle\n                                </dt>\n                                <dd data-dynamic=\"true\" data-kid=\"1-2-3-2-1-2-2-2-2\" data-name=\"vehicle value\" data-reason=\"replaced at runtime with selected record vehicle link\">\n                                    <a class=\"font-medium text-[#d8e0dc] underline decoration-[#65736b] underline-offset-4\" data-kid=\"1-2-3-2-1-2-2-2-2-1\" data-name=\"vehicle link\" href=\"#\">\n                                        VEH-001\n                                    </a>\n                                </dd>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"1-2-3-2-1-2-2-3\" data-name=\"collection center detail row\">\n                                <dt class=\"text-[#9da8a2]\" data-kid=\"1-2-3-2-1-2-2-3-1\" data-name=\"collection center label\">\n                                    Collection center\n                                </dt>\n                                <dd data-dynamic=\"true\" data-kid=\"1-2-3-2-1-2-2-3-2\" data-name=\"collection center value\" data-reason=\"replaced at runtime with selected record vcc link\">\n                                    <a class=\"font-medium text-[#d8e0dc] underline decoration-[#65736b] underline-offset-4\" data-kid=\"1-2-3-2-1-2-2-3-2-1\" data-name=\"collection center link\" href=\"#\">\n                                        VCC-014\n                                    </a>\n                                </dd>\n                            </div>\n                            <div class=\"flex items-center justify-between gap-4 py-3\" data-kid=\"1-2-3-2-1-2-2-4\" data-name=\"acknowledgment status detail row\">\n                                <dt class=\"text-[#9da8a2]\" data-kid=\"1-2-3-2-1-2-2-4-1\" data-name=\"acknowledgment label\">\n                                    Acknowledgment\n                                </dt>\n                                <dd class=\"text-[#f2d38e]\" data-kid=\"1-2-3-2-1-2-2-4-2\" data-name=\"acknowledgment status value\">\n                                    Awaiting review\n                                </dd>\n                            </div>\n                        </dl>\n                        <p class=\"mt-4 text-[13px] leading-5 text-[#a6b0aa]\" data-kid=\"1-2-3-2-1-2-3\" data-name=\"alert context help text\">\n                            Open the linked vehicle route to review its current stop sequence. No route details are inferred from this alert.\n                        </p>\n                        <button class=\"mt-4 min-h-11 w-full rounded-lg bg-[#dce9e3] px-4 text-[13px] font-semibold text-[#15201b] hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-2-1-2-4\" data-name=\"primary acknowledge alert button\">\n                            Acknowledge alert\n                        </button>\n                        <p class=\"mt-3 text-center text-[12px] leading-4 text-[#929d97]\" data-kid=\"1-2-3-2-1-2-5\" data-name=\"acknowledge disclaimer text\">\n                            Acknowledging records review only. It does not clear this risk.\n                        </p>\n                    </div>\n                </section>\n                <section class=\"border-t border-[#303733] pt-4\" data-kid=\"1-2-3-2-2\" data-name=\"data unavailability guidance section\">\n                    <h2 class=\"font-['Space_Grotesk',sans-serif] text-[15px] font-semibold\" data-kid=\"1-2-3-2-2-1\" data-name=\"when data is unavailable heading\">\n                        When data is unavailable\n                    </h2>\n                    <div class=\"mt-3 space-y-3 text-[13px] leading-5\" data-kid=\"1-2-3-2-2-2\" data-name=\"unavailable data list\">\n                        <div class=\"flex gap-3\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"offline state guidance row\">\n                            <span class=\"mt-2 h-2 w-2 shrink-0 rounded-full bg-[#ff7b8b]\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"offline state dot\">\n                            </span>\n                            <p class=\"text-[#bdc7c1]\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"offline state description\">\n                                <strong class=\"font-semibold text-[#f0a1a8]\" data-kid=\"1-2-3-2-2-2-1-2-1\" data-name=\"offline label\">\n                                    Offline:\n                                </strong>\n                                “Alerts unavailable” when the alert request fails. Do not show zero counts.\n                            </p>\n                        </div>\n                        <div class=\"flex gap-3\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"confirmed empty state guidance row\">\n                            <span class=\"mt-2 h-2 w-2 shrink-0 rounded-full bg-[#80d7b5]\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"confirmed empty state dot\">\n                            </span>\n                            <p class=\"text-[#bdc7c1]\" data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"confirmed empty state description\">\n                                <strong class=\"font-semibold text-[#90dabe]\" data-kid=\"1-2-3-2-2-2-2-2-1\" data-name=\"confirmed empty label\">\n                                    Confirmed empty:\n                                </strong>\n                                “No alerts returned” after a successful request with no records.\n                            </p>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"flex items-start gap-3 rounded-lg border border-[#3b3b2a] bg-[#191810] px-4 py-3.5 text-[13px] leading-5 text-[#c6c3ad]\" data-kid=\"1-2-3-2-3\" data-name=\"accessibility note banner\">\n                    <i class=\"ti ti-info-circle mt-0.5 text-[#eac36c]\" data-kid=\"1-2-3-2-3-1\" data-name=\"info icon\" style=\"width:17px;height:17px\">\n                    </i>\n                    <p data-kid=\"1-2-3-2-3-2\" data-name=\"accessibility note text\">\n                        Severity uses text and color. Color is never the only signal.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-10T03:33:29.741427+00:00",
      "modified": "2026-10-10T03:36:18.671804+00:00",
      "id": "var_468e56c526f1",
      "contentHeight": 1178,
      "viewportAuto": false
    },
    "var_baff1edb1153": {
      "type": "variant",
      "label": "Map-led Dispatch — Alerts",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root{--canvas:#0d1010;--surface:#131717;--surface-raised:#191e1d;--stroke:#303837;--stroke-soft:#252c2b;--ink:#edf3f0;--sub:#a4afaa;--quiet:#77837e;--mint:#53dfbd;--mint-dim:#163b33;--red:#ff6b7f;--red-dim:#3a1e25;--amber:#f2c15b;--amber-dim:#3a3020;--blue:#a7c4ff}\n.alert-app{min-height:100vh;background:var(--canvas);color:var(--ink);font:14px/1.45 Inter,ui-sans-serif,system-ui,sans-serif;letter-spacing:-.01em}\n.topbar{height:68px;border-bottom:1px solid var(--stroke-soft);display:flex;align-items:center;justify-content:space-between;padding:0 34px;background:#101313}\n.brand{display:flex;align-items:center;gap:11px;font-size:17px;font-weight:700;letter-spacing:-.045em;white-space:nowrap}.brand-mark{width:32px;height:32px;border-radius:9px;background:var(--mint);color:#09231c;display:grid;place-items:center;font-weight:800;font-size:15px;box-shadow:inset 0 0 0 1px #83f1d2}.top-left,.top-actions,.nav{display:flex;align-items:center}.top-left{gap:38px}.nav{gap:7px}.nav a{color:var(--sub);text-decoration:none;padding:9px 12px;border-radius:8px;font-weight:500}.nav a:hover{color:var(--ink);background:var(--surface-raised)}.nav a.active{color:var(--ink);background:#202725;box-shadow:inset 0 0 0 1px #39423f}.top-actions{gap:12px}.dataset-badge{display:flex;align-items:center;gap:8px;color:#f3d394;background:#2c271d;border:1px solid #554626;border-radius:7px;padding:7px 10px;font-size:12px;font-weight:600;white-space:nowrap}.dataset-badge .ti{font-size:15px;color:var(--amber)}.profile-chip{color:var(--sub);border-left:1px solid var(--stroke);padding-left:16px;font-size:12px;white-space:nowrap}\n.page{max-width:1440px;margin:0 auto;padding:28px 34px 36px}.page-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:21px}.page-heading h1{font-size:27px;line-height:1.2;letter-spacing:-.045em;margin:0 0 7px;font-weight:650}.page-heading p{margin:0;color:var(--sub);font-size:14px}.heading-note{display:flex;gap:8px;align-items:center;color:var(--sub);font-size:12px;white-space:nowrap}.heading-note .ti{font-size:15px;color:var(--amber)}\n.data-notice{display:flex;align-items:flex-start;gap:11px;padding:11px 14px;margin:0 0 19px;background:#211e18;border:1px solid #4d422b;border-radius:8px;color:#ead9b2;font-size:13px}.data-notice .ti{color:var(--amber);font-size:16px;flex:none;margin-top:1px}.data-notice strong{font-weight:650;color:#fff0cd}.data-notice span{color:#c6b994}\n.metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:0;margin:0 0 21px;background:#121615;border:1px solid var(--stroke);border-radius:9px;overflow:hidden}.metric{min-height:77px;padding:14px 18px;border-right:1px solid var(--stroke-soft);display:flex;flex-direction:column;justify-content:center;gap:3px}.metric:last-child{border-right:0}.metric-label{font-size:12px;color:var(--sub)}.metric-value{font-size:22px;line-height:1.15;font-weight:650;letter-spacing:-.04em;font-variant-numeric:tabular-nums}.metric-value.critical{color:var(--red)}.metric-value.warning{color:var(--amber)}.metric-value.info{color:#bbcaf7}.metric-value.mint{color:var(--mint)}\n.work-grid{display:grid;grid-template-columns:minmax(0,1fr) 314px;gap:20px;align-items:start}.work-panel{min-width:0;background:var(--surface);border:1px solid var(--stroke);border-radius:9px;overflow:hidden}.panel-head{min-height:58px;padding:13px 17px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--stroke-soft);gap:14px}.panel-title{font-weight:650;font-size:15px;letter-spacing:-.02em}.panel-meta{color:var(--quiet);font-size:12px;white-space:nowrap}.controls{display:flex;align-items:center;gap:11px;padding:13px 16px;border-bottom:1px solid var(--stroke-soft);flex-wrap:wrap}.searchbox{height:38px;min-width:220px;flex:1;max-width:345px;display:flex;align-items:center;gap:9px;background:#0f1312;border:1px solid #38413e;border-radius:7px;padding:0 11px;color:var(--quiet)}.searchbox .ti{font-size:16px}.searchbox input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font:inherit;font-size:13px}.searchbox input::placeholder{color:#7b8782}.searchbox:focus-within{border-color:var(--mint);box-shadow:0 0 0 3px #53dfbd2b}.filters{display:flex;align-items:center;gap:5px}.filter-btn{height:34px;border:1px solid transparent;background:transparent;color:var(--sub);padding:0 12px;border-radius:6px;font:500 12px Inter, sans-serif;cursor:pointer}.filter-btn:hover{color:var(--ink);background:#222a27}.filter-btn.active{background:#1c2925;color:#8cebd1;border-color:#345148}.result-count{margin-left:auto;color:var(--quiet);font-size:12px;white-space:nowrap}\n.table-scroll{overflow:auto}.alert-table{width:100%;border-collapse:collapse;table-layout:fixed}.alert-table thead{background:#171c1b}.alert-table th{height:37px;padding:0 10px;text-align:left;color:#aab5b0;font-weight:600;font-size:10px;letter-spacing:.055em;text-transform:uppercase;white-space:nowrap}.alert-table th:first-child,.alert-table td:first-child{padding-left:16px}.alert-table td{height:69px;padding:10px;color:#e7ece9;border-top:1px solid #28302e;vertical-align:middle;font-size:12px}.alert-table tbody tr{cursor:pointer}.alert-table tbody tr:hover{background:#19201e}.alert-table tbody tr.selected{background:#192622;box-shadow:inset 2px 0 0 var(--mint)}.alert-table tbody tr:focus-visible{outline:2px solid var(--mint);outline-offset:-2px}.event-cell{display:flex;align-items:center;gap:9px;min-width:0}.event-icon{width:27px;height:27px;flex:none;display:grid;place-items:center;border-radius:7px;background:#232927;color:#c1ccc6;font-size:14px}.event-copy{min-width:0}.event-name{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.event-code{display:block;color:var(--quiet);font-si