                      </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-3-8\" data-name=\"action cell\">\n                                        <span data-kid=\"1-2-3-1-1-3-1-3-3-8-1\" data-name=\"reviewed action placeholder text\" style=\"color:#7f8a86;font-size:12px\">\n                                            Reviewed\n                                        </span>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-3-1-1-3-1-3-4\" data-name=\"alert row (adulteration)\">\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-4-1\" data-name=\"type cell\">\n                                        <div class=\"type-cell\" data-kid=\"1-2-3-1-1-3-1-3-4-1-1\" data-name=\"type cell content\">\n                                            <span class=\"type-icon\" data-kid=\"1-2-3-1-1-3-1-3-4-1-1-1\" data-name=\"adulteration type icon badge\">\n                                                <i class=\"ti ti-test-pipe-2\" data-kid=\"1-2-3-1-1-3-1-3-4-1-1-1-1\" data-name=\"test pipe icon\">\n                                                </i>\n                                            </span>\n                                            Adulteration\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-4-2\" data-name=\"severity cell\">\n                                        <span class=\"severity warning\" data-kid=\"1-2-3-1-1-3-1-3-4-2-1\" data-name=\"warning severity badge\">\n                                            <i class=\"sev-dot\" data-kid=\"1-2-3-1-1-3-1-3-4-2-1-1\" data-name=\"warning severity dot\">\n                                            </i>\n                                            Warning\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-4-3\" data-name=\"message cell\">\n                                        <div class=\"message\" data-kid=\"1-2-3-1-1-3-1-3-4-3-1\" data-name=\"message text block\">\n                                            Intake quality variance flagged\n                                            <small data-kid=\"1-2-3-1-1-3-1-3-4-3-1-1\" data-name=\"message subheading\">\n                                                Review the recorded quality check\n                                            </small>\n                                        </div>\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-2-3-1-1-3-1-3-4-4\" data-name=\"vehicle id cell\">\n                                        VEH-005\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-2-3-1-1-3-1-3-4-5\" data-name=\"vcc id cell\">\n                                        VCC-012\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-2-3-1-1-3-1-3-4-6\" data-name=\"time cell\">\n                                        07:58\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-4-7\" data-name=\"status cell\">\n                                        <span class=\"status-tag\" data-kid=\"1-2-3-1-1-3-1-3-4-7-1\" data-name=\"needs review status tag\">\n                                            <i class=\"status-dot\" data-kid=\"1-2-3-1-1-3-1-3-4-7-1-1\" data-name=\"status indicator dot\">\n                                            </i>\n                                            Needs review\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-4-8\" data-name=\"action cell\">\n                                        <button class=\"btn acknowledge\" data-kid=\"1-2-3-1-1-3-1-3-4-8-1\" data-name=\"acknowledge alert button\">\n                                            Acknowledge\n                                        </button>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-3-1-1-3-1-3-5\" data-name=\"alert row (weather spike)\">\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-5-1\" data-name=\"type cell\">\n                                        <div class=\"type-cell\" data-kid=\"1-2-3-1-1-3-1-3-5-1-1\" data-name=\"type cell content\">\n                                            <span class=\"type-icon\" data-kid=\"1-2-3-1-1-3-1-3-5-1-1-1\" data-name=\"weather spike type icon badge\">\n                                                <i class=\"ti ti-sun-high\" data-kid=\"1-2-3-1-1-3-1-3-5-1-1-1-1\" data-name=\"high sun icon\">\n                                                </i>\n                                            </span>\n                                            Weather spike\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-5-2\" data-name=\"severity cell\">\n                                        <span class=\"severity info\" data-kid=\"1-2-3-1-1-3-1-3-5-2-1\" data-name=\"info severity badge\">\n                                            <i class=\"sev-dot\" data-kid=\"1-2-3-1-1-3-1-3-5-2-1-1\" data-name=\"info severity dot\">\n                                            </i>\n                                            Info\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-5-3\" data-name=\"message cell\">\n                                        <div class=\"message\" data-kid=\"1-2-3-1-1-3-1-3-5-3-1\" data-name=\"message text block\">\n                                            Ambient temperature may affect route\n                                            <small data-kid=\"1-2-3-1-1-3-1-3-5-3-1-1\" data-name=\"message subheading\">\n                                                Forecast-based scenario signal\n                                            </small>\n                                        </div>\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-2-3-1-1-3-1-3-5-4\" data-name=\"vehicle id cell\">\n                                        VEH-002\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-2-3-1-1-3-1-3-5-5\" data-name=\"empty vcc placeholder cell\">\n                                        —\n                                    </td>\n                                    <td class=\"mono\" data-kid=\"1-2-3-1-1-3-1-3-5-6\" data-name=\"time cell\">\n                                        07:42\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-5-7\" data-name=\"status cell\">\n                                        <span class=\"status-tag\" data-kid=\"1-2-3-1-1-3-1-3-5-7-1\" data-name=\"needs review status tag\">\n                                            <i class=\"status-dot\" data-kid=\"1-2-3-1-1-3-1-3-5-7-1-1\" data-name=\"status indicator dot\">\n                                            </i>\n                                            Needs review\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-1-3-1-3-5-8\" data-name=\"action cell\">\n                                        <button class=\"btn acknowledge\" data-kid=\"1-2-3-1-1-3-1-3-5-8-1\" data-name=\"acknowledge alert button\">\n                                            Acknowledge\n                                        </button>\n                                    </td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                    <div class=\"list-footer\" data-kid=\"1-2-3-1-1-4\" data-name=\"worklist footer bar\">\n                        <span data-kid=\"1-2-3-1-1-4-1\" data-name=\"visible records count text\">\n                            Showing\n                            <strong data-kid=\"1-2-3-1-1-4-1-1\" data-name=\"visible records numeric value\">\n                                05\n                            </strong>\n                            sample records\n                        </span>\n                        <span data-kid=\"1-2-3-1-1-4-2\" data-name=\"demo counts disclaimer text\">\n                            Counts reflect this demo scenario\n                        </span>\n                    </div>\n                </div>\n                <section aria-labelledby=\"states-title\" class=\"states\" data-kid=\"1-2-3-1-2\" data-name=\"empty states documentation section\">\n                    <h2 data-kid=\"1-2-3-1-2-1\" data-name=\"empty states section heading\" id=\"states-title\">\n                        When there are no alert rows\n                    </h2>\n                    <div class=\"state-grid\" data-kid=\"1-2-3-1-2-2\" data-name=\"empty state card grid\">\n                        <div class=\"state-card\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"no alerts empty state card\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"circle check icon\">\n                            </i>\n                            <div data-kid=\"1-2-3-1-2-2-1-2\" data-name=\"no alerts state content\">\n                                <strong data-kid=\"1-2-3-1-2-2-1-2-1\" data-name=\"no alerts state title\">\n                                    No alerts to review\n                                </strong>\n                                <p data-kid=\"1-2-3-1-2-2-1-2-2\" data-name=\"no alerts state description\">\n                                    The alert request succeeded and returned no records. Continue monitoring the round.\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"state-card unavailable\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"data unavailable empty state card\">\n                            <i class=\"ti ti-cloud-off\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"cloud offline icon\">\n                            </i>\n                            <div data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"unavailable state content\">\n                                <strong data-kid=\"1-2-3-1-2-2-2-2-1\" data-name=\"unavailable state title\">\n                                    Alert data unavailable\n                                </strong>\n                                <p data-kid=\"1-2-3-1-2-2-2-2-2\" data-name=\"unavailable state description\">\n                                    Couldn’t retrieve alert records. Counts are unknown—not zero.\n                                </p>\n                                <button data-kid=\"1-2-3-1-2-2-2-2-3\" data-name=\"retry alert data button\">\n                                    Retry alert data\n                                </button>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </section>\n            <aside aria-labelledby=\"context-title\" class=\"panel context-panel\" data-kid=\"1-2-3-2\" data-name=\"selected alert context side panel\">\n                <div class=\"context\" data-kid=\"1-2-3-2-1\" data-name=\"context panel content\">\n                    <div class=\"context-head\" data-kid=\"1-2-3-2-1-1\" data-name=\"context panel header\">\n                        <h2 data-kid=\"1-2-3-2-1-1-1\" data-name=\"context panel title\" id=\"context-title\">\n                            Selected alert\n                        </h2>\n                    </div>\n                    <div class=\"context-type\" data-kid=\"1-2-3-2-1-2\" data-name=\"alert type summary line\">\n                        <span class=\"severity critical\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"critical severity badge\">\n                            <i class=\"sev-dot\" data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"critical severity dot\">\n                            </i>\n                            Critical\n                        </span>\n                        <span data-kid=\"1-2-3-2-1-2-2\" data-name=\"summary separator dot\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-3-2-1-2-3\" data-name=\"alert category text\">\n                            Thermal risk\n                        </span>\n                    </div>\n                    <h3 data-kid=\"1-2-3-2-1-3\" data-name=\"selected alert headline\">\n                        Thermal buffer below modeled threshold\n                    </h3>\n                    <p class=\"context-copy\" data-kid=\"1-2-3-2-1-4\" data-name=\"selected alert description\">\n                        The next stop is flagged for review. The demo uses an estimated threshold; it is not a live temperature reading.\n                    </p>\n                    <div class=\"detail-grid\" data-kid=\"1-2-3-2-1-5\" data-name=\"alert detail grid\">\n                        <div class=\"detail\" data-kid=\"1-2-3-2-1-5-1\" data-name=\"vehicle detail item\">\n                            <label data-kid=\"1-2-3-2-1-5-1-1\" data-name=\"vehicle detail label\">\n                                Vehicle\n                            </label>\n                            <strong data-kid=\"1-2-3-2-1-5-1-2\" data-name=\"vehicle detail value wrapper\">\n                                <a class=\"link\" data-kid=\"1-2-3-2-1-5-1-2-1\" data-name=\"view vehicle route link\" href=\"/routes\">\n                                    VEH-002 · View route\n                                </a>\n                            </strong>\n                        </div>\n                        <div class=\"detail\" data-kid=\"1-2-3-2-1-5-2\" data-name=\"collection center detail item\">\n                            <label data-kid=\"1-2-3-2-1-5-2-1\" data-name=\"collection center label\">\n                                Collection center\n                            </label>\n                            <strong data-kid=\"1-2-3-2-1-5-2-2\" data-name=\"collection center value\">\n                                VCC-014\n                            </strong>\n                        </div>\n                        <div class=\"detail\" data-kid=\"1-2-3-2-1-5-3\" data-name=\"sample time detail item\">\n                            <label data-kid=\"1-2-3-2-1-5-3-1\" data-name=\"sample time label\">\n                                Sample event time\n                            </label>\n                            <strong data-kid=\"1-2-3-2-1-5-3-2\" data-name=\"sample time value\">\n                                08:42 · scenario\n                            </strong>\n                        </div>\n                        <div class=\"detail\" data-kid=\"1-2-3-2-1-5-4\" data-name=\"alert status detail item\">\n                            <label data-kid=\"1-2-3-2-1-5-4-1\" data-name=\"alert status label\">\n                                Alert status\n                            </label>\n                            <strong data-kid=\"1-2-3-2-1-5-4-2\" data-name=\"alert status value\" style=\"color:var(--amber)\">\n                                Needs review\n                            </strong>\n                        </div>\n                    </div>\n                    <div class=\"route-block\" data-kid=\"1-2-3-2-1-6\" data-name=\"related route sequence block\">\n                        <div class=\"route-top\" data-kid=\"1-2-3-2-1-6-1\" data-name=\"route sequence header\">\n                            <strong data-kid=\"1-2-3-2-1-6-1-1\" data-name=\"route sequence title\">\n                                Related route sequence\n                            </strong>\n                            <a class=\"link\" data-kid=\"1-2-3-2-1-6-1-2\" data-name=\"open route link\" href=\"/routes\">\n                                Open route\n                                <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-3-2-1-6-1-2-1\" data-name=\"arrow up-right icon\">\n                                </i>\n                            </a>\n                        </div>\n                        <div class=\"stop done\" data-kid=\"1-2-3-2-1-6-2\" data-name=\"completed route stop\">\n                            <span class=\"stop-mark\" data-kid=\"1-2-3-2-1-6-2-1\" data-name=\"stop marker circle with check\">\n                                <i class=\"ti ti-check\" data-kid=\"1-2-3-2-1-6-2-1-1\" data-name=\"checkmark icon\">\n                                </i>\n                            </span>\n                            <div data-kid=\"1-2-3-2-1-6-2-2\" data-name=\"stop details\">\n                                <div class=\"stop-name\" data-kid=\"1-2-3-2-1-6-2-2-1\" data-name=\"stop name and status\">\n                                    VCC-008 · Collected\n                                </div>\n                                <div class=\"stop-sub\" data-kid=\"1-2-3-2-1-6-2-2-2\" data-name=\"stop subtitle\">\n                                    Actual arrival recorded\n                                </div>\n                            </div>\n                            <span class=\"stop-time\" data-kid=\"1-2-3-2-1-6-2-3\" data-name=\"stop arrival time\">\n                                07:56\n                            </span>\n                        </div>\n                        <div class=\"stop current\" data-kid=\"1-2-3-2-1-6-3\" data-name=\"current route stop\">\n                            <span class=\"stop-mark\" data-kid=\"1-2-3-2-1-6-3-1\" data-name=\"stop marker number circle\">\n                                2\n                            </span>\n                            <div data-kid=\"1-2-3-2-1-6-3-2\" data-name=\"stop details\">\n                                <div class=\"stop-name\" data-kid=\"1-2-3-2-1-6-3-2-1\" data-name=\"stop name and status\">\n                                    VCC-014 · Next stop\n                                </div>\n                                <div class=\"stop-sub\" data-kid=\"1-2-3-2-1-6-3-2-2\" data-name=\"stop subtitle\">\n                                    Estimated arrival\n                                </div>\n                            </div>\n                            <span class=\"stop-time\" data-kid=\"1-2-3-2-1-6-3-3\" data-name=\"stop arrival time\">\n                                08:42\n                            </span>\n                        </div>\n                        <div class=\"stop\" data-kid=\"1-2-3-2-1-6-4\" data-name=\"upcoming destination stop\">\n                            <span class=\"stop-mark\" data-kid=\"1-2-3-2-1-6-4-1\" data-name=\"stop marker number circle\">\n                                3\n                            </span>\n                            <div data-kid=\"1-2-3-2-1-6-4-2\" data-name=\"stop details\">\n                                <div class=\"stop-name\" data-kid=\"1-2-3-2-1-6-4-2-1\" data-name=\"stop name and status\">\n                                    BMC-001 · Destination\n                                </div>\n                                <div class=\"stop-sub\" data-kid=\"1-2-3-2-1-6-4-2-2\" data-name=\"stop subtitle\">\n                                    Route sequence continues\n                                </div>\n                            </div>\n                            <span class=\"stop-time\" data-kid=\"1-2-3-2-1-6-4-3\" data-name=\"stop arrival time placeholder\">\n                                —\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"tsb\" data-kid=\"1-2-3-2-1-7\" data-name=\"modeled TSB metric callout\">\n                        <span data-kid=\"1-2-3-2-1-7-1\" data-name=\"modeled TSB label\">\n                            Modeled TSB · sample value\n                        </span>\n                        <strong data-kid=\"1-2-3-2-1-7-2\" data-name=\"modeled TSB value\">\n                            0.4 h\n                        </strong>\n                    </div>\n                    <p class=\"model-note\" data-kid=\"1-2-3-2-1-8\" data-name=\"model threshold disclaimer note\">\n                        The demo threshold is an engineering estimate, not a verified safety limit.\n                    </p>\n                    <div class=\"ack-copy\" data-kid=\"1-2-3-2-1-9\" data-name=\"acknowledgment scope disclaimer\">\n                        <strong data-kid=\"1-2-3-2-1-9-1\" data-name=\"acknowledgment scope emphasis text\">\n                            Acknowledging records review only.\n                        </strong>\n                        It does not resolve the underlying temperature or route condition.\n                    </div>\n                    <button class=\"context-action\" data-kid=\"1-2-3-2-1-10\" data-name=\"acknowledge alert action button\">\n                        Acknowledge alert\n                    </button>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-10T03:33:49.180982+00:00",
