6-1-1-2-2\" data-name=\"event code text\">\n                                                route_change\n                                            </span>\n                                        </span>\n                                    </div>\n                                </td>\n                                <td data-kid=\"1-2-4-1-3-1-3-6-2\" data-name=\"info severity badge\">\n                                    <span class=\"severity info\" data-kid=\"1-2-4-1-3-1-3-6-2-1\" data-name=\"info severity indicator\">\n                                        <span class=\"sev-dot\" data-kid=\"1-2-4-1-3-1-3-6-2-1-1\" data-name=\"severity dot\">\n                                        </span>\n                                        Info\n                                    </span>\n                                </td>\n                                <td class=\"message-cell\" data-kid=\"1-2-4-1-3-1-3-6-3\" data-name=\"alert message text\">\n                                    Vehicle arrival recorded at the bulk milk cooler\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-4-1-3-1-3-6-4\" data-name=\"vehicle identifier text\">\n                                    VEH-003\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-4-1-3-1-3-6-5\" data-name=\"VCC identifier text\">\n                                    VCC-002\n                                </td>\n                                <td class=\"mono\" data-kid=\"1-2-4-1-3-1-3-6-6\" data-name=\"alert timestamp cell\">\n                                    03 Oct 2026\n                                    <br data-kid=\"1-2-4-1-3-1-3-6-6-1\" data-name=\"line break\"/>\n                                    <span class=\"muted-value\" data-kid=\"1-2-4-1-3-1-3-6-6-2\" data-name=\"alert time of day\">\n                                        08:19 IST\n                                    </span>\n                                </td>\n                                <td data-kid=\"1-2-4-1-3-1-3-6-7\" data-name=\"acknowledgement state cell\">\n                                    <span class=\"ack-state done\" data-kid=\"1-2-4-1-3-1-3-6-7-1\" data-name=\"done acknowledgement badge\">\n                                        <i class=\"ti ti-check\" data-kid=\"1-2-4-1-3-1-3-6-7-1-1\" data-name=\"checkmark icon\">\n                                        </i>\n                                        Acknowledged\n                                    </span>\n                                </td>\n                                <td data-kid=\"1-2-4-1-3-1-3-6-8\" data-name=\"acknowledged action cell\">\n                                    <button class=\"ack-btn\" data-kid=\"1-2-4-1-3-1-3-6-8-1\" data-name=\"acknowledged button (disabled)\" disabled=\"\" type=\"button\">\n                                        Acknowledged\n                                    </button>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </section>\n            <aside aria-label=\"Selected alert detail\" class=\"detail-panel\" data-kid=\"1-2-4-2\" data-name=\"selected alert detail panel\">\n                <div class=\"detail-head\" data-kid=\"1-2-4-2-1\" data-name=\"detail panel header\">\n                    <div class=\"detail-headline\" data-kid=\"1-2-4-2-1-1\" data-name=\"detail headline row\">\n                        <span class=\"detail-title\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"detail panel title\">\n                            Selected alert\n                        </span>\n                        <span class=\"detail-overline\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"demo record overline\">\n                            DEMO RECORD\n                        </span>\n                    </div>\n                    <span class=\"severity critical\" data-dynamic=\"true\" data-kid=\"1-2-4-2-1-2\" data-name=\"selected alert severity badge\" data-reason=\"class and children rewritten by selection change handler\">\n                        <span class=\"sev-dot\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"severity dot\">\n                        </span>\n                        Critical\n                    </span>\n                </div>\n                <div class=\"detail-body\" data-kid=\"1-2-4-2-2\" data-name=\"detail panel body\">\n                    <div class=\"detail-event\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-1\" data-name=\"selected alert event title\" data-reason=\"text replaced from selected row by selection handler\" id=\"detail-event\">\n                        Thermal risk\n                    </div>\n                    <p class=\"detail-message\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-2\" data-name=\"selected alert message text\" data-reason=\"text replaced from selected row by selection handler\" id=\"detail-message\">\n                        Thermal buffer below 0.5 h at the next collection stop\n                    </p>\n                    <div class=\"detail-fields\" data-kid=\"1-2-4-2-2-3\" data-name=\"detail field grid\">\n                        <div class=\"detail-field\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"vehicle detail field\">\n                            <span class=\"field-label\" data-kid=\"1-2-4-2-2-3-1-1\" data-name=\"vehicle field label\">\n                                Vehicle\n                            </span>\n                            <span class=\"field-value\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-3-1-2\" data-name=\"vehicle field value\" data-reason=\"text replaced from selected row by selection handler\" id=\"detail-vehicle\">\n                                VEH-017\n                            </span>\n                        </div>\n                        <div class=\"detail-field\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"VCC detail field\">\n                            <span class=\"field-label\" data-kid=\"1-2-4-2-2-3-2-1\" data-name=\"VCC field label\">\n                                VCC\n                            </span>\n                            <span class=\"field-value\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-3-2-2\" data-name=\"VCC field value\" data-reason=\"text replaced from selected row by selection handler\" id=\"detail-vcc\">\n                                VCC-014\n                            </span>\n                        </div>\n                        <div class=\"detail-field\" data-kid=\"1-2-4-2-2-3-3\" data-name=\"timestamp detail field\">\n                            <span class=\"field-label\" data-kid=\"1-2-4-2-2-3-3-1\" data-name=\"timestamp field label\">\n                                Timestamp\n                            </span>\n                            <span class=\"field-value\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-3-3-2\" data-name=\"timestamp field value\" data-reason=\"text replaced from selected row by selection handler\" id=\"detail-time\">\n                                08 Oct 2026 · 08:42 IST\n                            </span>\n                        </div>\n                        <div class=\"detail-field\" data-kid=\"1-2-4-2-2-3-4\" data-name=\"state detail field\">\n                            <span class=\"field-label\" data-kid=\"1-2-4-2-2-3-4-1\" data-name=\"state field label\">\n                                State\n                            </span>\n                            <span class=\"field-value\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-3-4-2\" data-name=\"state field value\" data-reason=\"text replaced by selection and acknowledge handlers\" id=\"detail-state\">\n                                Unacknowledged\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"route-context\" data-kid=\"1-2-4-2-2-4\" data-name=\"route context section\">\n                        <div class=\"context-title\" data-kid=\"1-2-4-2-2-4-1\" data-name=\"route context title\">\n                            Route context\n                        </div>\n                        <div class=\"context-empty\" data-kid=\"1-2-4-2-2-4-2\" data-name=\"route context empty state\">\n                            <i class=\"ti ti-info-circle\" data-kid=\"1-2-4-2-2-4-2-1\" data-name=\"info circle icon\">\n                            </i>\n                            Stop sequence is not included in this alert record.\n                        </div>\n                    </div>\n                    <button class=\"detail-action\" data-dynamic=\"true\" data-kid=\"1-2-4-2-2-5\" data-name=\"detail acknowledge button\" data-reason=\"label and disabled state rewritten by acknowledge and selection handlers\" id=\"detail-ack\" type=\"button\">\n                        Acknowledge alert\n                    </button>\n                    <p class=\"small-note\" data-kid=\"1-2-4-2-2-6\" data-name=\"acknowledgement disclaimer note\">\n                        Acknowledging records that you have seen the alert; it does not resolve a hazard.\n                    </p>\n                </div>\n            </aside>\n        </div>\n        <div class=\"footer-note\" data-kid=\"1-2-5\" data-name=\"page footer notes row\">\n            <span data-kid=\"1-2-5-1\" data-name=\"demo disclaimer footer text\">\n                Demo data is illustrative only; risk thresholds are not a verified safety assessment.\n            </span>\n            <span data-kid=\"1-2-5-2\" data-name=\"timestamp timezone note\">\n                All timestamps shown as recorded in the demo scenario · IST\n            </span>\n        </div>\n    </main>\n</div>\n<script>\n    (()=>{const rows=[...document.querySelectorAll('.alert-row')];let filter='all';let selected=rows[0];const search=document.getElementById('alert-search');const count=document.getElementById('result-count');const detailAck=document.getElementById('detail-ack');function setSelected(row){selected=row;rows.forEach(r=>r.classList.toggle('selected',r===row));document.getElementById('detail-event').textContent=row.querySelector('.event-name').textContent;document.getElementById('detail-message').textContent=row.dataset.message;document.getElementById('detail-vehicle').textContent=row.dataset.vehicle;document.getElementById('detail-vcc').textContent=row.dataset.vcc;document.getElementById('detail-time').textContent=row.dataset.time;document.getElementById('detail-state').textContent=row.dataset.state;const severity=row.dataset.severity;const head=document.querySelector('.detail-head .severity');head.className='severity '+severity;head.innerHTML='<span class=\"sev-dot\"></span>'+severity[0].toUpperCase()+severity.slice(1);detailAck.disabled=row.dataset.state==='Acknowledged';detailAck.textContent=detailAck.disabled?'Acknowledged':'Acknowledge alert'}function apply(){let shown=0;const q=search.value.trim().toLowerCase();rows.forEach(row=>{const matches=(filter==='all'||row.dataset.severity===filter)&&(!q||row.innerText.toLowerCase().includes(q));row.hidden=!matches;if(matches)shown++});count.textContent='Showing '+shown;if(selected.hidden){const next=rows.find(r=>!r.hidden);if(next)setSelected(next)}}document.querySelectorAll('.filter-btn').forEach(btn=>btn.addEventListener('click',()=>{filter=btn.dataset.filter;document.querySelectorAll('.filter-btn').forEach(b=>{const active=b===btn;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))});apply()}));search.addEventListener('input',apply);rows.forEach(row=>{row.addEventListener('click',e=>{if(e.target.closest('.ack-btn'))return;setSelected(row)});row.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();setSelected(row)}});const btn=row.querySelector('.ack-btn');btn.addEventListener('click',e=>{e.stopPropagation();row.dataset.state='Acknowledged';row.querySelector('.ack-state').className='ack-state done';row.querySelector('.ack-state').innerHTML='<i class=\"ti ti-check\"></i>Acknowledged';btn.textContent='Acknowledged';btn.disabled=true;if(selected===row)setSelected(row)})});detailAck.addEventListener('click',()=>{if(!selected||detailAck.disabled)return;selected.dataset.state='Acknowledged';const b=selected.querySelector('.ack-btn');if(b){b.textContent='Acknowledged';b.disabled=true}selected.querySelector('.ack-state').className='ack-state done';selected.querySelector('.ack-state').innerHTML='<i class=\"ti ti-check\"></i>Acknowledged';setSelected(selected)});})();\n</script>\n",
