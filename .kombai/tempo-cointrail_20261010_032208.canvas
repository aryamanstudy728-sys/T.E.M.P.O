ns dashboard\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page subheading description\">\n                    Milk collection, thermal risk and fleet movement across active routes.\n                </p>\n            </div>\n            <div class=\"head-note\" data-kid=\"1-2-1-2\" data-name=\"page header note with demo disclaimer\">\n                <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-1-2-1\" data-name=\"info circle icon\">\n                </i>\n                Live readings unavailable · showing a demo scenario\n            </div>\n        </section>\n        <div aria-label=\"Demo scenario fleet summary\" class=\"metrics\" data-kid=\"1-2-2\" data-name=\"fleet summary metrics strip\">\n            <div class=\"metric\" data-kid=\"1-2-2-1\" data-name=\"active vehicles metric card\">\n                <div class=\"metric-label\" data-kid=\"1-2-2-1-1\" data-name=\"active vehicles metric label\">\n                    Active vehicles\n                </div>\n                <div class=\"metric-value\" data-kid=\"1-2-2-1-2\" data-name=\"active vehicles metric value\">\n                    02\n                    <small data-kid=\"1-2-2-1-2-1\" data-name=\"active vehicles total count\">\n                        / 03 vehicles\n                    </small>\n                </div>\n                <div class=\"metric-detail\" data-kid=\"1-2-2-1-3\" data-name=\"active vehicles metric detail\">\n                    Collecting or in transit\n                </div>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-2-2\" data-name=\"at-risk stops metric card\">\n                <div class=\"metric-label\" data-kid=\"1-2-2-2-1\" data-name=\"at-risk stops metric label\">\n                    At-risk stops\n                </div>\n                <div class=\"metric-value critical\" data-kid=\"1-2-2-2-2\" data-name=\"at-risk stops value (critical highlight)\">\n                    02\n                    <small data-kid=\"1-2-2-2-2-1\" data-name=\"at-risk stops unit\">\n                        stops\n                    </small>\n                </div>\n                <div class=\"metric-detail\" data-kid=\"1-2-2-2-3\" data-name=\"at-risk stops metric detail\">\n                    Risk bands are model estimates\n                </div>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-2-3\" data-name=\"collected volume metric card\">\n                <div class=\"metric-label\" data-kid=\"1-2-2-3-1\" data-name=\"collected volume metric label\">\n                    Collected volume\n                </div>\n                <div class=\"metric-value accent\" data-kid=\"1-2-2-3-2\" data-name=\"collected volume value (accent highlight)\">\n                    1,240\n                    <small data-kid=\"1-2-2-3-2-1\" data-name=\"collected volume unit\">\n                        L\n                    </small>\n                </div>\n                <div class=\"metric-detail\" data-kid=\"1-2-2-3-3\" data-name=\"collected volume metric detail\">\n                    Across demo vehicles\n                </div>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-2-4\" data-name=\"BMCs online metric card\">\n                <div class=\"metric-label\" data-kid=\"1-2-2-4-1\" data-name=\"BMCs online metric label\">\n                    BMCs online\n                </div>\n                <div class=\"metric-value\" data-kid=\"1-2-2-4-2\" data-name=\"BMCs online metric value\">\n                    01\n                    <small data-kid=\"1-2-2-4-2-1\" data-name=\"BMCs online total count\">\n                        / 01\n                    </small>\n                </div>\n                <div class=\"metric-detail\" data-kid=\"1-2-2-4-3\" data-name=\"BMCs online metric detail\">\n                    Bulk milk coolers\n                </div>\n            </div>\n        </div>\n        <div class=\"demo-strip\" data-kid=\"1-2-3\" data-name=\"demo scenario status strip\" role=\"status\">\n            <i aria-hidden=\"true\" class=\"ti ti-alert-circle\" data-kid=\"1-2-3-1\" data-name=\"alert circle icon\">\n            </i>\n            <span data-kid=\"1-2-3-2\" data-name=\"telemetry offline disclaimer text\">\n                Telemetry is offline. Values and route positions below are for a\n                <strong data-kid=\"1-2-3-2-1\" data-name=\"demo scenario bolded disclaimer\">\n                    Demo scenario · not live\n                </strong>\n                ; they do not represent current field conditions.\n            </span>\n        </div>\n        <section aria-label=\"Fleet map and dispatch details\" class=\"work-grid\" data-kid=\"1-2-4\" data-name=\"map and details work grid section\">\n            <section aria-labelledby=\"map-title\" class=\"map-panel\" data-kid=\"1-2-4-1\" data-name=\"fleet map panel\" id=\"fleet-map\">\n                <div class=\"map-head\" data-kid=\"1-2-4-1-1\" data-name=\"map header bar\">\n                    <h2 class=\"panel-title\" data-kid=\"1-2-4-1-1-1\" data-name=\"map panel title\" id=\"map-title\">\n                        Fleet map\n                    </h2>\n                    <div class=\"panel-meta\" data-kid=\"1-2-4-1-1-2\" data-name=\"map panel metadata controls\">\n                        <span class=\"map-tag\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"scenario locations tag\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-2-4-1-1-2-1-1\" data-name=\"map pin icon\">\n                            </i>\n                            Scenario locations\n                        </span>\n                        <button aria-label=\"Map options\" class=\"icon-button\" data-kid=\"1-2-4-1-1-2-2\" data-name=\"map options button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-adjustments-horizontal\" data-kid=\"1-2-4-1-1-2-2-1\" data-name=\"adjustments horizontal icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n                <div aria-label=\"Demonstration map of a milk collection zone. Tanker 1 is selected on a critical route; other vehicles, village collection centres and the bulk milk cooler are marked separately.\" class=\"map-canvas\" data-kid=\"1-2-4-1-2\" data-name=\"interactive fleet map canvas\" role=\"img\">\n                    <svg aria-hidden=\"true\" class=\"map-svg\" data-kid=\"1-2-4-1-2-1\" data-name=\"road and route map SVG\" preserveaspectratio=\"xMidYMid slice\" viewbox=\"0 0 1000 460\">\n                        <defs>\n                            <pattern height=\"74\" id=\"mapgrid\" patternunits=\"userSpaceOnUse\" width=\"88\">\n                                <path d=\"M88 0H0V74\" fill=\"none\" stroke=\"#1e2823\" stroke-width=\"1\">\n                                </path>\n                            </pattern>\n                        </defs>\n                        <rect fill=\"url(#mapgrid)\" height=\"460\" width=\"1000\">\n                        </rect>\n                        <path class=\"map-suburban\" d=\"M0 38L201 6l119 66-43 94-154 8L0 129zM765 4l235 0v104l-132 57-106-43zM0 317l157-32 86 59-36 116H0zM790 299l210-52v213H840l-92-89z\" opacity=\".57\">\n                        </path>\n                        <path class=\"map-local\" d=\"M-40 103C80 145 139 63 253 90s142 87 248 51 191-78 320-45 123 28 219 7M-31 199C88 176 135 229 250 202s149-67 257-15 175 91 293 67 151-63 225-43M-40 278C98 265 151 300 257 275s143-4 249 43 178 21 292-8 154-13 241 21M43-20c31 92 6 162 45 223s35 131 6 289M182-18c-35 78-30 154 11 225s62 158 19 274M363-24c46 92 3 151 35 227s58 147 31 280M559-20c-29 99 9 163 53 230s23 138 3 272M751-20c-13 90 39 148 26 221s-43 161 28 275M899-10c-49 105 20 162 4 242s-17 123 48 188\">\n                        </path>\n                        <path class=\"map-road\" d=\"M-30 344C103 305 157 301 238 248S370 211 451 231s126 1 192-33 171-47 221-24 91 30 171-15\">\n                        </path>\n                        <path class=\"map-road-core\" d=\"M-30 344C103 305 157 301 238 248S370 211 451 231s126 1 192-33 171-47 221-24 91 30 171-15\">\n                        </path>\n                        <path class=\"map-road\" d=\"M124 486c25-73 41-127 93-187s99-76 133-134 22-112 14-192M526 494c-10-57-23-105-11-163s60-111 92-151 43-92 28-200M849 484c-48-74-58-128-43-189s64-101 96-145 33-81 20-167\">\n                        </path>\n                        <path class=\"map-road-core\" d=\"M124 486c25-73 41-127 93-187s99-76 133-134 22-112 14-192M526 494c-10-57-23-105-11-163s60-111 92-151 43-92 28-200M849 484c-48-74-58-128-43-189s64-101 96-145 33-81 20-167\">\n                        </path>\n                        <path class=\"map-local\" d=\"M-20 344C150 365 185 415 314 437s228-12 324-17 225 53 393 36M105 51c104 99 151 101 213 148s73 95 136 137 152 66 220 88 132 0 232-59M248 8c50 77 53 133 120 178s138 64 173 137M682 12c-6 66 1 103 62 145s132 66 210 72M392 466c51-87 80-145 161-184s172-36 261-89\">\n                        </path>\n                        <path class=\"map-route route-critical\" d=\"M246 312C296 275 323 270 377 263S455 240 504 207s68-56 127-62 87-3 132-37\">\n                        </path>\n                        <path class=\"map-route route-watch\" d=\"M246 312C270 356 304 374 367 382s124 10 183-10 88-36 138-37\">\n                        </path>\n                        <path class=\"map-route route-normal\" d=\"M246 312C193 327 168 358 141 393s-26 49-42 66\">\n                        </path>\n                        <circle cx=\"505\" cy=\"207\" fill=\"#f07183\" r=\"5\">\n                        </circle>\n                        <circle cx=\"505\" cy=\"207\" fill=\"none\" r=\"11\" stroke=\"#f07183\" stroke-opacity=\".3\">\n                        </circle>\n                        <text class=\"map-label major\" x=\"434\" y=\"120\">\n                            Pune collection zone\n                        </text>\n                        <text class=\"map-label\" x=\"98\" y=\"195\">\n                            Village route\n                        </text>\n                        <text class=\"map-label\" x=\"707\" y=\"298\">\n                            Collection corridor\n                        </text>\n                        <text class=\"map-label\" x=\"768\" y=\"194\">\n                            Bulk milk cooler\n                        </text>\n                        <text class=\"map-label\" x=\"317\" y=\"405\">\n                            Village collection centre\n                        </text>\n                        <text class=\"map-label\" x=\"595\" y=\"186\">\n                            Next stop\n                        </text>\n                    </svg>\n                    <div class=\"map-caption\" data-kid=\"1-2-4-1-2-2\" data-name=\"map zone caption\">\n                        Pune collection zone · demo positions\n                    </div>\n                    <button aria-label=\"Selected vehicle Tanker 1, critical route\" class=\"map-marker selected\" data-kid=\"1-2-4-1-2-3\" data-name=\"selected tanker 1 map marker\" style=\"left:50.5%;top:45%;\">\n                        <span class=\"marker-core truck\" data-kid=\"1-2-4-1-2-3-1\" data-name=\"selected tanker 1 marker core\">\n                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-4-1-2-3-1-1\" data-name=\"truck icon\">\n                            </i>\n                        </span>\n                        <span class=\"marker-label\" data-kid=\"1-2-4-1-2-3-2\" data-name=\"selected tanker 1 marker label\">\n                            Tanker 1 · selected\n                        </span>\n                    </button>\n                    <button aria-label=\"Vehicle Tanker 2, watch route\" class=\"map-marker\" data-kid=\"1-2-4-1-2-4\" data-name=\"tanker 2 map marker\" style=\"left:25%;top:68%;\">\n                        <span class=\"marker-core truck\" data-kid=\"1-2-4-1-2-4-1\" data-name=\"tanker 2 marker core\">\n                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-4-1-2-4-1-1\" data-name=\"truck icon\">\n                            </i>\n                        </span>\n                        <span class=\"marker-label\" data-kid=\"1-2-4-1-2-4-2\" data-name=\"tanker 2 marker label\">\n                            Tanker 2\n                        </span>\n                    </button>\n                    <button aria-label=\"Vehicle Tanker 3, on route\" class=\"map-marker\" data-kid=\"1-2-4-1-2-5\" data-name=\"tanker 3 map marker\" style=\"left:13%;top:86%;\">\n                        <span class=\"marker-core truck\" data-kid=\"1-2-4-1-2-5-1\" data-name=\"tanker 3 marker core\">\n                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-4-1-2-5-1-1\" data-name=\"truck icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Village collection centre\" class=\"map-marker\" data-kid=\"1-2-4-1-2-6\" data-name=\"village collection centre marker\" style=\"left:37%;top:57%;\">\n                        <span class=\"marker-core vcc\" data-kid=\"1-2-4-1-2-6-1\" data-name=\"VCC marker core\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-2-4-1-2-6-1-1\" data-name=\"map pin icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Next village collection centre\" class=\"map-marker\" data-kid=\"1-2-4-1-2-7\" data-name=\"next VCC marker\" style=\"left:63%;top:40%;\">\n                        <span class=\"marker-core vcc\" data-kid=\"1-2-4-1-2-7-1\" data-name=\"next VCC marker core\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-2-4-1-2-7-1-1\" data-name=\"map pin icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <button aria-label=\"Bulk milk cooler\" class=\"map-marker\" data-kid=\"1-2-4-1-2-8\" data-name=\"bulk milk cooler marker\" style=\"left:84%;top:42%;\">\n                        <span class=\"marker-core bmc\" data-kid=\"1-2-4-1-2-8-1\" data-name=\"BMC marker core\">\n                            BMC\n                        </span>\n                        <span class=\"marker-label\" data-kid=\"1-2-4-1-2-8-2\" data-name=\"BMC marker label\">\n                            Bulk milk cooler\n                        </span>\n                    </button>\n                    <div class=\"map-controls\" data-kid=\"1-2-4-1-2-9\" data-name=\"map zoom controls\">\n                        <button aria-label=\"Zoom in\" data-kid=\"1-2-4-1-2-9-1\" data-name=\"zoom in button\">\n                            +\n                        </button>\n                        <button aria-label=\"Zoom out\" data-kid=\"1-2-4-1-2-9-2\" data-name=\"zoom out button\">\n                            −\n                        </button>\n                    </div>\n                </div>\n                <div class=\"map-legend\" data-kid=\"1-2-4-1-3\" data-name=\"map legend bar\">\n                    <div aria-label=\"Map legend\" class=\"legend-group\" data-kid=\"1-2-4-1-3-1\" data-name=\"legend symbols group\">\n                        <span class=\"legend-item\" data-kid=\"1-2-4-1-3-1-1\" data-name=\"vehicle legend item\">\n                            <span class=\"legend-mark\" data-kid=\"1-2-4-1-3-1-1-1\" data-name=\"vehicle legend dot\">\n                            </span>\n                            Vehicle\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-1-3-1-2\" data-name=\"VCC legend item\">\n                            <span class=\"legend-mark vcc\" data-kid=\"1-2-4-1-3-1-2-1\" data-name=\"VCC legend ring\">\n                            </span>\n                            Village collection centre\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-1-3-1-3\" data-name=\"BMC legend item\">\n                            <span class=\"legend-mark bmc\" data-kid=\"1-2-4-1-3-1-3-1\" data-name=\"BMC legend square\">\n                            </span>\n                            BMC\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-1-3-1-4\" data-name=\"critical route legend item\">\n                            <span class=\"legend-line\" data-kid=\"1-2-4-1-3-1-4-1\" data-name=\"critical route legend line\">\n                            </span>\n                            Critical route\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-1-3-1-5\" data-name=\"watch route legend item\">\n                            <span class=\"legend-line watch\" data-kid=\"1-2-4-1-3-1-5-1\" data-name=\"watch route legend line\">\n                            </span>\n                            Watch\n                        </span>\n                        <span class=\"legend-item\" data-kid=\"1-2-4-1-3-1-6\" data-name=\"on track route legend item\">\n                            <span class=\"legend-line normal\" data-kid=\"1-2-4-1-3-1-6-1\" data-name=\"on track route legend line\">\n                            </span>\n                            On track\n                        </span>\n                    </div>\n                    <span class=\"legend-note\" data-kid=\"1-2-4-1-3-2\" data-name=\"legend disclaimer note\">\n                        No marker color means status unavailable—not safe.\n                    </span>\n                </div>\n            </section>\n            <aside aria-label=\"Selected vehicle and operational alerts\" class=\"rail\" data-kid=\"1-2-4-2\" data-name=\"side rail with panel details\">\n                <section aria-labelledby=\"selected-title\" class=\"selected-panel\" data-kid=\"1-2-4-2-1\" data-name=\"selected vehicle detail panel\">\n                    <div class=\"selected-top\" data-kid=\"1-2-4-2-1-1\" data-name=\"selected panel top row\">\n                        <div class=\"selected-heading\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"selected panel heading\" id=\"selected-title\">\n                            Selected vehicle\n                        </div>\n                        <span class=\"risk-chip\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"red risk status chip\">\n                            Red risk\n                        </span>\n                    </div>\n                    <div class=\"vehicle-name\" data-kid=\"1-2-4-2-1-2\" data-name=\"selected vehicle name\">\n                        Tanker 1\n                    </div>\n                    <div class=\"vehicle-sub\" data-kid=\"1-2-4-2-1-3\" data-name=\"selected vehicle status line\">\n                        <span class=\"state-dot\" data-kid=\"1-2-4-2-1-3-1\" data-name=\"active state dot\">\n                        </span>\n                        Collecting\n                        <span class=\"mono\" data-kid=\"1-2-4-2-1-3-2\" data-name=\"vehicle code text\">\n                            · VEH-001\n                        </span>\n                    </div>\n                    <div class=\"selected-data\" data-kid=\"1-2-4-2-1-4\" data-name=\"selected vehicle data grid\">\n                        <div data-kid=\"1-2-4-2-1-4-1\" data-name=\"next stop data cell\">\n                            <div class=\"data-label\" data-kid=\"1-2-4-2-1-4-1-1\" data-name=\"next stop data label\">\n                                Next stop\n                            </div>\n                            <div class=\"data-value\" data-kid=\"1-2-4-2-1-4-1-2\" data-name=\"next stop data value\">\n                                VCC · stop 04\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-4-2-1-4-2\" data-name=\"estimated arrival data cell\">\n                            <div class=\"data-label\" data-kid=\"1-2-4-2-1-4-2-1\" data-name=\"estimated arrival label\">\n                                Estimated arrival\n                            </div>\n                            <div class=\"data-value mono\" data-kid=\"1-2-4-2-1-4-2-2\" data-name=\"estimated arrival value\">\n                                18 min\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-4-2-1-4-3\" data-name=\"TSB buffer data cell\">\n                            <div class=\"data-label\" data-kid=\"1-2-4-2-1-4-3-1\" data-name=\"TSB buffer label\">\n                                TSB buffer\n                            </div>\n                            <div class=\"data-value mono danger\" data-kid=\"1-2-4-2-1-4-3-2\" data-name=\"TSB buffer value (danger)\">\n                                0.4 h\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"risk-context\" data-kid=\"1-2-4-2-1-5\" data-name=\"thermal risk context banner\">\n                        <i aria-hidden=\"true\" class=\"ti ti-thermometer\" data-kid=\"1-2-4-2-1-5-1\" data-name=\"thermometer icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-2-1-5-2\" data-name=\"risk context text\">\n                            Critical band · prioritize this stop. Thresholds are model estimates.\n                        </span>\n                    </div>\n                    <a class=\"mobile-map-link\" data-kid=\"1-2-4-2-1-6\" data-name=\"mobile map jump link\" href=\"#fleet-map\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-2-4-2-1-6-1\" data-name=\"map pin icon\">\n                        </i>\n                        View map\n                        <span aria-hidden=\"true\" data-kid=\"1-2-4-2-1-6-2\" data-name=\"down arrow symbol\">\n                            ↓\n                        </span>\n                    </a>\n                </section>\n                <section aria-labelledby=\"alerts-title\" class=\"alerts-panel\" data-kid=\"1-2-4-2-2\" data-name=\"actionable alerts panel\" id=\"alerts\">\n                    <div class=\"rail-title-row\" data-kid=\"1-2-4-2-2-1\" data-name=\"alerts panel header\">\n                        <h2 data-kid=\"1-2-4-2-2-1-1\" data-name=\"alerts panel title\" id=\"alerts-title\">\n                            Actionable alerts\n                        </h2>\n                        <a data-kid=\"1-2-4-2-2-1-2\" data-name=\"view all alerts link\" href=\"#alerts-list\">\n                            View all\n                        </a>\n                    </div>\n                    <div data-kid=\"1-2-4-2-2-2\" data-name=\"alerts list container\" id=\"alerts-list\">\n                        <div class=\"alert-row\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"thermal risk alert row\">\n                            <span class=\"alert-indicator\" data-kid=\"1-2-4-2-2-2-1-1\" data-name=\"critical alert indicator dot\">\n                            </span>\n                            <div data-kid=\"1-2-4-2-2-2-1-2\" data-name=\"alert content block\">\n                                <div class=\"alert-message\" data-kid=\"1-2-4-2-2-2-1-2-1\" data-name=\"thermal risk alert message\">\n                                    Thermal risk at next stop · TSB 0.4 h\n                                </div>\n                                <div class=\"alert-meta\" data-kid=\"1-2-4-2-2-2-1-2-2\" data-name=\"thermal risk alert metadata\">\n                                    Tanker 1 · VCC stop 04 · unacknowledged\n                                </div>\n                            </div>\n                            <button aria-label=\"Acknowledge thermal risk alert\" class=\"alert-action\" data-kid=\"1-2-4-2-2-2-1-3\" data-name=\"acknowledge alert action button\">\n                                Acknowledge\n                            </button>\n                        </div>\n                        <div class=\"alert-row\" data-kid=\"1-2-4-2-2-2-2\" data-name=\"route review alert row\">\n                            <span class=\"alert-indicator warning\" data-kid=\"1-2-4-2-2-2-2-1\" data-name=\"warning alert indicator dot\">\n                            </span>\n                            <div data-kid=\"1-2-4-2-2-2-2-2\" data-name=\"route review alert content block\">\n                                <div class=\"alert-message\" data-kid=\"1-2-4-2-2-2-2-2-1\" data-name=\"route review alert message\">\n                                    Route requires review\n                                </div>\n                                <div class=\"alert-meta\" data-kid=\"1-2-4-2-2-2-2-2-2\" data-name=\"route review alert metadata\">\n                                    Tanker 2 · watch-risk stop\n                                </div>\n                            </div>\n                            <span class=\"legend-item\" data-kid=\"1-2-4-2-2-2-2-3\" data-name=\"warning tag chip\" style=\"font-size:10px;color:#e9bd58\">\n                                Warning\n                            </span>\n                        </div>\n                    </div>\n                </section>\n                <section aria-labelledby=\"bmc-title\" class=\"bmc-panel\" data-kid=\"1-2-4-2-3\" data-name=\"BMC readiness panel\">\n                    <div class=\"bmc-top\" data-kid=\"1-2-4-2-3-1\" data-name=\"BMC top row\">\n                        <div class=\"bmc-name\" data-kid=\"1-2-4-2-3-1-1\" data-name=\"BMC name and code\" id=\"bmc-title\">\n                            BMC readiness\n                            <span class=\"mono\" data-kid=\"1-2-4-2-3-1-1-1\" data-name=\"BMC code text\" style=\"color:#8f9c95;font-size:10px\">\n                                · BMC-001\n                            </span>\n                        </div>\n                        <span class=\"bmc-status\" data-kid=\"1-2-4-2-3-1-2\" data-name=\"BMC online status chip\">\n                            Online\n                        </span>\n                    </div>\n                    <div class=\"bmc-stats\" data-kid=\"1-2-4-2-3-2\" data-name=\"BMC stats grid\">\n                        <div data-kid=\"1-2-4-2-3-2-1\" data-name=\"BMC temperature stat\">\n                            <div class=\"bmc-stat-label\" data-kid=\"1-2-4-2-3-2-1-1\" data-name=\"BMC temperature label\">\n                                Temperature\n                            </div>\n                            <div class=\"bmc-stat-value\" data-kid=\"1-2-4-2-3-2-1-2\" data-name=\"BMC temperature value\">\n                                4.1°C\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-4-2-3-2-2\" data-name=\"BMC queue stat\">\n                            <div class=\"bmc-stat-label\" data-kid=\"1-2-4-2-3-2-2-1\" data-name=\"BMC queue label\">\n                                Queue\n                            </div>\n                            <div class=\"bmc-stat-value\" data-kid=\"1-2-4-2-3-2-2-2\" data-name=\"BMC queue value\">\n                                1 vehicle\n                            </div>\n                        </div>\n                        <div data-kid=\"1-2-4-2-3-2-3\" data-name=\"BMC power stat\">\n                            <div class=\"bmc-stat-label\" data-kid=\"1-2-4-2-3-2-3-1\" data-name=\"BMC power label\">\n                                Power\n                            </div>\n                            <div class=\"bmc-stat-value\" data-kid=\"1-2-4-2-3-2-3-2\" data-name=\"BMC power value\">\n                                Online\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </aside>\n        </section>\n        <section aria-labelledby=\"fleet-title\" class=\"fleet-panel\" data-kid=\"1-2-5\" data-name=\"fleet vehicles panel\" id=\"routes\">\n            <div class=\"fleet-head\" data-kid=\"1-2-5-1\" data-name=\"fleet panel header\">\n                <h2 data-kid=\"1-2-5-1-1\" data-name=\"fleet panel title\" id=\"fleet-title\">\n                    Fleet vehicles\n                </h2>\n                <span class=\"fleet-source\" data-kid=\"1-2-5-1-2\" data-name=\"fleet data source note\">\n                    Demo scenario · not live\n                </span>\n            </div>\n            <div class=\"fleet-table-wrap\" data-kid=\"1-2-5-2\" data-name=\"fleet table wrapper\">\n                <table class=\"fleet-table\" data-kid=\"1-2-5-2-1\" data-name=\"fleet vehicles table\">\n                    <thead data-kid=\"1-2-5-2-1-1\" data-name=\"fleet table header\">\n                        <tr data-kid=\"1-2-5-2-1-1-1\" data-name=\"header row\">\n                            <th data-kid=\"1-2-5-2-1-1-1-1\" data-name=\"vehicle column header\" scope=\"col\">\n                                Vehicle\n                            </th>\n                            <th data-kid=\"1-2-5-2-1-1-1-2\" data-name=\"status column header\" scope=\"col\">\n                                Status\n                            </th>\n                            <th data-kid=\"1-2-5-2-1-1-1-3\" data-name=\"current volume column header\" scope=\"col\">\n                                Current volume\n                            </th>\n                            <th data-kid=\"1-2-5-2-1-1-1-4\" data-name=\"next stop column header\" scope=\"col\">\n                                Next stop\n                            </th>\n                            <th data-kid=\"1-2-5-2-1-1-1-5\" data-name=\"route risk column header\" scope=\"col\">\n                                Route risk\n                            </th>\n                            <th data-kid=\"1-2-5-2-1-1-1-6\" data-name=\"action column header\" scope=\"col\">\n                                Action\n                            </th>\n                        </tr>\n                    </thead>\n                    <tbody data-kid=\"1-2-5-2-1-2\" data-name=\"fleet table body\">\n                        <tr class=\"selected\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"selected tanker 1 row\">\n                            <td data-kid=\"1-2-5-2-1-2-1-1\" data-name=\"tanker 1 cell\">\n                                <div class=\"vehicle-cell\" data-kid=\"1-2-5-2-1-2-1-1-1\" data-name=\"tanker 1 vehicle cell block\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-5-2-1-2-1-1-1-1\" data-name=\"truck icon\">\n                                    </i>\n                                    <strong data-kid=\"1-2-5-2-1-2-1-1-1-2\" data-name=\"tanker 1 name bold text\">\n                                        Tanker 1\n                                    </strong>\n                                    <span class=\"mono\" data-kid=\"1-2-5-2-1-2-1-1-1-3\" data-name=\"tanker 1 vehicle code\" style=\"font-size:10px;color:#8f9c95\">\n                                        VEH-001\n                                    </span>\n                                </div>\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-1-2\" data-name=\"status cell\">\n                                <span class=\"fleet-status\" data-kid=\"1-2-5-2-1-2-1-2-1\" data-name=\"collecting status badge\">\n                                    Collecting\n                                </span>\n                            </td>\n                            <td class=\"mono\" data-kid=\"1-2-5-2-1-2-1-3\" data-name=\"current volume cell\">\n                                620 L\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-1-4\" data-name=\"next stop cell\">\n                                VCC · stop 04\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-1-5\" data-name=\"route risk cell (red critical)\">\n                                <span class=\"risk-text\" data-kid=\"1-2-5-2-1-2-1-5-1\" data-name=\"red risk text chip\">\n                                    Red · 0.4 h TSB\n                                </span>\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-1-6\" data-name=\"action cell (row 1)\">\n                                <a class=\"route-link\" data-kid=\"1-2-5-2-1-2-1-6-1\" data-name=\"view route action link (tanker 1)\" href=\"#routes\">\n                                    View route\n                                </a>\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-2-5-2-1-2-2\" data-name=\"tanker 2 row\">\n                            <td data-kid=\"1-2-5-2-1-2-2-1\" data-name=\"tanker 2 cell\">\n                                <div class=\"vehicle-cell\" data-kid=\"1-2-5-2-1-2-2-1-1\" data-name=\"tanker 2 vehicle cell block\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-5-2-1-2-2-1-1-1\" data-name=\"truck icon\">\n                                    </i>\n                                    <strong data-kid=\"1-2-5-2-1-2-2-1-1-2\" data-name=\"tanker 2 name bold text\">\n                                        Tanker 2\n                                    </strong>\n                                    <span class=\"mono\" data-kid=\"1-2-5-2-1-2-2-1-1-3\" data-name=\"tanker 2 vehicle code\" style=\"font-size:10px;color:#8f9c95\">\n                                        VEH-002\n                                    </span>\n                                </div>\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-2-2\" data-name=\"status cell (row 2)\">\n                                <span class=\"fleet-status warning\" data-kid=\"1-2-5-2-1-2-2-2-1\" data-name=\"in transit status badge (warning)\">\n                                    In transit\n                                </span>\n                            </td>\n                            <td class=\"mono\" data-kid=\"1-2-5-2-1-2-2-3\" data-name=\"current volume cell (row 2)\">\n                                410 L\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-2-4\" data-name=\"next stop cell (row 2)\">\n                                VCC · stop 06\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-2-5\" data-name=\"route risk cell (row 2)\">\n                                <span class=\"risk-text watch\" data-kid=\"1-2-5-2-1-2-2-5-1\" data-name=\"watch risk text chip\">\n                                    Watch · 1.8 h TSB\n                                </span>\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-2-6\" data-name=\"action cell (row 2)\">\n                                <a class=\"route-link\" data-kid=\"1-2-5-2-1-2-2-6-1\" data-name=\"view route action link (tanker 2)\" href=\"#routes\">\n                                    View route\n                                </a>\n                            </td>\n                        </tr>\n                        <tr data-kid=\"1-2-5-2-1-2-3\" data-name=\"tanker 3 row\">\n                            <td data-kid=\"1-2-5-2-1-2-3-1\" data-name=\"tanker 3 cell\">\n                                <div class=\"vehicle-cell\" data-kid=\"1-2-5-2-1-2-3-1-1\" data-name=\"tanker 3 vehicle cell block\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-5-2-1-2-3-1-1-1\" data-name=\"truck icon\">\n                                    </i>\n                                    <strong data-kid=\"1-2-5-2-1-2-3-1-1-2\" data-name=\"tanker 3 name bold text\">\n                                        Tanker 3\n                                    </strong>\n                                    <span class=\"mono\" data-kid=\"1-2-5-2-1-2-3-1-1-3\" data-name=\"tanker 3 vehicle code\" style=\"font-size:10px;color:#8f9c95\">\n                                        VEH-003\n                                    </span>\n                                </div>\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-3-2\" data-name=\"status cell (row 3)\">\n                                <span class=\"fleet-status idle\" data-kid=\"1-2-5-2-1-2-3-2-1\" data-name=\"idle status badge\">\n                                    Idle\n                                </span>\n                            </td>\n                            <td class=\"mono\" data-kid=\"1-2-5-2-1-2-3-3\" data-name=\"current volume cell (row 3)\">\n                                210 L\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-3-4\" data-name=\"next stop cell (row 3)\">\n                                BMC-001\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-3-5\" data-name=\"route risk on-track text (row 3)\">\n                                On track\n                            </td>\n                            <td data-kid=\"1-2-5-2-1-2-3-6\" data-name=\"action cell (row 3)\">\n                                <a class=\"route-link\" data-kid=\"1-2-5-2-1-2-3-6-1\" data-name=\"view route action link (tanker 3)\" href=\"#routes\">\n                                    View route\n                                </a>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <div class=\"table-hint\" data-kid=\"1-2-5-3\" data-name=\"mobile table scroll hint\">\n                Route details remain available in the full-width table; scroll horizontally to compare all fields.\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-10T03:34:04.077667+00:00",
      "modified": "2026-10-10T03:35:06.441047+00:00",
      "id": "var_1f023231850d",
      "contentHeight": 1191
    },
    "var_d08ca00375bf": {
      "type": "variant",
      "label": "Intervention-first — Analytics",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 10780,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root{--tempo-bg:#0b0d0c;--tempo-panel:#111412;--tempo-panel-2:#151917;--tempo-edge:#2a302d;--tempo-edge-soft:#202522;--tempo-ink:#eef2ef;--tempo-muted:#a0aaa4;--tempo-dim:#7f8a83;--tempo-mint:#45ddb5;--tempo-mint-ink:#8df0d1;--tempo-mint-bg:#123b30;--tempo-amber:#f1c15b;--tempo-amber-bg:#3c3017;--tempo-red:#ff7e8c;--tempo-red-bg:#421d25;--tempo-focus:#8bf3d4;--tempo-mono:'IBM Plex Mono',ui-monospace,monospace}\n.tempo-screen{min-height:100vh;background:var(--tempo-bg);color:var(--tempo-ink);font-family:'DM Sans',sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}\n.tempo-screen *{box-sizing:border-box}\n.tempo-header{height:72px;border-bottom:1px solid var(--tempo-edge-soft);background:var(--tempo-bg);display:flex;align-items:center;justify-content:space-between;padding:0 34px;gap:28px}\n.tempo-header-left{display:flex;align-items:center;gap:38px;min-width:0}\n.tempo-brand{display:flex;align-items:center;gap:11px;white-space:nowrap;font-weight:700;letter-spacing:-.03em;font-size:18px}\n.tempo-mark{height:34px;width:34px;border-radius:10px;background:var(--tempo-mint);color:#09201a;display:grid;place-items:center;font-weight:800;font-size:18px;letter-spacing:-.04em}\n.tempo-nav{display:flex;align-items:center;gap:6px;height:72px}\n.tempo-nav a{height:72px;padding:0 15px;display:flex;align-items:center;gap:9px;text-decoration:none;color:var(--tempo-muted);font-size:15px;font-weight:500;border-bottom:2px solid transparent;white-space:nowrap}\n.tempo-nav a:hover{color:var(--tempo-ink);background:#111412}\n.tempo-nav a[aria-current='page']{color:var(--tempo-ink);border-bottom-color:var(--tempo-mint)}\n.tempo-nav i{font-size:18px;color:currentColor;width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center}\n.tempo-status{display:inline-flex;align-items:center;gap:9px;white-space:nowrap;border:1px solid #544523;background:#211d12;color:#f4dda0;border-radius:8px;padding:9px 12px;font-size:14px;font-weight:600}\n.tempo-status i{font-size:17px;color:var(--tempo-amber);width:17px;height:17px;display:inline-flex;align-items:center;justify-content:center}\n.tempo-main{max-width:1372px;margin:0 auto;padding:31px 0 58px}\n.tempo-pagehead{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:20px}\n.tempo-pagehead h1{font-size:29px;line-height:1.15;letter-spacing:-.035em;margin:0;font-weight:700}\n.tempo-pagehead p{margin:8px 0 0;color:var(--tempo-muted);font-size:15px}\n.tempo-section-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 0 13px}\n.tempo-section-heading h2{font-size:18px;letter-spacing:-.02em;font-weight:600;margin:0}\n.tempo-section-heading .meta{font-size:14px;color:var(--tempo-muted);display:flex;align-items:center;gap:8px}\n.tempo-section-heading .meta i{font-size:16px;color:var(--tempo-dim)}\n.tempo-demo-note{min-height:46px;display:flex;align-items:center;gap:11px;background:#17170f;border:1px solid #383321;border-radius:10px;padding:10px 14px;margin:0 0 22px;color:#d7d0af;font-size:14px}\n.tempo-demo-note i{font-size:18px;color:var(--tempo-amber);width:18px;height:18px;display:inline-flex;align-items:center;justify-content:center;flex:none}\n.tempo-demo-note strong{color:#f3dfab;font-weight:600}\n.tempo-panel{background:var(--tempo-panel);border:1px solid var(--tempo-edge);border-radius:14px;overflow:hidden}\n.tempo-panel-head{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:18px 20px;border-bottom:1px solid var(--tempo-edge-soft)}\n.tempo-panel-head h3{font-size:17px;line-height:1.3;font-weight:600;letter-spacing:-.015em;margin:0}\n.tempo-panel-head .sub{font-size:14px;color:var(--tempo-muted);margin-top:4px}\n.tempo-panel-body{padding:16px 20px 18px}\n.tempo-data-note{color:var(--tempo-muted);font-size:14px;display:flex;align-items:center;gap:8px;white-space:nowrap}\n.tempo-data-note .mint-dot{width:8px;height:8px;background:var(--tempo-mint);border-radius:50%;display:inline-block;flex:none}\n.tempo-table-wrap{width:100%;overflow-x:auto}\n.tempo-table{width:100%;border-collapse:collapse;min-width:930px;text-align:left;font-size:14px}\n.tempo-table th{font-size:13px;letter-spacing:.045em;text-transform:uppercase;color:var(--tempo-muted);font-weight:600;padding:11px 12px 12px;border-bottom:1px solid var(--tempo-edge);white-space:nowrap}\n.tempo-table td{padding:15px 12px;border-bottom:1px solid var(--tempo-edge-soft);vertical-align:middle}\n.tempo-table tbody tr:last-child td{border-bottom:0}\n.tempo-table tbody tr:hover td{background:#141815}\n.tempo-vehicle{display:flex;flex-direction:column;gap:3px}\n.tempo-vehicle strong{font-size:15px;font-weight:600;color:var(--tempo-ink)}\n.tempo-vehicle span{font-size:14px;color:var(--tempo-muted);font-family:var(--tempo-mono)}\n.tempo-count{font-family:var(--tempo-mono);font-size:15px;font-weight:500;color:var(--tempo-ink);font-variant-numeric:tabular-nums;white-space:nowrap}\n.tempo-band-count{font-family:var(--tempo-mono);font-variant-numeric:tabular-nums;white-space:nowrap}\n.tempo-band-count.green{color:var(--tempo-mint-ink)}\n.tempo-band-count.amber{color:var(--tempo-amber)}\n.tempo-band-count.red{color:var(--tempo-red)}\n.tempo-mix{min-width:205px}\n.tempo-segmentbar{height:10px;background:#252b28;border-radius:999px;display:flex;overflow:hidden;gap:2px}\n.tempo-segmentbar span{height:100%;display:block;min-width:0}\n.tempo-segmentbar .green{background:var(--tempo-mint)}\n.tempo-segmentbar .amber{background:var(--tempo-amber)}\n.tempo-segmentbar .red{background:var(--tempo-red)}\n.tempo-total-row td{border-top:1px solid var(--tempo-edge);padding-top:14px;padding-bottom:7px}\n.tempo-total-label{font-weight:600;color:var(--tempo-ink)}\n.tempo-table-foot{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid var(--tempo-edge-soft);padding:14px 20px;color:var(--tempo-muted);font-size:14px}\n.tempo-table-foot strong{color:var(--tempo-ink);font-weight:600}\n.tempo-next-grid{display:grid;grid-template-columns:1.16fr .84fr;gap:16px;margin-top:24px}\n.tempo-legend-head{display:grid;grid-template-columns:1fr auto auto;gap:16px;color:var(--tempo-muted);font-size:13px;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid var(--tempo-edge-soft);padding:2px 0 10px;margin-bottom:5px}\n.tempo-risk-row{display:grid;grid-template-columns:1fr auto auto;gap:16px;align-items:center;padding:12px 0;border-bottom:1px solid var(--tempo-edge-soft)}\n.tempo-risk-row:last-child{border-bottom:0}\n.tempo-risk-name{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:500}\n.tempo-risk-name i{height:9px;width:9px;border-radius:50%;display:inline-block;flex:none}\n.tempo-risk-name i.green{background:var(--tempo-mint)}.tempo-risk-name i.amber{background:var(--tempo-amber)}.tempo-risk-name i.red{background:var(--tempo-red)}\n.tempo-risk-amount{text-align:right;font-family:var(--tempo-mono);font-size:14px;font-variant-numeric:tabular-nums;color:var(--tempo-ink);white-space:nowrap}\n.tempo-risk-share{text-align:right;width:66px;font-family:var(--tempo-mono);font-size:14px;color:var(--tempo-muted);font-variant-numeric:tabular-nums}\n.tempo-risk-row .tempo-mini-bar{grid-column:1/-1;height:5px;border-radius:99px;background:#222825;overflow:hidden;margin:1px 0 0 19px}\n.tempo-risk-row .tempo-mini-bar span{display:block;height:100%;border-radius:inherit}\n.tempo-risk-row .tempo-mini-bar .green{background:var(--tempo-mint);width:50%}.tempo-risk-row .tempo-mini-bar .amber{background:var(--tempo-amber);width:25%}.tempo-risk-row .tempo-mini-bar .red{background:var(--tempo-red);width:25%}\n.tempo-caption{font-size:14px;color:var(--tempo-muted);margin:14px 0 0;line-height:1.55}\n.tempo-capacity-top{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin:2px 0 17px}\n.tempo-capacity-top .big{font-size:30px;line-height:1.1;font-weight:600;letter-spacing:-.04em;font-variant-numeric:tabular-nums}\n.tempo-capacity-top .big span{font-size:16px;font-weight:500;color:var(--tempo-muted);letter-spacing:0}\n.tempo-capacity-top .label{font-size:14px;color:var(--tempo-muted);margin-bottom:5px}\n.tempo-capacity-top .ratio{font-family:var(--tempo-mono);font-size:14px;color:var(--tempo-mint-ink);white-space:nowrap}\n.tempo-capacity-bar{height:12px;border-radius:999px;background:#252b28;overflow:hidden}\n.tempo-capacity-bar span{display:block;height:100%;width:20.2%;background:var(--tempo-mint);border-radius:inherit}\n.tempo-capacity-labels{display:flex;justify-content:space-between;gap:16px;margin-top:9px;font-size:14px;color:var(--tempo-muted)}\n.tempo-capacity-labels span:last-child{font-family:var(--tempo-mono);font-variant-numeric:tabular-nums;color:var(--tempo-ink)}\n.tempo-model{margin-top:27px}\n.tempo-model-intro{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:13px}\n.tempo-model-intro h2{font-size:18px;font-weight:600;letter-spacing:-.02em;margin:0}\n.tempo-model-intro p{font-size:14px;color:var(--tempo-muted);margin:0}\n.tempo-model-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}\n.tempo-reference{background:var(--tempo-panel);border:1px solid var(--tempo-edge);border-radius:14px;padding:18px 20px 19px}\n.tempo-reference h3{font-size:16px;font-weight:600;margin:0 0 4px}\n.tempo-reference .desc{font-size:14px;color:var(--tempo-muted);margin:0 0 14px}\n.tempo-threshold-table{width:100%;border-collapse:collapse;font-size:14px}\n.tempo-threshold-table th{text-align:left;text-transform:uppercase;letter-spacing:.04em;color:var(--tempo-muted);font-size:13px;font-weight:600;padding:7px 8px;border-bottom:1px solid var(--tempo-edge)}\n.tempo-threshold-table td{padding:9px 8px;border-bottom:1px solid var(--tempo-edge-soft)}\n.tempo-threshold-table tr:last-child td{border-bottom:0}\n.tempo-threshold-table td:last-child{text-align:right;font-family:var(--tempo-mono);font-size:14px;white-space:nowrap}\n.tempo-formula{font-family:var(--tempo-mono);font-size:14px;line-height:1.65;color:#d6dfd9;background:#0d100f;border:1px solid var(--tempo-edge-soft);border-radius:9px;padding:12px 13px;overflow-wrap:anywhere}\n.tempo-constants{display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;margin-top:13px;font-size:14px;color:var(--tempo-muted)}\n.tempo-constants strong{color:var(--tempo-ink);font-family:var(--tempo-mono);font-weight:500}\n.tempo-disclaimer{display:flex;align-items:flex-start;gap:9px;margin-top:15px;padding-top:13px;border-top:1px solid var(--tempo-edge-soft);font-size:14px;line-height:1.5;color:#d0c8a9}\n.tempo-disclaimer i{font-size:17px;color:var(--tempo-amber);margin-top:2px;flex:none}\n.tempo-mobile-list{display:none}\n.tempo-footer{font-size:14px;color:var(--tempo-dim);margin-top:22px;padding-top:14px;border-top:1px solid var(--tempo-edge-soft)}\n.tempo-screen a:focus-visible,.tempo-screen button:focus-visible,.tempo-screen [tabindex]:focus-visible{outline:3px solid var(--tempo-focus);outline-offset:3px;border-radius:5px}\n.tempo-screen button{font:inherit;color:inherit}\n@media(max-width:1460px){.tempo-main{padding-left:28px;padding-right:28px}.tempo-header{padding-left:28px;padding-right:28px}}\n@media(max-width:980px){.tempo-header{height:auto;min-height:68px;flex-wrap:wrap;padding-top:10px;padding-bottom:0;gap:8px}.tempo-header-left{gap:22px;flex:1}.tempo-nav{height:50px}.tempo-nav a{height:50px;padding:0 11px}.tempo-status{margin-bottom:8px}.tempo-next-grid,.tempo-model-grid{grid-template-columns:1fr}.tempo-model-intro{align-items:flex-start;flex-direction:column;gap:5px}}\n@media(max-width:700px){.tempo-header{padding:12px 16px 0;align-items:center}.tempo-header-left{width:100%;justify-content:space-between;gap:10px}.tempo-brand{font-size:16px}.tempo-mark{height:31px;width:31px}.tempo-nav{height:auto;display:flex;overflow-x:auto;max-width:100%;gap:2px;padding-top:6px}.tempo-nav a{height:43px;padding:0 12px;font-size:14px}.tempo-nav i{display:none}.tempo-status{align-self:flex-start;margin:0 0 10px;font-size:14px}.tempo-main{padding:22px 16px 40px}.tempo-pagehead{align-items:flex-start;flex-direction:column;gap:12px;margin-bottom:15px}.tempo-pagehead h1{font-size:25px}.tempo-pagehead p{font-size:15px}.tempo-demo-note{align-items:flex-start;padding:11px 12px;font-size:14px}.tempo-section-heading{align-items:flex-start;flex-direction:column;gap:5px}.tempo-panel-head{align-items:flex-start;flex-direction:column;gap:7px;padding:16px}.tempo-panel-body{padding:12px 16px 15px}.tempo-table-wrap{display:none}.tempo-mobile-list{display:block}.tempo-mobile-vehicle{padding:15px 0;border-bottom:1px solid var(--tempo-edge-soft)}.tempo-mobile-vehicle:last-child{border-bottom:0;padding-bottom:4px}.tempo-mobile-top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.tempo-mobile-top strong{display:block;font-size:15px;font-weight:600}.tempo-mobile-top small{display:block;font-family:var(--tempo-mono);font-size:14px;color:var(--tempo-muted);margin-top:2px}.tempo-mobile-top .stops{font-family:var(--tempo-mono);font-size:14px;color:var(--tempo-ink);white-space:nowrap}.tempo-mobile-bands{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.tempo-mobile-band{font-size:14px;color:var(--tempo-muted);line-height:1.4}.tempo-mobile-band b{display:block;font-family:var(--tempo-mono);font-size:14px;font-weight:500;margin-top:3px}.tempo-mobile-band .g{color:var(--tempo-mint-ink)}.tempo-mobile-band .y{color:var(--tempo-amber)}.tempo-mobile-band .r{color:var(--tempo-red)}.tempo-mobile-meter{margin-top:11px;height:8px;background:#252b28;border-radius:99px;overflow:hidden;display:flex;gap:2px}.tempo-mobile-meter span{display:block;height:100%}.tempo-mobile-meter .g{background:var(--tempo-mint)}.tempo-mobile-meter .y{background:var(--tempo-amber)}.tempo-mobile-meter .r{background:var(--tempo-red)}.tempo-table-foot{align-items:flex-start;flex-direction:column;gap:4px;padding:12px 16px}.tempo-next-grid{margin-top:19px;gap:13px}.tempo-legend-head{font-size:13px}.tempo-model{margin-top:21px}.tempo-reference{padding:16px}.tempo-constants{grid-template-columns:1fr}.tempo-risk-name{font-size:15px}.tempo-caption{font-size:14px}.tempo-footer{font-size:14px}}\n</style>\n<div class=\"tempo-screen\" data-kid=\"1\" data-name=\"analytics page layout container\">\n    <header class=\"tempo-header\" data-kid=\"1-1\" data-name=\"top header bar with brand and navigation\">\n        <div class=\"tempo-header-left\" data-kid=\"1-1-1\" data-name=\"header left group with brand and nav\">\n            <div class=\"tempo-brand\" data-kid=\"1-1-1-1\" data-name=\"brand lockup with logo and name\">\n                <span class=\"tempo-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand square logo mark\">\n                    T\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    T.E.M.P.O.\n                </span>\n            </div>\n            <nav aria-label=\"Main navigation\" class=\"tempo-nav\" data-kid=\"1-1-1-2\" data-name=\"main horizontal navigation\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"dashboard nav link with icon\" href=\"#dashboard\">\n                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-1-1\" data-name=\"dashboard icon\">\n                    </i>\n                    Dashboard\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"routes nav link with icon\" href=\"#routes\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-1-2-2-1\" data-name=\"route icon\">\n                    </i>\n                    Routes\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"alerts nav link with icon\" href=\"#alerts\">\n                    <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-1-1-2-3-1\" data-name=\"alert triangle icon\">\n                    </i>\n                    Alerts\n                </a>\n                <a aria-current=\"page\" data-kid=\"1-1-1-2-4\" data-name=\"analytics nav link (current page) with icon\" href=\"#analytics\">\n                    <i aria-hidden=\"true\" class=\"ti ti-chart-bar\" data-kid=\"1-1-1-2-4-1\" data-name=\"bar chart icon\">\n                    </i>\n                    Analytics\n                </a>\n            </nav>\n        </div>\n        <div class=\"tempo-status\" data-kid=\"1-1-2\" data-name=\"status badge indicating demo scenario\">\n            <i aria-hidden=\"true\" class=\"ti ti-flask-2\" data-kid=\"1-1-2-1\" data-name=\"flask demo indicator icon\">\n            </i>\n            Demo scenario · not live\n        </div>\n    </header>\n    <main class=\"tempo-main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"tempo-pagehead\" data-kid=\"1-2-1\" data-name=\"page title header with heading and subtitle\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page heading container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page headline text\">\n                    Analytics & Insights\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page description subtitle\">\n                    Compare route-stop risk by vehicle, then review fleet-level counts.\n                </p>\n            </div>\n        </div>\n        <div class=\"tempo-demo-note\" data-kid=\"1-2-2\" data-name=\"demo scenario warning note\" role=\"note\">\n            <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-2-1\" data-name=\"info circle icon\">\n            </i>\n            <span data-kid=\"1-2-2-2\" data-name=\"warning note body text\">\n                <strong data-kid=\"1-2-2-2-1\" data-name=\"warning bold lead-in text\">\n                    Demo scenario · not live.\n                </strong>\n                Illustrative values are shown because the current API feed is unavailable.\n            </span>\n        </div>\n        <section aria-labelledby=\"risk-breakdown-title\" data-kid=\"1-2-3\" data-name=\"per-vehicle risk breakdown section\">\n            <div class=\"tempo-section-heading\" data-kid=\"1-2-3-1\" data-name=\"section header with title and meta info\">\n                <h2 data-kid=\"1-2-3-1-1\" data-name=\"section title text\" id=\"risk-breakdown-title\">\n                    Per-vehicle risk breakdown\n                </h2>\n                <span class=\"meta\" data-kid=\"1-2-3-1-2\" data-name=\"section meta summary with icon\">\n                    <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-2-3-1-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    12 route stops across 3 vehicles\n                </span>\n            </div>\n            <div class=\"tempo-panel\" data-kid=\"1-2-3-2\" data-name=\"risk breakdown data panel\">\n                <div class=\"tempo-panel-head\" data-kid=\"1-2-3-2-1\" data-name=\"panel header with title and data note\">\n                    <div data-kid=\"1-2-3-2-1-1\" data-name=\"panel title and subtitle container\">\n                        <h3 data-kid=\"1-2-3-2-1-1-1\" data-name=\"panel title text\">\n                            Stop counts by model risk band\n                        </h3>\n                        <div class=\"sub\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"panel subtitle text\">\n                            Each stop is counted once; no combined risk score is applied.\n                        </div>\n                    </div>\n                    <div class=\"tempo-data-note\" data-kid=\"1-2-3-2-1-2\" data-name=\"demo data indicator note\">\n                        <span class=\"mint-dot\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"mint status dot icon\">\n                        </span>\n                        3 vehicles · 12 stops · demo data\n                    </div>\n                </div>\n                <div class=\"tempo-panel-body\" data-kid=\"1-2-3-2-2\" data-name=\"panel body with table and mobile list\">\n                    <div class=\"tempo-table-wrap\" data-kid=\"1-2-3-2-2-1\" data-name=\"table wrapper for horizontal scroll\">\n                        <table aria-label=\"Route stop counts by vehicle and estimated risk band\" class=\"tempo-table\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"route stop risk data table\">\n                            <thead data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"table header row\">\n                                <tr data-kid=\"1-2-3-2-2-1-1-1-1\" data-name=\"table header\">\n                                    <th data-kid=\"1-2-3-2-2-1-1-1-1-1\" data-name=\"vehicle column header\" style=\"width:23%\">\n                                        Vehicle\n                                    </th>\n                                    <th data-kid=\"1-2-3-2-2-1-1-1-1-2\" data-name=\"route stops column header\" style=\"width:10%\">\n                                        Route stops\n                                    </th>\n                                    <th data-kid=\"1-2-3-2-2-1-1-1-1-3\" data-name=\"distribution column header\" style=\"width:24%\">\n                                        Distribution\n                                    </th>\n                                    <th data-kid=\"1-2-3-2-2-1-1-1-1-4\" data-name=\"green band column header\" style=\"width:14%\">\n                                        <span data-kid=\"1-2-3-2-2-1-1-1-1-4-1\" data-name=\"green band header label\" style=\"color:var(--tempo-mint-ink)\">\n                                            Green band\n                                        </span>\n                                    </th>\n                                    <th data-kid=\"1-2-3-2-2-1-1-1-1-5\" data-name=\"yellow band column header\" style=\"width:14%\">\n                                        <span data-kid=\"1-2-3-2-2-1-1-1-1-5-1\" data-name=\"yellow band header label\" style=\"color:var(--tempo-amber)\">\n                                            Yellow band\n                                        </span>\n                                    </th>\n                                    <th data-kid=\"1-2-3-2-2-1-1-1-1-6\" data-name=\"red band column header\" style=\"width:15%\">\n                                        <span data-kid=\"1-2-3-2-2-1-1-1-1-6-1\" data-name=\"red band header label\" style=\"color:var(--tempo-red)\">\n                                            Red band\n                                        </span>\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"table body with vehicle rows\">\n                                <tr data-kid=\"1-2-3-2-2-1-1-2-1\" data-name=\"Tanker North vehicle data row\">\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-1-1\" data-name=\"vehicle name cell\">\n                                        <div class=\"tempo-vehicle\" data-kid=\"1-2-3-2-2-1-1-2-1-1-1\" data-name=\"vehicle name and ID container\">\n                                            <strong data-kid=\"1-2-3-2-2-1-1-2-1-1-1-1\" data-name=\"vehicle name text\">\n                                                Tanker North\n                                            </strong>\n                                            <span data-kid=\"1-2-3-2-2-1-1-2-1-1-1-2\" data-name=\"vehicle ID in monospace\">\n                                                VEH-001\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-1-2\" data-name=\"route stops count cell\">\n                                        <span class=\"tempo-count\" data-kid=\"1-2-3-2-2-1-1-2-1-2-1\" data-name=\"route stops count value\">\n                                            4\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-1-3\" data-name=\"distribution bar cell\">\n                                        <div class=\"tempo-mix\" data-kid=\"1-2-3-2-2-1-1-2-1-3-1\" data-name=\"distribution bar wrapper\">\n                                            <div aria-label=\"2 green, 1 yellow, 1 red of 4 stops\" class=\"tempo-segmentbar\" data-kid=\"1-2-3-2-2-1-1-2-1-3-1-1\" data-name=\"segmented risk distribution bar\">\n                                                <span class=\"green\" data-kid=\"1-2-3-2-2-1-1-2-1-3-1-1-1\" data-name=\"green segment of distribution bar\" style=\"width:50%\">\n                                                </span>\n                                                <span class=\"amber\" data-kid=\"1-2-3-2-2-1-1-2-1-3-1-1-2\" data-name=\"yellow segment of distribution bar\" style=\"width:25%\">\n                                                </span>\n                                                <span class=\"red\" data-kid=\"1-2-3-2-2-1-1-2-1-3-1-1-3\" data-name=\"red segment of distribution bar\" style=\"width:25%\">\n                                                </span>\n                                            </div>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-1-4\" data-name=\"green band count cell\">\n                                        <span class=\"tempo-band-count green\" data-kid=\"1-2-3-2-2-1-1-2-1-4-1\" data-name=\"green band count value\">\n                                            2 / 4\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-1-5\" data-name=\"yellow band count cell\">\n                                        <span class=\"tempo-band-count amber\" data-kid=\"1-2-3-2-2-1-1-2-1-5-1\" data-name=\"yellow band count value\">\n                                            1 / 4\n                                        </span>\n                                    </td>\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-1-6\" data-name=\"red band count cell\">\n                                        <span class=\"tempo-band-count red\" data-kid=\"1-2-3-2-2-1-1-2-1-6-1\" data-name=\"red band count value\">\n                                            1 / 4\n                                        </span>\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-3-2-2-1-1-2-2\" data-name=\"Tanker East vehicle data row\">\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-2-1\" data-name=\"vehicle name cell\">\n                                        <div class=\"tempo-vehicle\" data-kid=\"1-2-3-2-2-1-1-2-2-1-1\" data-name=\"vehicle name and ID container\">\n                                            <strong data-kid=\"1-2-3-2-2-1-1-2-2-1-1-1\" data-name=\"vehicle name text\">\n                                                Tanker East\n                                            </strong>\n                                            <span data-kid=\"1-2-3-2-2-1-1-2-2-1-1-2\" data-name=\"vehicle ID in monospace\">\n                                                VEH-002\n                                            </span>\n                                        </div>\n                                    </td>\n                                    <td data-kid=\"1-2-3-2-2-1-1-2-2-2\" data-name=\"route stops count cell\">\n                               