    },
    "var_4c868580b063": {
      "type": "variant",
      "label": "Round-led — Routes",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 6160,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.route-ui{--bg:#101211;--surface:#161918;--surface-2:#1b1f1e;--line:#2a302e;--line-soft:#232927;--text:#f2f5f3;--muted:#a3ada8;--quiet:#7e8984;--mint:#43d7b0;--mint-dim:#173e34;--red:#ff7085;--red-bg:#421f29;--amber:#efc15c;--amber-bg:#40351d;--green:#51d5a1;--green-bg:#183a30;min-height:100vh;background:var(--bg);color:var(--text);font-family:'DM Sans',Arial,sans-serif;font-size:14px;line-height:1.45;box-sizing:border-box;overflow-x:clip}.route-ui *{box-sizing:border-box}.route-ui button,.route-ui select{font:inherit}.route-ui button:focus-visible,.route-ui select:focus-visible,.route-ui a:focus-visible,.route-ui summary:focus-visible{outline:3px solid var(--mint);outline-offset:3px}.topbar{height:68px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;padding:0 32px;gap:32px;background:#111413}.brand{display:flex;align-items:center;gap:10px;font-size:17px;font-weight:700;letter-spacing:-.03em;white-space:nowrap}.brand-mark{width:31px;height:31px;border-radius:9px;background:var(--mint);color:#09261f;display:grid;place-items:center;font-weight:800;font-size:15px}.main-nav{height:100%;display:flex;align-items:center;gap:6px;flex:1}.nav-link{height:44px;display:flex;align-items:center;gap:9px;padding:0 15px;color:var(--muted);text-decoration:none;border-radius:9px;font-weight:600;white-space:nowrap}.nav-link i{font-size:17px;color:#87918d}.nav-link.active{color:var(--text);background:#1b201e;position:relative}.nav-link.active i{color:var(--mint)}.nav-link.active:after{content:'';position:absolute;bottom:0;left:14px;right:14px;height:2px;background:var(--mint);border-radius:2px}.header-right{display:flex;align-items:center;gap:12px}.feed-state{height:38px;padding:0 12px;border:1px solid #49333a;border-radius:9px;display:flex;align-items:center;gap:8px;color:#ffc0c9;font-size:13px;font-weight:600;white-space:nowrap}.state-dot{width:8px;height:8px;border-radius:50%;background:var(--red)}.profile{width:34px;height:34px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;color:#c2cbc6;font-size:14px}.content{max-width:1480px;margin:0 auto;padding:28px 32px 40px}.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:20px}.page-head h1{font-size:27px;line-height:1.12;letter-spacing:-.04em;margin:0 0 6px;font-weight:700}.page-head p{margin:0;color:var(--muted);font-size:14px}.demo-note{display:flex;align-items:center;gap:10px;padding:11px 14px;border:1px solid #574728;background:#211d15;border-radius:9px;color:#e2cf9a;font-size:13px;line-height:1.35;margin-bottom:18px}.demo-note i{font-size:18px;color:var(--amber);flex:none}.demo-note strong{color:#f4dd9d;font-weight:600}.controls{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:15px 16px;background:var(--surface);border:1px solid var(--line);border-radius:12px;margin-bottom:16px}.select-side{display:flex;align-items:center;gap:14px;min-width:0}.vehicle-label{color:var(--quiet);font-size:12px;text-transform:uppercase;letter-spacing:.07em;font-weight:700}.vehicle-select-wrap{position:relative;display:flex;align-items:center}.vehicle-select{appearance:none;color:var(--text);background:#202523;border:1px solid #39413e;border-radius:8px;height:44px;min-width:230px;padding:0 38px 0 13px;font-weight:600;cursor:pointer}.vehicle-select-wrap .ti-chevron-down{position:absolute;right:12px;color:var(--muted);pointer-events:none}.route-meta{display:flex;align-items:center;gap:8px;padding-left:4px;color:var(--muted);font-size:13px;white-space:nowrap}.route-meta .sep{color:#59615d}.route-meta strong{color:#dce2de;font-weight:600}.btn-primary{min-height:44px;padding:0 17px;border:0;border-radius:8px;background:var(--mint);color:#09271f;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;white-space:nowrap}.btn-primary i{font-size:17px}.btn-primary:hover{background:#68e2c0}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 316px;gap:17px;align-items:start}.ledger{background:var(--surface);border:1px solid var(--line);border-radius:12px;overflow:hidden}.ledger-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 18px;border-bottom:1px solid var(--line)}.ledger-title{display:flex;align-items:center;gap:10px}.ledger-title h2{font-size:16px;margin:0;font-weight:700;letter-spacing:-.015em}.ledger-title .count{font-size:12px;color:var(--muted);padding-left:10px;border-left:1px solid var(--line)}.route-total{display:flex;align-items:center;gap:7px;color:#b7c0bb;font-size:13px;white-space:nowrap}.route-total i{color:var(--mint);font-size:16px}.column-head,.stop-row{display:grid;grid-template-columns:42px minmax(158px,1.55fr) minmax(76px,.78fr) minmax(77px,.78fr) minmax(70px,.7fr) minmax(66px,.68fr) minmax(67px,.7fr) minmax(72px,.7fr) 86px;column-gap:8px;align-items:center;padding-left:16px;padding-right:16px}.column-head{min-height:43px;color:var(--quiet);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.055em;background:#131716;border-bottom:1px solid var(--line)}.stop-row{min-height:75px;border-bottom:1px solid var(--line-soft);position:relative}.stop-row:last-child{border-bottom:0}.stop-row.critical-row{background:linear-gradient(90deg,rgba(255,112,133,.08),rgba(255,112,133,.015) 54%,transparent)}.stop-row.next-row{background:linear-gradient(90deg,rgba(67,215,176,.045),transparent 50%)}.seq{position:relative;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;background:#252a28;color:#c5cec9;border:1px solid #3a423e}.seq.done{background:var(--mint-dim);color:var(--mint);border-color:#25604d}.seq.danger{background:var(--red-bg);color:#ffabb7;border-color:#79404b}.seq.current{box-shadow:0 0 0 3px #1e4539;border-color:var(--mint);color:#c6ffed}.stop-name{min-width:0}.stop-name strong{font-size:13.5px;font-weight:600;color:#edf1ef;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stop-name span{display:flex;align-items:center;gap:7px;color:var(--quiet);font-size:12px;margin-top:4px;white-space:nowrap}.stage{font-size:11px;font-weight:700;letter-spacing:.01em}.stage.done{color:var(--mint)}.stage.current{color:#75dfbe}.stage.upcoming{color:#89948e}.mono{font-family:'IBM Plex Mono',monospace;font-size:12px;font-variant-numeric:tabular-nums;color:#d4dbd7;white-space:nowrap}.mono.muted{color:#68736d}.dim-label{color:var(--quiet);font-size:12px}.risk-tag{min-height:27px;display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:0 8px;border-radius:6px;font-size:11px;font-weight:700;letter-spacing:.03em;width:max-content}.risk-tag:before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.risk-tag.green{color:#6be2b5;background:var(--green-bg)}.risk-tag.yellow{color:#f3d27f;background:var(--amber-bg)}.risk-tag.red{color:#ff9dac;background:var(--red-bg)}.risk-tag.unknown{color:#a9b2ad;background:#282e2b}.action-cell{display:flex;justify-content:flex-end}.reroute{height:36px;padding:0 10px;border-radius:7px;border:1px solid #71414a;background:#301c22;color:#ffb0bc;font-size:12px;font-weight:700;display:inline-flex;align-items:center;gap:5px;cursor:pointer}.reroute i{font-size:15px}.reroute:hover{background:#48252d}.no-action{color:#56615b;font-size:12px}.ledger-foot{display:flex;align-items:center;gap:8px;padding:11px 17px;color:#abb5af;font-size:12px;border-top:1px solid var(--line-soft);background:#141817}.ledger-foot i{font-size:15px;color:var(--amber)}.rail{display:flex;flex-direction:column;gap:14px}.result-panel,.vehicle-panel{background:var(--surface);border:1px solid var(--line);border-radi