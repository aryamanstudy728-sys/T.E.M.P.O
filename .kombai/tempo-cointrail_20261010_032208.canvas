      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\"); @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n.tempo-ui{--page:#0b0e0d;--nav:#0e1211;--surface:#121715;--surface-raised:#171d1a;--edge:#2a3430;--edge-soft:#202925;--ink:#edf3ef;--muted:#a0ada6;--subtle:#7d8982;--mint:#46d5b0;--mint-dim:#173d32;--amber:#e7b74b;--amber-dim:#40351b;--red:#f07888;--red-dim:#401f27;min-height:100vh;background:var(--page);color:var(--ink);font-family:Inter,system-ui,sans-serif;font-size:14px;line-height:1.45}.tempo-ui *{box-sizing:border-box}.mono{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums}.app-head{height:68px;background:var(--nav);border-bottom:1px solid var(--edge);display:flex;align-items:center;padding:0 42px;gap:42px}.brand{display:flex;align-items:center;gap:11px;white-space:nowrap;color:var(--ink);font-weight:700;font-size:16px;letter-spacing:-.035em}.brand-mark{width:32px;height:32px;border-radius:9px;display:grid;place-items:center;color:#092018;background:var(--mint);font-weight:800;font-size:15px}.main-nav{display:flex;align-items:center;gap:8px;height:100%;flex:1}.main-nav a{height:100%;display:flex;align-items:center;padding:0 14px;color:var(--muted);text-decoration:none;border-bottom:2px solid transparent;font-weight:500;white-space:nowrap}.main-nav a[aria-current=page]{color:var(--ink);border-bottom-color:var(--mint)}.main-nav a:focus-visible,.menu-button:focus-visible{outline:2px solid var(--mint);outline-offset:3px;border-radius:4px}.head-state{display:flex;align-items:center;gap:9px;white-space:nowrap;color:#f1d48f;font-size:13px;padding:8px 11px;border:1px solid #594821;background:#1e1a11;border-radius:6px}.state-dot{height:7px;width:7px;border-radius:50%;background:var(--amber)}.menu-button{display:none;border:1px solid var(--edge);background:var(--surface-raised);color:var(--ink);border-radius:7px;width:42px;height:42px}.content{max-width:1500px;margin:0 auto;padding:30px 42px 48px}.title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:19px}.title-row h1{font-size:27px;letter-spacing:-.045em;line-height:1.15;margin:0 0 8px;font-weight:650}.title-row p{margin:0;color:var(--muted);font-size:14px}.demo-note{display:flex;gap:10px;align-items:flex-start;max-width:640px;color:#d8c48c;font-size:13px;line-height:1.45;padding:10px 13px;background:#17150f;border:1px solid #493e21;border-radius:6px}.demo-note i{flex:0 0 17px;color:var(--amber);width:17px;height:17px}.summary-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:22px 0 24px;border-top:1px solid var(--edge-soft);border-bottom:1px solid var(--edge-soft);padding:14px 0}.summary-item{padding:0 23px;border-right:1px solid var(--edge-soft)}.summary-item:first-child{padding-left:0}.summary-item:last-child{border-right:0}.summary-label{display:block;color:var(--muted);font-size:13px;margin-bottom:5px}.summary-value{display:flex;align-items:baseline;gap:7px;font-size:23px;line-height:1.1;letter-spacing:-.035em;font-weight:650;font-variant-numeric:tabular-nums}.summary-value small{font-size:13px;letter-spacing:0;color:var(--muted);font-weight:500}.tone-mint{color:var(--mint)}.tone-amber{color:var(--amber)}.tone-red{color:var(--red)}.analysis-layout{display:grid;grid-template-columns:minmax(0,1fr) 368px;gap:18px;align-items:start}.main-column{display:flex;flex-direction:column;gap:18px;min-width:0}.support-rail{display:flex;flex-direction:column;gap:18px;min-width:0}.panel{background:var(--surface);border:1px solid var(--edge);border-radius:10px;min-width:0}.panel-head{padding:17px 19px 14px;display:flex;justify-content:space-between;align-items:flex-start;gap:14px;border-bottom:1px solid var(--edge-soft)}.panel-head h2{font-size:15px;line-height:1.3;letter-spacing:-.015em;margin:0;font-weight:600}.panel-head p{margin:5px 0 0;color:var(--muted);font-size:13px}.panel-body{padding:18px 19px}.subtle-meta{color:var(--muted);font-size:13px}.risk-list{display:flex;flex-direction:column;gap:17px}.risk-row{display:grid;grid-template-columns:166px minmax(100px,1fr) 118px;align-items:center;gap:16px}.risk-label{display:flex;flex-direction:column;gap:3px}.risk-label strong{font-size:14px;font-weight:550}.risk-label span{color:var(--muted);font-size:13px}.bar-track{height:12px;background:#222a26;border-radius:3px;overflow:hidden}.bar-fill{height:100%;border-radius:3px}.bar-fill.safe{background:var(--mint)}.bar-fill.warning{background:var(--amber)}.bar-fill.critical{background:var(--red)}.risk-count{text-align:right;font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums}.risk-count strong{color:var(--ink);font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:500;margin-right:4px}.risk-foot{margin-top:19px;padding-top:13px;border-top:1px solid var(--edge-soft);display:flex;align-items:center;justify-content:space-between;gap:16px;color:var(--muted);font-size:13px}.risk-foot strong{font-family:'IBM Plex Mono',monospace;color:var(--ink);font-weight:500}.table-wrap{overflow-x:auto;scrollbar-color:#46524b var(--surface);scrollbar-width:thin}.table-hint{display:none;color:var(--muted);font-size:13px;padding:0 18px 12px}.risk-table{border-collapse:collapse;width:100%;min-width:680px;font-variant-numeric:tabular-nums}.risk-table th{font-weight:500;color:var(--muted);font-size:13px;text-align:right;padding:12px 15px;border-bottom:1px solid var(--edge-soft);white-space:nowrap}.risk-table th:first-child,.risk-table td:first-child{text-align:left;position:sticky;left:0;background:var(--surface);z-index:1}.risk-table td{padding:14px 15px;text-align:right;border-bottom:1px solid var(--edge-soft);font-size:14px;color:#d5ddd8;white-space:nowrap}.risk-table tbody tr:last-child td{border-bottom:0}.vehicle-name{display:flex;align-items:center;gap:10px;min-width:160px}.vehicle-symbol{height:28px;width:28px;border-radius:7px;display:grid;place-items:center;background:#1b2520;color:var(--mint);font-size:15px}.vehicle-name strong{font-weight:550;color:var(--ink)}.risk-number{font-family:'IBM Plex Mono',monospace}.risk-score{font-family:'IBM Plex Mono',monospace;color:var(--muted)}.risk-table tfoot td{border-top:1px solid var(--edge);font-weight:600;color:var(--ink);background:#141a17}.util-top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;margin-bottom:14px}.util-top .summary-value{font-size:30px}.util-track{height:10px;border-radius:3px;background:#222a26;overflow:hidden;margin-bottom:10px}.util-fill{height:100%;width:74.6%;background:var(--mint);border-radius:3px}.util-denom{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}.rail-stat-row{display:flex;justify-content:space-between;gap:12px;padding-top:13px;margin-top:13px;border-top:1px solid var(--edge-soft);font-size:13px;color:var(--muted)}.rail-stat-row strong{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--ink);font-weight:500}.estimate-label{display:inline-flex;align-items:center;gap:7px;padding:5px 8px;border-radius:5px;color:#e6c774;background:#262113;font-size:12px;white-space:nowrap}.estimate-label i{width:14px;height:14px;color:var(--amber)}.threshold-list{display:flex;flex-direction:column}.threshold-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:13px;padding:12px 0;border-bottom:1px solid var(--edge-soft)}.threshold-row:first-child{padding-top:0}.threshold-row:last-child{border-bottom:0;padding-bottom:1px}.threshold-name{font-size:14px;color:var(--ink);font-weight:500}.threshold-desc{font-size:13px;color:var(--muted);margin-top:3px}.threshold-value{font-family:'IBM Plex Mono',monospace;font-size:13px;color:#e8c96f;white-space:nowrap}.model-copy{color:var(--muted);font-size:13px;margin:0 0 14px}.formula-box{padding:13px 12px;border:1px solid var(--edge-soft);border-radius:6px;background:#0e1311;color:#dbe6df;font:13px/1.7 'IBM Plex Mono',monospace;overflow-wrap:anywhere}.formula-vars{display:grid;grid-template-columns:1fr 1fr;column-gap:14px;row-gap:9px;margin-top:14px}.formula-vars div{font-size:13px;color:var(--muted)}.formula-vars strong{font-family:'IBM Plex Mono',monospace;color:#d8e2dc;font-weight:500}.model-caution{padding-top:12px;border-top:1px solid var(--edge-soft);margin-top:14px;color:var(--muted);font-size:13px}.model-caution strong{color:#e8c96f;font-weight:550}.focus-ring:focus-visible{outline:2px solid var(--mint);outline-offset:3px}.screen-reader{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:1000px){.app-head{padding:0 24px;gap:24px}.content{padding-left:24px;padding-right:24px}.analysis-layout{grid-template-columns:minmax(0,1fr) 320px;gap:14px}.risk-row{grid-template-columns:140px minmax(80px,1fr) 108px;gap:12px}}\n@media(max-width:760px){.app-head{height:62px;padding:0 16px;gap:14px}.brand{font-size:15px}.brand-mark{width:30px;height:30px}.main-nav{overflow-x:auto;gap:0}.main-nav a{padding:0 11px;font-size:13px}.head-state{font-size:12px;padding:7px 9px}.content{padding:24px 18px 36px}.title-row{display:block}.demo-note{margin-top:16px;max-width:none}.summary-strip{grid-template-columns:repeat(2,minmax(0,1fr));row-gap:15px}.summary-item:nth-child(2){border-right:0}.summary-item:nth-child(3){padding-left:0}.analysis-layout{grid-template-columns:1fr}.support-rail{order:2}.risk-row{grid-template-columns:145px minmax(80px,1fr) 105px}.table-hint{display:block}.panel-head,.panel-body{padding-left:16px;padding-right:16px}}\n@media(max-width:520px){.app-head{padding:0 13px}.main-nav{gap:0}.main-nav a{padding:0 8px;font-size:12px}.head-state{padding:7px 8px}.head-state .state-text{display:none}.content{padding:21px 14px 30px}.title-row h1{font-size:24px}.summary-item{padding:0 14px}.summary-item:nth-child(2){padding-right:0}.summary-value{font-size:21px}.risk-row{grid-template-columns:105px minmax(60px,1fr) 90px;gap:9px}.risk-count{font-size:12px}.risk-count strong{font-size:13px}.risk-label strong{font-size:13px}.risk-label span{font-size:12px}.risk-foot{align-items:flex-start;flex-direction:column;gap:6px}.formula-vars{grid-template-columns:1fr}.demo-note{font-size:13px}}\n</style>\n<div class=\"tempo-ui\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"app-head\" data-kid=\"1-1\" data-name=\"application top header bar\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo with name\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logomark badge\">\n                T\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                T.E.M.P.O.\n            </span>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"main-nav\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <a class=\"focus-ring\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"/dashboard\">\n                Dashboard\n            </a>\n            <a class=\"focus-ring\" data-kid=\"1-1-2-2\" data-name=\"routes navigation link\" href=\"/routes\">\n                Routes\n            </a>\n            <a class=\"focus-ring\" data-kid=\"1-1-2-3\" data-name=\"alerts navigation link\" href=\"/alerts\">\n                Alerts\n            </a>\n            <a aria-current=\"page\" class=\"focus-ring\" data-kid=\"1-1-2-4\" data-name=\"analytics navigation link (active page)\" href=\"/analytics\">\n                Analytics\n            </a>\n        </nav>\n        <div class=\"head-state\" data-kid=\"1-1-3\" data-name=\"demo scenario status chip\">\n            <span class=\"state-dot\" data-kid=\"1-1-3-1\" data-name=\"status indicator dot\">\n            </span>\n            <span class=\"state-text\" data-kid=\"1-1-3-2\" data-name=\"demo status label text\">\n                Demo scenario · not live\n            </span>\n        </div>\n    </header>\n    <main class=\"content\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"title-row\" data-kid=\"1-2-1\" data-name=\"page title row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page heading block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page headline\">\n                    Analytics & insights\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page headline subtitle\">\n                    Thermal safety and fleet performance for the current collection round.\n                </p>\n            </div>\n            <div class=\"demo-note\" data-kid=\"1-2-1-2\" data-name=\"demo disclaimer note banner\" role=\"note\">\n                <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-2-1-2-1\" data-name=\"warning triangle icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"demo disclaimer text\">\n                    Representative demo values — not live observations. Risk thresholds and model inputs are estimates, not a safety certification.\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Current round summary\" class=\"summary-strip\" data-kid=\"1-2-2\" data-name=\"current round summary metrics strip\">\n            <div class=\"summary-item\" data-kid=\"1-2-2-1\" data-name=\"average TSB summary item\">\n                <span class=\"summary-label\" data-kid=\"1-2-2-1-1\" data-name=\"summary metric label\">\n                    Average TSB\n                </span>\n                <div class=\"summary-value\" data-kid=\"1-2-2-1-2\" data-name=\"summary metric value\">\n                    4.1\n                    <small data-kid=\"1-2-2-1-2-1\" data-name=\"metric unit suffix\">\n                        hours\n                    </small>\n                </div>\n            </div>\n            <div class=\"summary-item\" data-kid=\"1-2-2-2\" data-name=\"safe stops summary item\">\n                <span class=\"summary-label\" data-kid=\"1-2-2-2-1\" data-name=\"summary metric label\">\n                    Safe stops\n                </span>\n                <div class=\"summary-value tone-mint\" data-kid=\"1-2-2-2-2\" data-name=\"summary metric value\">\n                    18\n                    <small data-kid=\"1-2-2-2-2-1\" data-name=\"metric value context suffix\">\n                        of 26\n                    </small>\n                </div>\n            </div>\n            <div class=\"summary-item\" data-kid=\"1-2-2-3\" data-name=\"warning stops summary item\">\n                <span class=\"summary-label\" data-kid=\"1-2-2-3-1\" data-name=\"summary metric label\">\n                    Warning stops\n                </span>\n                <div class=\"summary-value tone-amber\" data-kid=\"1-2-2-3-2\" data-name=\"summary metric value\">\n                    6\n                    <small data-kid=\"1-2-2-3-2-1\" data-name=\"metric value context suffix\">\n                        of 26\n                    </small>\n                </div>\n            </div>\n            <div class=\"summary-item\" data-kid=\"1-2-2-4\" data-name=\"critical stops summary item\">\n                <span class=\"summary-label\" data-kid=\"1-2-2-4-1\" data-name=\"summary metric label\">\n                    Critical stops\n                </span>\n                <div class=\"summary-value tone-red\" data-kid=\"1-2-2-4-2\" data-name=\"summary metric value\">\n                    2\n                    <small data-kid=\"1-2-2-4-2-1\" data-name=\"metric value context suffix\">\n                        of 26\n                    </small>\n                </div>\n            </div>\n        </section>\n        <div class=\"analysis-layout\" data-kid=\"1-2-3\" data-name=\"analysis two-column layout\">\n            <section aria-label=\"Thermal and vehicle comparisons\" class=\"main-column\" data-kid=\"1-2-3-1\" data-name=\"main analysis column\">\n                <article class=\"panel\" data-kid=\"1-2-3-1-1\" data-name=\"thermal risk distribution panel\">\n                    <div class=\"panel-head\" data-kid=\"1-2-3-1-1-1\" data-name=\"panel header with title and meta\">\n                        <div data-kid=\"1-2-3-1-1-1-1\" data-name=\"panel title block\">\n                            <h2 data-kid=\"1-2-3-1-1-1-1-1\" data-name=\"panel title heading\">\n                                Thermal risk distribution\n                            </h2>\n                            <p data-kid=\"1-2-3-1-1-1-1-2\" data-name=\"panel title subtitle\">\n                                Route-stop count by estimated remaining TSB buffer\n                            </p>\n                        </div>\n                        <span class=\"subtle-meta\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"panel meta count label\">\n                            26 stops\n                        </span>\n                    </div>\n                    <div class=\"panel-body\" data-kid=\"1-2-3-1-1-2\" data-name=\"panel body with bars and caption\">\n                        <div aria-label=\"Among 26 demo stops, 18 are in the safe band, 6 in the warning band, and 2 in the critical band\" class=\"risk-list\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"risk distribution bar chart\" role=\"img\">\n                            <div class=\"risk-row\" data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"safe risk row\">\n                                <div class=\"risk-label\" data-kid=\"1-2-3-1-1-2-1-1-1\" data-name=\"risk band label\">\n                                    <strong data-kid=\"1-2-3-1-1-2-1-1-1-1\" data-name=\"risk band name\">\n                                        Safe\n                                    </strong>\n                                    <span data-kid=\"1-2-3-1-1-2-1-1-1-2\" data-name=\"risk band threshold descriptor\">\n                                        Above 2.5 hours\n                                    </span>\n                                </div>\n                                <div class=\"bar-track\" data-kid=\"1-2-3-1-1-2-1-1-2\" data-name=\"bar track\">\n                                    <div class=\"bar-fill safe\" data-kid=\"1-2-3-1-1-2-1-1-2-1\" data-name=\"safe risk bar fill\" style=\"width:69.2%\">\n                                    </div>\n                                </div>\n                                <div class=\"risk-count\" data-kid=\"1-2-3-1-1-2-1-1-3\" data-name=\"risk count with percentage\">\n                                    <strong data-kid=\"1-2-3-1-1-2-1-1-3-1\" data-name=\"stop count number\">\n                                        18\n                                    </strong>\n                                    69.2%\n                                </div>\n                            </div>\n                            <div class=\"risk-row\" data-kid=\"1-2-3-1-1-2-1-2\" data-name=\"warning risk row\">\n                                <div class=\"risk-label\" data-kid=\"1-2-3-1-1-2-1-2-1\" data-name=\"risk band label\">\n                                    <strong data-kid=\"1-2-3-1-1-2-1-2-1-1\" data-name=\"risk band name\">\n                                        Warning\n                                    </strong>\n                                    <span data-kid=\"1-2-3-1-1-2-1-2-1-2\" data-name=\"risk band threshold descriptor\">\n                                        0.5–2.5 hours\n                                    </span>\n                                </div>\n                                <div class=\"bar-track\" data-kid=\"1-2-3-1-1-2-1-2-2\" data-name=\"bar track\">\n                                    <div class=\"bar-fill warning\" data-kid=\"1-2-3-1-1-2-1-2-2-1\" data-name=\"warning risk bar fill\" style=\"width:23.1%\">\n                                    </div>\n                                </div>\n                                <div class=\"risk-count\" data-kid=\"1-2-3-1-1-2-1-2-3\" data-name=\"risk count with percentage\">\n                                    <strong data-kid=\"1-2-3-1-1-2-1-2-3-1\" data-name=\"stop count number\">\n                                        6\n                                    </strong>\n                                    23.1%\n                                </div>\n                            </div>\n                            <div class=\"risk-row\" data-kid=\"1-2-3-1-1-2-1-3\" data-name=\"critical risk row\">\n                                <div class=\"risk-label\" data-kid=\"1-2-3-1-1-2-1-3-1\" data-name=\"risk band label\">\n                                    <strong data-kid=\"1-2-3-1-1-2-1-3-1-1\" data-name=\"risk band name\">\n                                        Critical\n                                    </strong>\n                                    <span data-kid=\"1-2-3-1-1-2-1-3-1-2\" data-name=\"risk band threshold descriptor\">\n                                        Under 0.5 hours\n                                    </span>\n                                </div>\n                                <div class=\"bar-track\" data-kid=\"1-2-3-1-1-2-1-3-2\" data-name=\"bar track\">\n                                    <div class=\"bar-fill critical\" data-kid=\"1-2-3-1-1-2-1-3-2-1\" data-name=\"critical risk bar fill\" style=\"width:7.7%\">\n                                    </div>\n                                </div>\n                                <div class=\"risk-count\" data-kid=\"1-2-3-1-1-2-1-3-3\" data-name=\"risk count with percentage\">\n                                    <strong data-kid=\"1-2-3-1-1-2-1-3-3-1\" data-name=\"stop count number\">\n                                        2\n                                    </strong>\n                                    7.7%\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"risk-foot\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"chart footer caption\">\n                            <span data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"chart footnote text\">\n                                Share of stops in this demo round\n                            </span>\n                            <strong data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"chart total stops counter\">\n                                26 total stops\n                            </strong>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"panel\" data-kid=\"1-2-3-1-2\" data-name=\"per-vehicle risk breakdown panel\">\n                    <div class=\"panel-head\" data-kid=\"1-2-3-1-2-1\" data-name=\"panel header with title and meta\">\n                        <div data-kid=\"1-2-3-1-2-1-1\" data-name=\"panel title block\">\n                            <h2 data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"panel title heading\">\n                                Per-vehicle risk breakdown\n                            </h2>\n                            <p data-kid=\"1-2-3-1-2-1-1-2\" data-name=\"panel title subtitle\">\n                                Stops by estimated thermal risk band\n                            </p>\n                        </div>\n                        <span class=\"subtle-meta\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"panel meta count label\">\n                            3 demo vehicles\n                        </span>\n                    </div>\n                    <div class=\"table-hint\" data-kid=\"1-2-3-1-2-2\" data-name=\"mobile horizontal scroll hint\">\n                        Swipe horizontally to compare all columns →\n                    </div>\n                    <div aria-label=\"Per-vehicle risk breakdown table\" class=\"table-wrap\" data-kid=\"1-2-3-1-2-3\" data-name=\"scrollable table region\" role=\"region\" tabindex=\"0\">\n                        <table class=\"risk-table\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"risk data table\">\n                            <thead data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"table header row\">\n                                <tr data-kid=\"1-2-3-1-2-3-1-1-1\" data-name=\"table header\">\n                                    <th data-kid=\"1-2-3-1-2-3-1-1-1-1\" data-name=\"vehicle column header\" scope=\"col\">\n                                        Vehicle\n                                    </th>\n                                    <th class=\"tone-mint\" data-kid=\"1-2-3-1-2-3-1-1-1-2\" data-name=\"safe column header\" scope=\"col\">\n                                        Safe\n                                    </th>\n                                    <th class=\"tone-amber\" data-kid=\"1-2-3-1-2-3-1-1-1-3\" data-name=\"warning column header\" scope=\"col\">\n                                        Warning\n                                    </th>\n                                    <th class=\"tone-red\" data-kid=\"1-2-3-1-2-3-1-1-1-4\" data-name=\"critical column header\" scope=\"col\">\n                                        Critical\n                                    </th>\n                                    <th data-kid=\"1-2-3-1-2-3-1-1-1-5\" data-name=\"stops column header\" scope=\"col\">\n                                        Stops\n                                    </th>\n                                    <th data-kid=\"1-2-3-1-2-3-1-1-1-6\" data-name=\"risk score column header\" scope=\"col\">\n                                        Risk score\n                                    </th>\n                                </tr>\n                            </thead>\n                            <tbody data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"table body with vehicle rows\">\n                                <tr data-kid=\"1-2-3-1-2-3-1-2-1\" data-name=\"tanker 1 data row\">\n                                    <td data-kid=\"1-2-3-1-2-3-1-2-1-1\" data-name=\"vehicle name cell\">\n                                        <span class=\"vehicle-name\" data-kid=\"1-2-3-1-2-3-1-2-1-1-1\" data-name=\"vehicle name cell content\">\n                                            <span class=\"vehicle-symbol\" data-kid=\"1-2-3-1-2-3-1-2-1-1-1-1\" data-name=\"vehicle icon badge\">\n                                                <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-3-1-2-3-1-2-1-1-1-1-1\" data-name=\"truck icon\" style=\"width:16px;height:16px;color:var(--mint)\">\n                                                </i>\n                                            </span>\n                                            <strong data-kid=\"1-2-3-1-2-3-1-2-1-1-1-2\" data-name=\"vehicle name text\">\n                                                Tanker 1\n                                            </strong>\n                                        </span>\n                                    </td>\n                                    <td class=\"risk-number tone-mint\" data-kid=\"1-2-3-1-2-3-1-2-1-2\" data-name=\"safe stops cell\">\n                                        7\n                                    </td>\n                                    <td class=\"risk-number tone-amber\" data-kid=\"1-2-3-1-2-3-1-2-1-3\" data-name=\"warning stops cell\">\n                                        2\n                                    </td>\n                                    <td class=\"risk-number tone-red\" data-kid=\"1-2-3-1-2-3-1-2-1-4\" data-name=\"critical stops cell\">\n                                        0\n                                    </td>\n                                    <td class=\"risk-number\" data-kid=\"1-2-3-1-2-3-1-2-1-5\" data-name=\"total stops cell\">\n                                        9\n                                    </td>\n                                    <td class=\"risk-score\" data-kid=\"1-2-3-1-2-3-1-2-1-6\" data-name=\"risk score cell\">\n                                        7%\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-3-1-2-3-1-2-2\" data-name=\"tanker 2 data row\">\n                                    <td data-kid=\"1-2-3-1-2-3-1-2-2-1\" data-name=\"vehicle name cell\">\n                                        <span class=\"vehicle-name\" data-kid=\"1-2-3-1-2-3-1-2-2-1-1\" data-name=\"vehicle name cell content\">\n                                            <span class=\"vehicle-symbol\" data-kid=\"1-2-3-1-2-3-1-2-2-1-1-1\" data-name=\"vehicle icon badge\">\n                                                <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-3-1-2-3-1-2-2-1-1-1-1\" data-name=\"truck icon\" style=\"width:16px;height:16px;color:var(--mint)\">\n                                                </i>\n                                            </span>\n                                            <strong data-kid=\"1-2-3-1-2-3-1-2-2-1-1-2\" data-name=\"vehicle name text\">\n                                                Tanker 2\n                                            </strong>\n                                        </span>\n                                    </td>\n                                    <td class=\"risk-number tone-mint\" data-kid=\"1-2-3-1-2-3-1-2-2-2\" data-name=\"safe stops cell\">\n                                        5\n                                    </td>\n                                    <td class=\"risk-number tone-amber\" data-kid=\"1-2-3-1-2-3-1-2-2-3\" data-name=\"warning stops cell\">\n                                        2\n                                    </td>\n                                    <td class=\"risk-number tone-red\" data-kid=\"1-2-3-1-2-3-1-2-2-4\" data-name=\"critical stops cell\">\n                                        1\n                                    </td>\n                                    <td class=\"risk-number\" data-kid=\"1-2-3-1-2-3-1-2-2-5\" data-name=\"total stops cell\">\n                                        8\n                                    </td>\n                                    <td class=\"risk-score\" data-kid=\"1-2-3-1-2-3-1-2-2-6\" data-name=\"risk score cell\">\n                                        21%\n                                    </td>\n                                </tr>\n                                <tr data-kid=\"1-2-3-1-2-3-1-2-3\" data-name=\"tanker 3 data row\">\n                                    <td data-kid=\"1-2-3-1-2-3-1-2-3-1\" data-name=\"vehicle name cell\">\n                                        <span class=\"vehicle-name\" data-kid=\"1-2-3-1-2-3-1-2-3-1-1\" data-name=\"vehicle name cell content\">\n                                            <span class=\"vehicle-symbol\" data-kid=\"1-2-3-1-2-3-1-2-3-1-1-1\" data-name=\"vehicle icon badge\">\n                                                <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-3-1-2-3-1-2-3-1-1-1-1\" data-name=\"truck icon\" style=\"width:16px;height:16px;color:var(--mint)\">\n                                                </i>\n                                            </span>\n                                            <strong data-kid=\"1-2-3-1-2-3-1-2-3-1-1-2\" data-name=\"vehicle name text\">\n                                                Tanker 3\n                                            </strong>\n                                        </span>\n                                    </td>\n                                    <td class=\"risk-number tone-mint\" data-kid=\"1-2-3-1-2-3-1-2-3-2\" data-name=\"safe stops cell\">\n                                        6\n                                    </td>\n                                    <td class=\"risk-number tone-amber\" data-kid=\"1-2-3-1-2-3-1-2-3-3\" data-name=\"warning stops cell\">\n                                        2\n                                    </td>\n                                    <td class=\"risk-number tone-red\" data-kid=\"1-2-3-1-2-3-1-2-3-4\" data-name=\"critical stops cell\">\n                                        1\n                                    </td>\n                                    <td class=\"risk-number\" data-kid=\"1-2-3-1-2-3-1-2-3-5\" data-name=\"total stops cell\">\n                                        9\n                                    </td>\n                                    <td class=\"risk-score\" data-kid=\"1-2-3-1-2-3-1-2-3-6\" data-name=\"risk score cell\">\n                                        19%\n                                    </td>\n                                </tr>\n                            </tbody>\n                            <tfoot data-kid=\"1-2-3-1-2-3-1-3\" data-name=\"table footer totals row\">\n                                <tr data-kid=\"1-2-3-1-2-3-1-3-1\" data-name=\"totals row\">\n                                    <td data-kid=\"1-2-3-1-2-3-1-3-1-1\" data-name=\"total row label\">\n                                        Total\n                                    </td>\n                                    <td class=\"risk-number tone-mint\" data-kid=\"1-2-3-1-2-3-1-3-1-2\" data-name=\"totals safe cell\">\n                                        18\n                                    </td>\n                                    <td class=\"risk-number tone-amber\" data-kid=\"1-2-3-1-2-3-1-3-1-3\" data-name=\"totals warning cell\">\n                                        6\n                                    </td>\n                                    <td class=\"risk-number tone-red\" data-kid=\"1-2-3-1-2-3-1-3-1-4\" data-name=\"totals critical cell\">\n                                        2\n                                    </td>\n                                    <td class=\"risk-number\" data-kid=\"1-2-3-1-2-3-1-3-1-5\" data-name=\"totals stops cell\">\n                                        26\n                                    </td>\n                                    <td data-kid=\"1-2-3-1-2-3-1-3-1-6\" data-name=\"totals risk score em dash\">\n                                        —\n                                    </td>\n                                </tr>\n                            </tfoot>\n                        </table>\n                    </div>\n                    <div class=\"panel-body\" data-kid=\"1-2-3-1-2-4\" data-name=\"risk score footnote body\" style=\"padding-top:12px\">\n                        <p class=\"subtle-meta\" data-kid=\"1-2-3-1-2-4-1\" data-name=\"risk score calculation footnote text\" style=\"margin:0\">\n                            Risk score follows the current app calculation: warning stops count 1, critical stops count 3, divided by 3 per stop.\n                        </p>\n                    </div>\n                </article>\n            </section>\n            <aside aria-label=\"Fleet utilization and model references\" class=\"support-rail\" data-kid=\"1-2-3-2\" data-name=\"support rail aside\">\n                <section class=\"panel\" data-kid=\"1-2-3-2-1\" data-name=\"fleet utilization panel\">\n                    <div class=\"panel-head\" data-kid=\"1-2-3-2-1-1\" data-name=\"panel header with title\">\n                        <div data-kid=\"1-2-3-2-1-1-1\" data-name=\"panel title block\">\n                            <h2 data-kid=\"1-2-3-2-1-1-1-1\" data-name=\"panel title heading\">\n                                Fleet utilization\n                            </h2>\n                            <p data-kid=\"1-2-3-2-1-1-1-2\" data-name=\"panel title subtitle\">\n                                Current milk volume against total capacity\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"panel-body\" data-kid=\"1-2-3-2-1-2\" data-name=\"panel body with utilization metrics\">\n                        <div class=\"util-top\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"utilization percentage header\">\n                            <div data-kid=\"1-2-3-2-1-2-1-1\" data-name=\"utilization percentage block\">\n                                <div class=\"summary-value tone-mint\" data-kid=\"1-2-3-2-1-2-1-1-1\" data-name=\"utilization percentage value\">\n                                    74.6\n                                    <small data-kid=\"1-2-3-2-1-2-1-1-1-1\" data-name=\"percentage symbol suffix\">\n                                        %\n                                    </small>\n                                </div>\n                                <span class=\"subtle-meta\" data-kid=\"1-2-3-2-1-2-1-1-2\" data-name=\"percentage label\">\n                                    Utilized\n                                </span>\n                            </div>\n                            <span class=\"subtle-meta\" data-kid=\"1-2-3-2-1-2-1-2\" data-name=\"demo round meta label\">\n                                Demo round\n                            </span>\n                        </div>\n                        <div aria-label=\"17,096 liters out of 22,917 liters, 74.6 percent capacity utilization\" class=\"util-track\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"utilization progress bar\" role=\"img\">\n                            <div class=\"util-fill\" data-kid=\"1-2-3-2-1-2-2-1\" data-name=\"utilization progress bar fill\">\n                            </div>\n                        </div>\n                        <div class=\"util-denom\" data-kid=\"1-2-3-2-1-2-3\" data-name=\"utilization volume labels row\">\n                            <span data-kid=\"1-2-3-2-1-2-3-1\" data-name=\"loaded volume label\">\n                                17,096 L loaded\n                            </span>\n                            <span data-kid=\"1-2-3-2-1-2-3-2\" data-name=\"total capacity label\">\n                                22,917 L capacity\n                            </span>\n                        </div>\n                        <div class=\"rail-stat-row\" data-kid=\"1-2-3-2-1-2-4\" data-name=\"available capacity stat row\">\n                            <span data-kid=\"1-2-3-2-1-2-4-1\" data-name=\"available capacity label\">\n                                Available capacity\n                            </span>\n                            <strong data-kid=\"1-2-3-2-1-2-4-2\" data-name=\"available capacity value\">\n                                5,821 L\n                            </strong>\n                        </div>\n                    </div>\n                </section>\n                <section class=\"panel\" data-kid=\"1-2-3-2-2\" data-name=\"adulteration thresholds panel\">\n                    <div class=\"panel-head\" data-kid=\"1-2-3-2-2-1\" data-name=\"panel header with title and badge\">\n                        <div data-kid=\"1-2-3-2-2-1-1\" data-name=\"panel title block\">\n                            <h2 data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"panel title heading\">\n                                Adulteration thresholds\n                            </h2>\n                            <p data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"panel title subtitle\">\n                                Current detection settings\n                            </p>\n                        </div>\n                        <span class=\"estimate-label\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"estimates badge with icon\">\n                            <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"info circle icon\">\n                            </i>\n                            Estimates\n                        </span>\n                    </div>\n                    <div class=\"panel-body\" data-kid=\"1-2-3-2-2-2\" data-name=\"panel body with threshold list\">\n                        <div class=\"threshold-list\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"threshold list container\">\n                            <div class=\"threshold-row\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"volume increase threshold row\">\n                                <div data-kid=\"1-2-3-2-2-2-1-1-1\" data-name=\"threshold name and description block\">\n                                    <div class=\"threshold-name\" data-kid=\"1-2-3-2-2-2-1-1-1-1\" data-name=\"threshold name\">\n                                        Volume increase\n                                    </div>\n                                    <div class=\"threshold-desc\" data-kid=\"1-2-3-2-2-2-1-1-1-2\" data-name=\"threshold description\">\n                                        Potential water addition\n                                    </div>\n                                </div>\n                                <div class=\"threshold-value\" data-kid=\"1-2-3-2-2-2-1-1-2\" data-name=\"threshold value\">\n                                    > +2.0%\n                                </div>\n                            </div>\n                            <div class=\"threshold-row\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"fat percentage drop threshold row\">\n                                <div data-kid=\"1-2-3-2-2-2-1-2-1\" data-name=\"threshold name and description block\">\n                                    <div class=\"threshold-name\" data-kid=\"1-2-3-2-2-2-1-2-1-1\" data-name=\"threshold name\">\n                                        Fat percentage drop\n                                    </div>\n                                    <div class=\"threshold-desc\" data-kid=\"1-2-3-2-2-2-1-2-1-2\" data-name=\"threshold description\">\n                                        Possible dilution or skimming\n                                    </div>\n                                </div>\n                                <div class=\"threshold-value\" data-kid=\"1-2-3-2-2-2-1-2-2\" data-name=\"threshold value\">\n                                    > 0.3%\n                                </div>\n                            </div>\n                            <div class=\"threshold-row\" data-kid=\"1-2-3-2-2-2-1-3\" data-name=\"SNF percentage drop threshold row\">\n                                <div data-kid=\"1-2-3-2-2-2-1-3-1\" data-name=\"threshold name and description block\">\n                                    <div class=\"threshold-name\" data-kid=\"1-2-3-2-2-2-1-3-1-1\" data-name=\"threshold name\">\n                                        SNF percentage drop\n                                    </div>\n                                    <div class=\"threshold-desc\" data-kid=\"1-2-3-2-2-2-1-3-1-2\" data-name=\"threshold description\">\n                                        Possible dilution\n                                    </div>\n                                </div>\n                                <div class=\"threshold-value\" data-kid=\"1-2-3-2-2-2-1-3-2\" data-name=\"threshold value\">\n                                    > 0.3%\n                                </div>\n                            </div>\n                            <div class=\"threshold-row\" data-kid=\"1-2-3-2-2-2-1-4\" data-name=\"density threshold row\">\n                                <div data-kid=\"1-2-3-2-2-2-1-4-1\" data-name=\"threshold name and description block\">\n                                    <div class=\"threshold-name\" data-kid=\"1-2-3-2-2-2-1-4-1-1\" data-name=\"threshold name\">\n                                        Density\n                                    </div>\n                                    <div class=\"threshold-desc\" data-kid=\"1-2-3-2-2-2-1-4-1-2\" data-name=\"threshold description\">\n                                        Possible contamination\n                                    </div>\n                                </div>\n                                <div class=\"threshold-value\" data-kid=\"1-2-3-2-2-2-1-4-2\" data-name=\"threshold value\">\n                                    < 1.026\n                                </div>\n                            </div>\n                        </div>\n                        <p class=\"model-caution\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"model caution note\">\n                            Detection limits are\n                            <strong data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"highlighted estimated settings phrase\">\n                                estimated settings\n                            </strong>\n                            from this demo model. A flag is not a confirmed finding.\n                        </p>\n                    </div>\n                </section>\n                <section class=\"panel\" data-kid=\"1-2-3-2-3\" data-name=\"TSB model reference panel\">\n                    <div class=\"panel-head\" data-kid=\"1-2-3-2-3-1\" data-name=\"panel header with title\">\n                        <div data-kid=\"1-2-3-2-3-1-1\" data-name=\"panel title block\">\n                            <h2 data-kid=\"1-2-3-2-3-1-1-1\" data-name=\"panel title heading\">\n                                TSB model reference\n                            </h2>\n                            <p data-kid=\"1-2-3-2-3-1-1-2\" data-name=\"panel title subtitle\">\n                                Estimated thermal safety buffer\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"panel-body\" data-kid=\"1-2-3-2-3-2\" data-name=\"panel body with formula and variables\">\n                        <p class=\"model-copy\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"TSB buffer description text\">\n                            The displayed buffer estimates remaining time before the modeled quality limit, minus time to reach cooling.\n                        </p>\n                        <div class=\"formula-box\" data-kid=\"1-2-3-2-3-2-2\" data-name=\"TSB formula display box\">\n                            TSB\n                            <sub data-kid=\"1-2-3-2-3-2-2-1\" data-name='formula subscript \"hours\"'>\n                                hours\n                            </sub>\n                            = (θ\n                            <sub data-kid=\"1-2-3-2-3-2-2-2\" data-name='formula subscript \"critical\"'>\n                                critical\n                            </sub>\n                            − (T\n                            <sub data-kid=\"1-2-3-2-3-2-2-3\" data-name='formula subscript \"initial\"'>\n                                initial\n                            </sub>\n                            − T\n                            <sub data-kid=\"1-2-3-2-3-2-2-4\" data-name='formula subscript \"base\"'>\n                                base\n                            </sub>\n                            )) / (k × (T\n                            <sub data-kid=\"1-2-3-2-3-2-2-5\" data-name='formula subscript \"ambient\"'>\n                                ambient\n                            </sub>\n                            − T\n                            <sub data-kid=\"1-2-3-2-3-2-2-6\" data-name='formula subscript \"base\"'>\n                                base\n                            </sub>\n                            ) × β\n                            <sub data-kid=\"1-2-3-2-3-2-2-7\" data-name='formula subscript \"insulation\"'>\n                                insulation\n                            </sub>\n                            )\n                        </div>\n                        <div class=\"formula-vars\" data-kid=\"1-2-3-2-3-2-3\" data-name=\"formula variable grid\">\n                            <div data-kid=\"1-2-3-2-3-2-3-1\" data-name=\"T base variable entry\">\n                                <strong data-kid=\"1-2-3-2-3-2-3-1-1\" data-name=\"variable symbol with subscript\">\n                                    T\n                                    <sub data-kid=\"1-2-3-2-3-2-3-1-1-1\" data-name='variable subscript \"base\"'>\n                                        base\n                                    </sub>\n                                </strong>\n                                · 4°C\n                            </div>\n                            <div data-kid=\"1-2-3-2-3-2-3-2\" data-name=\"k variable entry\">\n                                <strong data-kid=\"1-2-3-2-3-2-3-2-1\" data-name=\"variable symbol k\">\n                                    k\n                                </strong>\n                                · 0.15\n                            </div>\n                            <div data-kid=\"1-2-3-2-3-2-3-3\" data-name=\"theta critical variable entry\">\n                                <strong data-kid=\"1-2-3-2-3-2-3-3-1\" data-name=\"variable symbol with subscript\">\n                                    θ\n                                    <sub data-kid=\"1-2-3-2-3-2-3-3-1-1\" data-name='variable subscript \"critical\"'>\n                                        critical\n                                    </sub>\n                                </strong>\n                                · 850 degree-hours\n                            </div>\n                            <div data-kid=\"1-2-3-2-3-2-3-4\" data-name=\"beta variable entry\">\n                                <strong data-kid=\"1-2-3-2-3-2-3-4-1\" data-name=\"variable symbol beta\">\n                                    β\n                                </strong>\n                                · 0.4–1.0\n                            </div>\n                        </div>\n                        <p class=\"model-caution\" data-kid=\"1-2-3-2-3-2-4\" data-name=\"model caution note\">\n                            Model parameters and risk bands are\n                            <strong data-kid=\"1-2-3-2-3-2-4-1\" data-name=\"highlighted estimates phrase\">\n                                estimates\n                            </strong>\n                            in this MVP, not certified safety limits.\n                        </p>\n                    </div>\n                </section>\n            </aside>\n        </div>\n    </main>\n</div>\n",
