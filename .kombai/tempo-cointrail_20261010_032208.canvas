      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.route-page {\n  --canvas: #0c0f0e;\n  --surface: #121614;\n  --surface-raised: #171c19;\n  --surface-soft: #1b211e;\n  --ink: #f1f5f2;\n  --muted: #a0aba4;\n  --quiet: #737e77;\n  --edge: #2b332e;\n  --edge-soft: #222a25;\n  --mint: #58dfbb;\n  --mint-dim: #173c32;\n  --warning: #f0c35a;\n  --warning-dim: #392f1c;\n  --critical: #ff7180;\n  --critical-dim: #3b2226;\n  --neutral: #85928a;\n  min-height: 100vh;\n  background: var(--canvas);\n  color: var(--ink);\n  font: 15px/1.45 'DM Sans', sans-serif;\n  letter-spacing: 0;\n  box-sizing: border-box;\n}\n.route-page *, .route-page *::before, .route-page *::after { box-sizing: inherit; }\n.route-page h1,.route-page h2,.route-page h3,.route-page p { margin: 0; }\n.route-page button,.route-page select { font: inherit; color: inherit; }\n.route-page button { cursor: pointer; }\n.route-page button:focus-visible,.route-page a:focus-visible,.route-page select:focus-visible { outline: 3px solid var(--mint); outline-offset: 3px; }\n.route-page .mono { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n.app-bar { min-height: 72px; border-bottom: 1px solid var(--edge-soft); display: flex; align-items: center; gap: 36px; padding: 0 42px; background: var(--canvas); }\n.brand { display: flex; align-items: center; gap: 11px; color: var(--ink); font-weight: 700; font-size: 17px; letter-spacing: .01em; white-space: nowrap; }\n.brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--mint); color: #09251e; font-size: 16px; font-weight: 700; }\n.brand-mark .ti { font-size: 18px; width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; color: #09251e; }\n.app-nav { height: 72px; display: flex; align-items: stretch; gap: 7px; flex: 1; }\n.nav-link { min-width: 98px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 0 14px; color: var(--muted); text-decoration: none; font-size: 14px; font-weight: 500; border-bottom: 2px solid transparent; }\n.nav-link:hover { color: var(--ink); background: var(--surface); }\n.nav-link[aria-current=\"page\"] { color: var(--ink); border-bottom-color: var(--mint); }\n.nav-link[aria-current=\"page\"] .ti { color: var(--mint); }\n.nav-link .ti,.bar-actions .ti { width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; color: var(--muted); }\n.bar-actions { margin-left: auto; display: flex; align-items: center; gap: 15px; white-space: nowrap; }\n.connection-state { display: inline-flex; align-items: center; gap: 9px; padding-left: 16px; border-left: 1px solid var(--edge); color: var(--muted); font-size: 13px; }\n.state-dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--critical); }\n.menu-toggle { display: none; width: 44px; height: 44px; border: 1px solid var(--edge); background: var(--surface); border-radius: 10px; }\n.page-content { max-width: 1480px; margin: 0 auto; padding: 28px 42px 44px; }\n.page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 20px; }\n.page-heading h1 { font-size: 28px; line-height: 1.15; font-weight: 600; letter-spacing: -.035em; }\n.page-heading p { color: var(--muted); margin-top: 6px; font-size: 14px; }\n.demo-flag { display: inline-flex; align-items: center; gap: 9px; padding: 9px 12px; color: var(--warning); border: 1px solid #594a2c; border-radius: 8px; background: var(--warning-dim); font-size: 12px; font-weight: 600; letter-spacing: .01em; white-space: nowrap; }\n.demo-flag .ti { width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; color: var(--warning); }\n.route-identity { display: flex; justify-content: space-between; align-items: center; gap: 22px; min-height: 84px; padding: 16px 20px; background: var(--surface); border: 1px solid var(--edge); border-radius: 12px; margin-bottom: 15px; }\n.vehicle-select { display: flex; align-items: center; gap: 14px; min-width: 245px; }\n.vehicle-glyph { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 10px; color: var(--mint); background: var(--mint-dim); }\n.vehicle-glyph .ti { width: 21px; height: 21px; display: inline-flex; align-items: center; justify-content: center; font-size: 21px; color: var(--mint); }\n.vehicle-name { font-size: 16px; font-weight: 600; }\n.vehicle-id { color: var(--muted); font-size: 12px; margin-top: 3px; }\n.vehicle-switch { background: transparent; border: 0; padding: 7px; display: grid; place-items: center; border-radius: 6px; }\n.vehicle-switch:hover { background: var(--surface-soft); }\n.vehicle-switch .ti { width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; color: var(--muted); }\n.route-stats { display: flex; align-items: center; gap: 0; margin-left: auto; }\n.stat { padding: 0 24px; min-width: 140px; border-left: 1px solid var(--edge-soft); }\n.stat:first-child { border-left: 0; }\n.stat-label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 5px; }\n.stat-value { font: 500 15px/1.25 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n.stat-value em { font: 400 12px 'DM Sans', sans-serif; color: var(--muted); font-style: normal; }\n.status-text { display: inline-flex; align-items: center; gap: 7px; color: var(--mint); font-size: 13px; font-weight: 600; }\n.status-text::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--mint); }\n.next-stop-banner { display: flex; align-items: center; gap: 14px; min-height: 72px; padding: 14px 18px; border: 1px solid #4e4329; background: #211d14; border-radius: 10px; margin-bottom: 18px; }\n.next-symbol { width: 36px; height: 36px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 9px; background: var(--warning-dim); color: var(--warning); }\n.next-symbol .ti { width: 19px; height: 19px; display: inline-flex; align-items: center; justify-content: center; font-size: 19px; color: var(--warning); }\n.next-copy { flex: 1; min-width: 0; }\n.next-title { font-weight: 600; font-size: 15px; }\n.next-subtitle { font-size: 13px; color: var(--muted); margin-top: 3px; }\n.next-detail { border-left: 1px solid #54472b; padding-left: 18px; text-align: right; }\n.next-detail .detail-label { display: block; color: var(--muted); font-size: 12px; margin-bottom: 3px; }\n.next-detail .detail-value { color: var(--warning); font: 500 15px 'IBM Plex Mono', monospace; }\n.next-chevron { width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; color: var(--quiet); }\n.route-layout { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 18px; align-items: start; }\n.route-column,.context-column { min-width: 0; }\n.route-panel,.map-panel,.preview-panel,.model-note { background: var(--surface); border: 1px solid var(--edge); border-radius: 12px; }\n.route-panel { overflow: hidden; }\n.panel-heading { min-height: 61px; padding: 14px 18px; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--edge-soft); }\n.panel-title { font-size: 15px; font-weight: 600; }\n.panel-subtitle { color: var(--muted); font-size: 12px; margin-top: 3px; }\n.panel-count { color: var(--muted); font: 12px 'IBM Plex Mono', monospace; white-space: nowrap; }\n.table-scroll { overflow-x: auto; }\n.route-table { width: 100%; min-width: 875px; border-collapse: collapse; font-size: 13px; }\n.route-table th { height: 44px; padding: 0 12px; color: var(--muted); text-align: left; font-weight: 500; font-size: 12px; white-space: nowrap; background: #101412; border-bottom: 1px solid var(--edge-soft); }\n.route-table td { height: 70px; padding: 10px 12px; border-bottom: 1px solid var(--edge-soft); vertical-align: middle; color: #dce3de; white-space: nowrap; }\n.route-table tr:last-child td { border-bottom: 0; }\n.route-table th:first-child,.route-table td:first-child { position: sticky; left: 0; z-index: 2; background: var(--surface); }\n.route-table th:first-child { z-index: 3; background: #101412; }\n.route-table .selected-row td { background: #211d14; }\n.route-table .selected-row td:first-child { background: #211d14; }\n.route-table .urgent-row td { background: #211518; }\n.route-table .urgent-row td:first-child { background: #211518; }\n.seq-wrap { display: flex; align-items: center; gap: 11px; min-width: 155px; }\n.seq-number { width: 28px; height: 28px; display: grid; place-items: center; flex: 0 0 auto; border: 1px solid var(--edge); border-radius: 8px; color: var(--muted); font: 500 12px 'IBM Plex Mono', monospace; }\n.seq-number.complete { border-color: #2b6957; background: var(--mint-dim); color: var(--mint); }\n.seq-number.current { border-color: #7d642d; background: var(--warning-dim); color: var(--warning); }\n.seq-number.critical { border-color: #794047; background: var(--critical-dim); color: var(--critical); }\n.stop-name { font-weight: 600; color: var(--ink); }\n.stop-id { color: var(--muted); font: 11px 'IBM Plex Mono', monospace; margin-top: 3px; }\n.row-label { display: inline-block; margin-left: 7px; color: var(--warning); font-size: 11px; font-weight: 600; }\n.row-label.red { color: var(--critical); }\n.value-muted { color: var(--quiet); }\n.arrival { font-family: 'IBM Plex Mono', monospace; font-variant-numeric: tabular-nums; }\n.arrival.actual { color: var(--mint); }\n.risk-label { display: inline-flex; align-items: center; gap: 7px; color: var(--muted); }\n.risk-dot { width: 7px; height: 7px; border-radius: 50%; display: inline-block; background: var(--mint); }\n.risk-dot.warning { background: var(--warning); }\n.risk-dot.critical { background: var(--critical); }\n.risk-text { font-size: 12px; font-weight: 600; }\n.risk-text.good { color: var(--mint); }\n.risk-text.warn { color: var(--warning); }\n.risk-text.bad { color: var(--critical); }\n.row-action { height: 36px; padding: 0 11px; border: 1px solid #714149; color: var(--critical); background: transparent; border-radius: 7px; font-size: 12px; font-weight: 600; }\n.row-action:hover { background: var(--critical-dim); }\n.row-action .ti { width: 15px; height: 15px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; color: var(--critical); margin-right: 4px; vertical-align: -2px; }\n.table-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 17px; border-top: 1px solid var(--edge-soft); color: var(--muted); font-size: 12px; }\n.table-foot strong { color: var(--ink); font-weight: 500; }\n.table-scroll-hint { display: none; }\n.preview-panel { margin-top: 16px; padding: 17px 18px; border-color: #4e4329; background: #181711; }\n.preview-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }\n.preview-title { font-size: 14px; font-weight: 600; }\n.simulated-chip { display: inline-flex; align-items: center; gap: 6px; color: var(--warning); font-size: 11px; font-weight: 700; letter-spacing: .02em; }\n.simulated-chip .ti { width: 14px; height: 14px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; color: var(--warning); }\n.preview-path { display: flex; align-items: flex-start; gap: 12px; color: var(--ink); font-size: 13px; }\n.preview-path .ti { width: 17px; height: 17px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; color: var(--warning); margin-top: 1px; }\n.preview-reason { color: var(--muted); font-size: 12px; margin-top: 4px; }\n.preview-metrics { display: flex; align-items: center; gap: 25px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #3b3523; }\n.preview-metric { display: flex; align-items: baseline; gap: 7px; }\n.preview-metric span:first-child { color: var(--muted); font-size: 12px; }\n.preview-metric strong { color: var(--warning); font: 500 13px 'IBM Plex Mono', monospace; }\n.preview-not-applied { margin-left: auto; color: var(--quiet); font-size: 11px; }\n.map-panel { overflow: hidden; }\n.map-head { padding: 15px 16px 12px; display: flex; align-items: center; justify-content: space-between; }\n.map-head h2 { font-size: 14px; font-weight: 600; }\n.map-zoom { color: var(--muted); font-size: 12px; }\n.map-visual { height: 213px; position: relative; overflow: hidden; border-top: 1px solid var(--edge-soft); border-bottom: 1px solid var(--edge-soft); background-color: #101714; background-image: linear-gradient(37deg, transparent 46%, #27312c 47%, #27312c 48%, transparent 49%),linear-gradient(142deg, transparent 45%, #202b26 46%, #202b26 47%, transparent 48%),linear-gradient(90deg, transparent 28%, #1e2924 28.4%, transparent 29%, transparent 72%, #1e2924 72.4%, transparent 73%),linear-gradient(0deg, transparent 25%, #1e2924 25.4%, transparent 26%, transparent 69%, #1e2924 69.4%, transparent 70%); background-size: 250px 180px, 240px 200px, 100% 100%, 100% 100%; }\n.map-visual::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(#526159 1px, transparent 1px); background-size: 23px 23px; opacity: .18; pointer-events: none; }\n.route-map-svg { position: absolute; inset: 8px 0; width: 100%; height: calc(100% - 16px); z-index: 1; }\n.map-label { position: absolute; z-index: 2; color: #9eaca3; font-size: 11px; background: #101714d9; padding: 2px 5px; border-radius: 3px; }\n.map-label.anand { left: 17px; top: 14px; }\n.map-label.route-end { right: 14px; bottom: 18px; }\n.map-key { display: flex; flex-wrap: wrap; gap: 10px 16px; padding: 12px 15px 14px; }\n.map-key-item { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: var(--muted); }\n.key-marker { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); }\n.key-marker.next { background: var(--warning); }\n.key-marker.critical { background: var(--critical); }\n.key-marker.bmc { width: 8px; height: 8px; border-radius: 2px; background: #d7e1da; }\n.context-summary { padding: 16px; border-top: 1px solid var(--edge-soft); }\n.context-summary h3 { font-size: 13px; font-weight: 600; margin-bottom: 9px; }\n.context-line { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 6px 0; color: var(--muted); font-size: 12px; }\n.context-line strong { color: var(--ink); font: 500 12px 'IBM Plex Mono', monospace; }\n.model-note { margin-top: 14px; padding: 15px 16px; }\n.model-note h3 { font-size: 13px; font-weight: 600; margin-bottom: 7px; }\n.model-note p { color: var(--muted); font-size: 12px; line-height: 1.55; }\n.model-bands { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-top: 10px; }\n.band { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font: 11px 'IBM Plex Mono', monospace; }\n.band .risk-dot { width: 6px; height: 6px; }\n.model-caption { margin-top: 9px; padding-top: 9px; border-top: 1px solid var(--edge-soft); color: var(--quiet); font-size: 11px; }\n@media (max-width: 1080px) {\n  .app-bar { padding: 0 24px; gap: 20px; }\n  .page-content { padding: 24px; }\n  .route-layout { grid-template-columns: minmax(0,1fr) 290px; gap: 14px; }\n  .stat { min-width: 120px; padding: 0 16px; }\n}\n@media (max-width: 760px) {\n  .app-bar { min-height: 64px; padding: 0 16px; gap: 12px; flex-wrap: wrap; }\n  .brand { font-size: 16px; }\n  .brand-mark { width: 32px; height: 32px; }\n  .menu-toggle { display: grid; place-items: center; margin-left: auto; }\n  .menu-toggle .ti { width: 18px; height: 18px; display: inline-flex; align-items: center; justify-content: center; color: var(--ink); font-size: 18px; }\n  .bar-actions { margin-left: 0; }\n  .connection-state { font-size: 12px; padding-left: 10px; }\n  .app-nav { order: 3; flex-basis: 100%; height: 48px; overflow-x: auto; gap: 0; border-top: 1px solid var(--edge-soft); scrollbar-width: none; }\n  .app-nav::-webkit-scrollbar { display: none; }\n  .nav-link { min-width: auto; flex: 1 0 auto; gap: 7px; padding: 0 12px; font-size: 13px; }\n  .page-content { padding: 22px 16px 34px; }\n  .page-heading { align-items: flex-start; margin-bottom: 15px; gap: 12px; }\n  .page-heading h1 { font-size: 24px; }\n  .page-heading p { max-width: 310px; font-size: 13px; }\n  .demo-flag { padding: 7px 9px; font-size: 10px; }\n  .route-identity { display: block; padding: 14px; margin-bottom: 12px; }\n  .vehicle-select { min-width: 0; }\n  .route-stats { margin: 13px -14px -14px; padding: 11px 0; border-top: 1px solid var(--edge-soft); }\n  .stat { flex: 1; min-width: 0; padding: 0 10px; }\n  .stat-label { font-size: 11px; }\n  .stat-value { font-size: 13px; }\n  .status-text { margin-left: auto; font-size: 12px; }\n  .next-stop-banner { gap: 10px; padding: 12px; margin-bottom: 13px; }\n  .next-title { font-size: 14px; }\n  .next-subtitle { font-size: 12px; }\n  .next-detail { padding-left: 10px; }\n  .next-detail .detail-label { font-size: 11px; }\n  .next-detail .detail-value { font-size: 13px; }\n  .route-layout { grid-template-columns: minmax(0,1fr); gap: 14px; }\n  .route-column { order: 1; }\n  .context-column { order: 2; }\n  .panel-heading { padding: 13px 14px; }\n  .table-scroll-hint { display: block; padding: 9px 13px; color: var(--muted); border-bottom: 1px solid var(--edge-soft); font-size: 11px; }\n  .table-scroll-hint .ti { width: 14px; height: 14px; display: inline-flex; align-items: center; justify-content: center; color: var(--mint); font-size: 14px; margin-right: 5px; vertical-align: -2px; }\n  .route-table { min-width: 880px; }\n  .route-table th:first-child,.route-table td:first-child { left: 0; }\n  .table-foot { align-items: flex-start; flex-direction: column; gap: 4px; }\n  .preview-panel { padding: 14px; }\n  .preview-metrics { flex-wrap: wrap; gap: 9px 18px; }\n  .preview-not-applied { flex-basis: 100%; margin-left: 0; }\n  .map-visual { height: 200px; }\n  .model-note { margin-top: 12px; }\n}\n@media (max-width: 430px) {\n  .bar-actions .connection-state { max-width: 130px; white-space: normal; line-height: 1.25; }\n  .page-heading { flex-direction: column; }\n  .demo-flag { align-self: flex-start; }\n  .route-stats { justify-content: space-between; }\n  .stat { padding: 0 7px; }\n  .status-text { display: none; }\n  .next-symbol { width: 32px; height: 32px; }\n  .next-detail { max-width: 112px; }\n}\n</style>\n<div class=\"route-page\" data-kid=\"1\" data-name=\"route management page container\">\n    <header class=\"app-bar\" data-kid=\"1-1\" data-name=\"top app bar\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo group\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand mark tile\">\n                <i aria-hidden=\"true\" class=\"ti ti-droplet\" data-kid=\"1-1-1-1-1\" data-name=\"droplet brand icon\">\n                </i>\n            </div>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                T.E.M.P.O.\n            </span>\n        </div>\n        <nav aria-label=\"Primary navigation\" class=\"app-nav\" data-kid=\"1-1-2\" data-name=\"primary navigation bar\">\n            <a class=\"nav-link\" data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"#dashboard\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard nav icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"dashboard nav label\">\n                    Dashboard\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-link\" data-kid=\"1-1-2-2\" data-name=\"routes nav link (active)\" href=\"#routes\">\n                <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-2-1\" data-name=\"routes nav icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"routes nav label\">\n                    Routes\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-3\" data-name=\"alerts nav link\" href=\"#alerts\">\n                <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-1-2-3-1\" data-name=\"alerts nav icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"alerts nav label\">\n                    Alerts\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-4\" data-name=\"analytics nav link\" href=\"#analytics\">\n                <i aria-hidden=\"true\" class=\"ti ti-chart-bar\" data-kid=\"1-1-2-4-1\" data-name=\"analytics nav icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"analytics nav label\">\n                    Analytics\n                </span>\n            </a>\n        </nav>\n        <div class=\"bar-actions\" data-kid=\"1-1-3\" data-name=\"app bar action cluster\">\n            <div class=\"connection-state\" data-kid=\"1-1-3-1\" data-name=\"connection status indicator\">\n                <span aria-hidden=\"true\" class=\"state-dot\" data-kid=\"1-1-3-1-1\" data-name=\"connection status dot\">\n                </span>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"connection status text\">\n                    Data source unavailable\n                </span>\n            </div>\n            <button aria-label=\"Open navigation\" class=\"menu-toggle\" data-kid=\"1-1-3-2\" data-name=\"mobile menu toggle button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-menu-2\" data-kid=\"1-1-3-2-1\" data-name=\"menu hamburger icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main class=\"page-content\" data-kid=\"1-2\" data-name=\"main page content\">\n        <div class=\"page-heading\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page heading text group\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page title\">\n                    Route management\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page subtitle\">\n                    Review each collection stop and its estimated thermal buffer.\n                </p>\n            </div>\n            <div class=\"demo-flag\" data-kid=\"1-2-1-2\" data-name=\"demo scenario flag badge\">\n                <i aria-hidden=\"true\" class=\"ti ti-flask-2\" data-kid=\"1-2-1-2-1\" data-name=\"flask demo icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"demo flag label text\">\n                    Demo scenario · not live\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Selected vehicle and route\" class=\"route-identity\" data-kid=\"1-2-2\" data-name=\"selected vehicle and route bar\">\n            <div class=\"vehicle-select\" data-kid=\"1-2-2-1\" data-name=\"vehicle selection group\">\n                <div class=\"vehicle-glyph\" data-kid=\"1-2-2-1-1\" data-name=\"vehicle glyph tile\">\n                    <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-2-1-1-1\" data-name=\"truck vehicle icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-2-1-2\" data-name=\"vehicle identity text group\">\n                    <div class=\"vehicle-name\" data-kid=\"1-2-2-1-2-1\" data-name=\"vehicle name\">\n                        Tanker 2\n                    </div>\n                    <div class=\"vehicle-id\" data-kid=\"1-2-2-1-2-2\" data-name=\"vehicle id and role tag\">\n                        VEH-002 · collection round\n                    </div>\n                </div>\n                <button aria-label=\"Change selected vehicle\" class=\"vehicle-switch\" data-kid=\"1-2-2-1-3\" data-name=\"change vehicle button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-down\" data-kid=\"1-2-2-1-3-1\" data-name=\"chevron down switch icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"route-stats\" data-kid=\"1-2-2-2\" data-name=\"route key stats strip\">\n                <div class=\"stat\" data-kid=\"1-2-2-2-1\" data-name=\"current load stat\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-2-1-1\" data-name=\"current load stat label\">\n                        Current load\n                    </span>\n                    <span class=\"stat-value\" data-kid=\"1-2-2-2-1-2\" data-name=\"current load stat value\">\n                        4,820\n                        <em data-kid=\"1-2-2-2-1-2-1\" data-name=\"current load capacity unit\">\n                            / 7,500 L\n                        </em>\n                    </span>\n                </div>\n                <div class=\"stat\" data-kid=\"1-2-2-2-2\" data-name=\"stops on route stat\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-2-2-1\" data-name=\"stops stat label\">\n                        Stops on route\n                    </span>\n                    <span class=\"stat-value\" data-kid=\"1-2-2-2-2-2\" data-name=\"stops stat value\">\n                        4\n                    </span>\n                </div>\n                <div class=\"stat\" data-kid=\"1-2-2-2-3\" data-name=\"vehicle status stat\">\n                    <span class=\"stat-label\" data-kid=\"1-2-2-2-3-1\" data-name=\"vehicle status label\">\n                        Vehicle status\n                    </span>\n                    <span class=\"status-text\" data-kid=\"1-2-2-2-3-2\" data-name=\"vehicle status value\