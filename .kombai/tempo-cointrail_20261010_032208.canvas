8v37H20z\">\n                                </path>\n                                <path d=\"M395 39h103v36H395z\">\n                                </path>\n                                <path d=\"M21 263h83v40H21z\">\n                                </path>\n                                <path d=\"M416 272h79v43h-79z\">\n                                </path>\n                            </g>\n                            <g fill=\"#8d9992\" font-family=\"DM Sans,sans-serif\" font-size=\"10\" letter-spacing=\".3\">\n                                <text x=\"31\" y=\"41\">\n                                    NORTH COLLECTION LOOP\n                                </text>\n                                <text x=\"407\" y=\"61\">\n                                    RURAL LINK ROAD\n                                </text>\n                                <text x=\"31\" y=\"287\">\n                                    PUNE OUTER ROUTE\n                                </text>\n                                <text x=\"427\" y=\"296\">\n                                    DEPOT APPROACH\n                                </text>\n                                <text fill=\"#abb5af\" font-size=\"12\" x=\"231\" y=\"189\">\n                                    Pune · sample area\n                                </text>\n                                <text fill=\"#89958e\" font-size=\"9\" x=\"18\" y=\"327\">\n                                    SCHEMATIC ROUTE · NOT TO SCALE\n                                </text>\n                            </g>\n                            <g dominant-baseline=\"central\" font-family=\"DM Mono,monospace\" font-size=\"10\" font-weight=\"500\" id=\"map-stops\" text-anchor=\"middle\">\n                                <g aria-label=\"Select stop 1, Village collection center A\" class=\"map-stop is-current\" data-map-stop=\"s1\" onclick=\"window.tempoSelectStop&&window.tempoSelectStop('s1',false)\" role=\"button\" tabindex=\"0\">\n                                    <circle cx=\"95\" cy=\"104\" fill=\"#ff7180\" r=\"16\" stroke=\"#54252d\" stroke-width=\"5\">\n                                    </circle>\n                                    <circle cx=\"95\" cy=\"104\" fill=\"#ff7180\" r=\"10\">\n                                    </circle>\n                                    <text fill=\"#2a0e12\" x=\"95\" y=\"104\">\n                                        01\n                                    </text>\n                                </g>\n                                <g aria-label=\"Select stop 2, Village collection center B\" class=\"map-stop\" data-map-stop=\"s2\" onclick=\"window.tempoSelectStop&&window.tempoSelectStop('s2',false)\" role=\"button\" tabindex=\"0\">\n                                    <circle cx=\"198\" cy=\"97\" fill=\"#4ce0bc\" r=\"12\" stroke=\"#183e34\" stroke-width=\"4\">\n                                    </circle>\n                                    <text fill=\"#082018\" x=\"198\" y=\"97\">\n                                        02\n                                    </text>\n                                </g>\n                                <g aria-label=\"Select stop 3, Village collection center C\" class=\"map-stop\" data-map-stop=\"s3\" onclick=\"window.tempoSelectStop&&window.tempoSelectStop('s3',false)\" role=\"button\" tabindex=\"0\">\n                                    <circle cx=\"300\" cy=\"153\" fill=\"#4ce0bc\" r=\"12\" stroke=\"#183e34\" stroke-width=\"4\">\n                                    </circle>\n                                    <text fill=\"#082018\" x=\"300\" y=\"153\">\n                                        03\n                                    </text>\n                                </g>\n                                <g aria-label=\"Select sample BMC destination\" class=\"map-stop\" data-map-stop=\"s4\" onclick=\"window.tempoSelectStop&&window.tempoSelectStop('s4',false)\" role=\"button\" tabindex=\"0\">\n                                    <rect fill=\"#f0bd5b\" height=\"28\" rx=\"7\" stroke=\"#5c4722\" stroke-width=\"4\" transform=\"rotate(45 432 221)\" width=\"28\" x=\"418\" y=\"207\">\n                                    </rect>\n                                    <text fill=\"#211909\" x=\"432\" y=\"221\">\n                                        B\n                                    </text>\n                                </g>\n                            </g>\n                            <g id=\"map-car\" transform=\"translate(290 160)\">\n                                <circle fill=\"#0d1512\" r=\"8\" stroke=\"#dffef3\" stroke-width=\"2\">\n                                </circle>\n                                <path d=\"M-3-2h6l2 5h-10z\" fill=\"#4ce0bc\">\n                                </path>\n                            </g>\n                        </svg>\n                        <div aria-label=\"Map controls\" class=\"map-zoom-fallback\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"map zoom controls\">\n                            <button aria-label=\"Zoom in\" data-kid=\"1-2-3-2-1-2-2-1\" data-name=\"zoom in\" onclick=\"window.tempoMapZoom&&window.tempoMapZoom(1)\" type=\"button\">\n                                +\n                            </button>\n                            <button aria-label=\"Zoom out\" data-kid=\"1-2-3-2-1-2-2-2\" data-name=\"zoom out\" onclick=\"window.tempoMapZoom&&window.tempoMapZoom(-1)\" type=\"button\">\n                                −\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-[var(--line)] px-4 py-[11px] text-[11px] text-[var(--muted)]\" data-kid=\"1-2-3-2-1-3\" data-name=\"map legend row\">\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-3-2-1-3-1\" data-name=\"legend item: collection stop\">\n                            <i class=\"legend-dot bg-[var(--mint)]\" data-kid=\"1-2-3-2-1-3-1-1\" data-name=\"legend dot for collection stop\">\n                            </i>\n                            Collection stop\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-3-2-1-3-2\" data-name=\"legend item: selected critical stop\">\n                            <i class=\"legend-dot bg-[var(--red)]\" data-kid=\"1-2-3-2-1-3-2-1\" data-name=\"legend dot for critical stop\">\n                            </i>\n                            Selected / critical\n                        </span>\n                        <span class=\"inline-flex items-center gap-2\" data-kid=\"1-2-3-2-1-3-3\" data-name=\"legend item: BMC destination\">\n                            <span class=\"inline-block h-[9px] w-[9px] rotate-45 rounded-[2px] bg-[var(--amber)]\" data-kid=\"1-2-3-2-1-3-3-1\" data-name=\"legend diamond for destination\">\n                            </span>\n                            BMC destination\n                        </span>\n                    </div>\n                </section>\n                <section aria-labelledby=\"alerts-title\" class=\"panel px-4 pt-[15px] pb-2\" data-kid=\"1-2-3-2-2\" data-name=\"recent alerts panel\">\n                    <div class=\"flex items-center justify-between gap-3 border-b border-[var(--line)] pb-[12px]\" data-kid=\"1-2-3-2-2-1\" data-name=\"alerts panel header row\">\n                        <div data-kid=\"1-2-3-2-2-1-1\" data-name=\"alerts title and description\">\n                            <h2 class=\"m-0 text-[15px] font-semibold\" data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"alerts panel title text\" id=\"alerts-title\">\n                                Recent alerts\n                            </h2>\n                            <p class=\"mt-1 mb-0 text-[11px] text-[var(--muted)]\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"alerts count subtitle text\">\n                                2 illustrative records · not live\n                            </p>\n                        </div>\n                        <a class=\"focusable rounded-[7px] px-2 py-1 text-[12px] font-semibold text-[var(--mint)] no-underline\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"view all alerts link\" href=\"#alerts\">\n                            View all\n                            <span aria-hidden=\"true\" data-kid=\"1-2-3-2-2-1-2-1\" data-name=\"view all arrow character\">\n                                →\n                            </span>\n                        </a>\n                    </div>\n                    <div class=\"alert-line\" data-kid=\"1-2-3-2-2-2\" data-name=\"critical alert row\">\n                        <span class=\"mt-[6px] h-[8px] w-[8px] rounded-full bg-[var(--red)]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"critical alert severity dot\">\n                        </span>\n                        <div data-kid=\"1-2-3-2-2-2-2\" data-name=\"critical alert content\">\n                            <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"critical alert title and severity row\">\n                                <strong class=\"text-[13px] font-semibold text-[var(--text)]\" data-kid=\"1-2-3-2-2-2-2-1-1\" data-name=\"critical alert title text\">\n                                    Thermal buffer below threshold\n                                </strong>\n                                <span class=\"text-[10px] font-bold uppercase tracking-[.05em] text-[var(--red)]\" data-kid=\"1-2-3-2-2-2-2-1-2\" data-name=\"critical alert severity tag\">\n                                    Critical\n                                </span>\n                            </div>\n                            <div class=\"mt-1 text-[12px] leading-[1.45] text-[var(--muted)]\" data-kid=\"1-2-3-2-2-2-2-2\" data-name=\"critical alert description text\">\n                                Tanker 01 · Village collection center A · modeled TSB 0.4 h\n                            </div>\n                            <button class=\"focusable mt-2 rounded-[6px] border border-[var(--line)] bg-[var(--surface-raised)] px-2.5 py-1 text-[11px] font-semibold text-[var(--text)] hover:border-[#68756f]\" data-kid=\"1-2-3-2-2-2-2-3\" data-name=\"acknowledge alert button\" type=\"button\">\n                                Acknowledge alert\n                            </button>\n                        </div>\n                        <span class=\"mono text-[10px] text-[var(--quiet)]\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"demo alert badge text\">\n                            DEMO\n                        </span>\n                    </div>\n                    <div class=\"alert-line\" data-kid=\"1-2-3-2-2-3\" data-name=\"warning alert row\">\n                        <span class=\"mt-[6px] h-[8px] w-[8px] rounded-full bg-[var(--amber)]\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"warning alert severity dot\">\n                        </span>\n                        <div data-kid=\"1-2-3-2-2-3-2\" data-name=\"warning alert content\">\n                            <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-3-2-2-3-2-1\" data-name=\"warning alert title and severity row\">\n                                <strong class=\"text-[13px] font-semibold text-[var(--text)]\" data-kid=\"1-2-3-2-2-3-2-1-1\" data-name=\"warning alert title text\">\n                                    Collection route needs review\n                                </strong>\n                                <span class=\"text-[10px] font-bold uppercase tracking-[.05em] text-[var(--amber)]\" data-kid=\"1-2-3-2-2-3-2-1-2\" data-name=\"warning alert severity tag\">\n                                    Warning\n                                </span>\n                            </div>\n                            <div class=\"mt-1 text-[12px] leading-[1.45] text-[var(--muted)]\" data-kid=\"1-2-3-2-2-3-2-2\" data-name=\"warning alert description text\">\n                                Tanker 02 · A stop is in the modeled elevated-risk band\n                            </div>\n                        </div>\n                        <span class=\"mono text-[10px] text-[var(--quiet)]\" data-kid=\"1-2-3-2-2-3-3\" data-name=\"demo alert badge text\">\n                            DEMO\n                        </span>\n                    </div>\n                    <div class=\"flex items-start gap-2 border-t border-[var(--line)] py-[10px] text-[11px] leading-[1.45] text-[var(--quiet)]\" data-kid=\"1-2-3-2-2-4\" data-name=\"alerts disclaimer footer note\">\n                        <i class=\"ti ti-info-circle mt-px text-[14px]\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"alert info icon\" style=\"width:15px;height:15px;color:var(--quiet)\">\n                        </i>\n                        Sample alert text illustrates layout; it is not a live incident feed.\n                    </div>\n                </section>\n                <div class=\"flex items-start gap-2 rounded-[10px] border border-[#373123] bg-[#19160f] px-3 py-[11px] text-[11px] leading-[1.45] text-[#cbbd9f]\" data-kid=\"1-2-3-2-3\" data-name=\"thermal thresholds caution banner\">\n                    <i class=\"ti ti-alert-circle mt-px text-[15px]\" data-kid=\"1-2-3-2-3-1\" data-name=\"alert circle caution icon\" style=\"width:16px;height:16px;color:var(--amber)\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-3-2\" data-name=\"caution banner text\">\n                        Thermal thresholds are estimates in this prototype. Confirm against measured cooperative data before operational use.\n                    </span>\n                </div>\n            </aside>\n        </div>\n        <footer class=\"mt-7 flex flex-wrap items-center justify-between gap-3 border-t border-[var(--line)] pt-4 text-[11px] text-[var(--quiet)]\" data-kid=\"1-2-4\" data-name=\"dashboard footer\">\n            <span data-kid=\"1-2-4-1\" data-name=\"footer product name and tagline\">\n                T.E.M.P.O. · Thermal Estimation & Milk Procurement Optimizer\n            </span>\n            <span data-kid=\"1-2-4-2\" data-name=\"footer demo state note\">\n                Illustrative demo state · no live observations or timestamps shown\n            </span>\n        </footer>\n    </main>\n</div>\n<script>\n    (function(){\n  const ids=['s1','s2','s3','s4'];let zoom=1;\n  window.tempoSelectStop=function(id){\n    document.querySelectorAll('.stop-row').forEach(row=>{const selected=row.dataset.stop===id;row.classList.toggle('selected',selected);row.setAttribute('aria-pressed',String(selected));});\n    document.querySelectorAll('.map-stop').forEach(marker=>{const selected=marker.dataset.mapStop===id;marker.classList.toggle('selected',selected);});\n  };\n  window.tempoMapZoom=function(direction){zoom=Math.max(1,Math.min(1.6,zoom+(direction>0?.1:-.1)));const svg=document.getElementById('tempo-map');if(svg)svg.style.transform='scale('+zoom+')';};\n  document.querySelectorAll('.stop-row').forEach(row=>row.addEventListener('click',()=>window.tempoSelectStop(row.dataset.stop)));\n  document.querySelectorAll('.map-stop').forEach(marker=>marker.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();window.tempoSelectStop(marker.dataset.mapStop);}}));\n})();\n</script>\n",
      "comments": [],
      "created": "2026-10-10T03:34:21.523379+00:00",
