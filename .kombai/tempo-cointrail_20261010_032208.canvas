       </th>\n                                <th data-kid=\"1-2-5-1-3-1-1-1-8\" scope=\"col\">\n                                    Risk / state\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-5-1-3-1-2\">\n                            <tr data-kid=\"1-2-5-1-3-1-2-1\">\n                                <td class=\"seq\" data-kid=\"1-2-5-1-3-1-2-1-1\">\n                                    01\n                                </td>\n                                <td data-kid=\"1-2-5-1-3-1-2-1-2\">\n                                    <span class=\"stop-name\" data-kid=\"1-2-5-1-3-1-2-1-2-1\">\n                                        Village Collection Center 4\n                                    </span>\n                                    <span class=\"stop-id\" data-kid=\"1-2-5-1-3-1-2-1-2-2\">\n                                        VCC-004 · collected\n                                    </span>\n                                </td>\n                                <td class=\"time\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-2-1-3\" data-name=\"estimated arrival time\" data-reason=\"value dynamically fetched from route data\">\n                                    04:35\n                                </td>\n                                <td class=\"time actual-recorded\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-2-1-4\" data-name=\"actual arrival time\" data-reason=\"value dynamically fetched from route data\">\n                                    04:41\n                                </td>\n                                <td class=\"volume\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-2-1-5\" data-name=\"collected volume\" data-reason=\"value dynamically fetched from route data\">\n                                    738.8 L\n                                </td>\n                                <td class=\"temp\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-2-1-6\" data-name=\"initial collection temperature\" data-reason=\"value dynamically fetched from route data\">\n                                    35.8 °C\n                                    <span class=\"estimate-mark\" data-kid=\"1-2-5-1-3-1-2-1-6-1\">\n                                        *\n                                    </span>\n                                </td>\n                                <td class=\"tsb watch\" data-dynamic=\"true\" data-kid=\"1-2-5-1-3-1-2-1-7\" data-name=\"thermal time-to-safety balance\" data-reason=\"value dynamically fetched from route data\">\n                                    2.1 h\n                                    <span class=\"estimate-mark\" data-kid=\"1-2-5-1-3-1-2-1-7-1\">\n                                        *\n                                    </span>\n                                </td>\n                                <td data-kid=\"1-2-5-1-3-1-2-1-8\">\n                                    <span class=\"risk-label watch\" data-kid=\"1-2-5-1-3-1-2-1-8-1\">\n                                        <span class=\"risk-dot\" data-kid=\"1-2-5-1-3-1-2-1-8-1-1\">\n                                        </span>\n                                        Warning · collected\n                                    </span>\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-5-1-3-1-2-2\">\n                                <td class=\"seq\" data-kid=\"1-2-5-1-3-1-2-2-1\">\n                                    02\n                                </td>\n                                <td data-kid=\"1-2-5-1-3-1-2-2-2\">\n                                    <span class=\"stop-name\" data-kid=\"1-2-5-1-3-1-2-2-2-1\">\n                                        Village Collection Center 1\n                                    </span>\n                                    <span class=\"stop-id\" data-kid=\"1-2-5-1-3-1-2-2-2-2\">\n                                        VCC-001 · upcoming\n                                    </span>\n                                </td>\n                                <td class=\"time\" data-kid=\"1-2-5-1-3-1-2-2-3\">\n                                    05:10\n                                </td>\n                                <td class=\"empty-data\" data-kid=\"1-2-5-1-3-1-2-2-4\">\n                                    Not recorded\n                                </td>\n                                <td class=\"empty-data\" data-kid=\"1-2-5-1-3-1-2-2-5\">\n                                    Not collected\n                                </td>\n                                <td class=\"empty-data\" data-kid=\"1-2-5-1-3-1-2-2-6\">\n                                    Not recorded\n                                </td>\n                                <td class=\"empty-data\" data-kid=\"1-2-5-1-3-1-2-2-7\">\n                                    Not calculated\n                                </td>\n                                <td data-kid=\"1-2-5-1-3-1-2-2-8\">\n                                    <span class=\"risk-label pending\" data-kid=\"1-2-5-1-3-1-2-2-8-1\">\n                                        <span class=\"risk-dot\" data-kid=\"1-2-5-1-3-1-2-2-8-1-1\">\n                                        </span>\n                                        Unscored\n                                    </span>\n                                </td>\n                            </tr>\n                            <tr class=\"priority-row\" data-kid=\"1-2-5-1-3-1-2-3\">\n                                <td class=\"seq\" data-kid=\"1-2-5-1-3-1-2-3-1\">\n                                    03\n                                </td>\n                                <td data-kid=\"1-2-5-1-3-1-2-3-2\">\n                                    <span class=\"stop-name\" data-kid=\"1-2-5-1-3-1-2-3-2-1\">\n                                        Village Collection Center 3\n  