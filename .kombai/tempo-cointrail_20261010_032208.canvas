    },
    "var_451a0e7c3677": {
      "type": "variant",
      "label": "Round-led — Alerts",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4620,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root{--bg:#0d0f10;--surface:#141718;--surface-2:#191d1e;--surface-3:#202526;--line:#2a3031;--ink:#f3f6f4;--muted:#a0aaa8;--quiet:#76817e;--mint:#54dbb2;--mint-dim:#183c33;--red:#ff7182;--red-dim:#421f26;--amber:#edc15b;--amber-dim:#3b321d;--blue:#90a6ff;--blue-dim:#242d4a;--radius:12px;--font:'DM Sans',sans-serif;--mono:'IBM Plex Mono',monospace}\n.shell{min-height:100vh;background:var(--bg);color:var(--ink);font-family:var(--font);font-size:14px;line-height:1.45;padding-bottom:34px}\n.topbar{height:70px;border-bottom:1px solid var(--line);display:flex;align-items:center;padding:0 40px;gap:40px;background:#0d0f10}\n.brand{display:flex;align-items:center;gap:10px;min-width:190px;font-size:17px;font-weight:700;letter-spacing:-.4px}\n.brand-mark{width:31px;height:31px;border-radius:9px;background:var(--mint);color:#09241d;display:grid;place-items:center;font-weight:800;font-size:14px}\n.nav{height:100%;display:flex;align-items:center;gap:7px;flex:1}\n.nav a{height:100%;display:flex;align-items:center;gap:9px;padding:0 15px;color:#a5afac;text-decoration:none;font-weight:500;border-bottom:2px solid transparent;white-space:nowrap}\n.nav a.active{color:#f6faf8;border-bottom-color:var(--mint)}\n.nav i{font-size:17px;color:#84918d;width:18px;text-align:center}.nav .active i{color:var(--mint)}\n.top-right{display:flex;align-items:center;gap:14px;white-space:nowrap}\n.demo-state{display:flex;align-items:center;gap:8px;padding:8px 12px;background:#171c1d;border:1px solid #343b3b;border-radius:7px;color:#c4ceca;font-size:12px;font-weight:600}\n.demo-dot{width:7px;height:7px;border-radius:50%;background:var(--amber)}\n.page{max-width:1440px;margin:0 auto;padding:27px 40px 36px}\n.page-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:19px;gap:24px}\n.page-head h1{font-size:28px;line-height:1.15;letter-spacing:-.7px;margin:0 0 6px;font-weight:650}\n.page-head p{margin:0;color:var(--muted);font-size:14px}\n.page-context{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px;padding-bottom:4px}\n.page-context i{font-size:15px;color:var(--amber)}\n.statline{display:flex;align-items:stretch;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:19px;padding:12px 0}\n.stat{min-width:0;display:flex;align-items:baseline;gap:10px;padding:0 25px;border-right:1px solid var(--line)}\n.stat:first-child{padding-left:2px}.stat:last-child{border-right:0}\n.stat-label{font-size:13px;color:#a5afac;white-space:nowrap}.stat-value{font:600 19px/1 var(--mono);color:#f4f7f5;letter-spacing:-.7px}.stat.critical .stat-value{color:var(--red)}.stat.warning .stat-value{color:var(--amber)}.stat.unack .stat-value{color:var(--mint)}\n.workgrid{display:grid;grid-template-columns:minmax(0,1fr) 322px;gap:18px;align-items:start}\n.worklist{min-width:0}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}\n.list-head{height:61px;padding:0 18px;display:flex;align-items:center;justify-content:space-between;gap:14px;border-bottom:1px solid var(--line)}\n.panel-title{font-size:15px;font-weight:650;letter-spacing:-.15px}\n.result-note{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px;white-space:nowrap}.result-note .dot{width:6px;height:6px;background:var(--amber);border-radius:50%}\n.toolbar{padding:13px 16px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--line);flex-wrap:wrap}\n.search{height:39px;width:265px;display:flex;align-items:center;gap:9px;border:1px solid #343b3c;border-radius:7px;background:#101314;padding:0 11px;color:var(--muted)}\n.search i{font-size:16px;color:#8d9895}.search span{font-size:13px;color:#7f8987;flex:1}.search kbd{font:11px var(--mono);padding:2px 5px;color:#86918e;border:1px solid #39403f;border-radius:4px}\n.filters{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.filter{height:34px;border-radius:7px;padding:0 11px;border:1px solid transparent;background:transparent;color:#a8b1ae;font:500 12px var(--font);white-space:nowrap}.filter.selected{background:#252b2b;border-color:#3b4442;color:#f4f7f5}.filter .count{margin-left:5px;color:#8f9a97;font:11px var(--mono)}.filter.critical-count .count{color:var(--red)}.filter.warning-count .count{color:var(--amber)}\n.table-scroll{overflow-x:auto;scrollbar-color:#37403e #141718}\ntable{width:100%;border-collapse:collapse;table-layout:fixed;min-width:960px}\ncol.type{width:14%}col.severity{width:11%}col.message{width:26%}col.vehicle{width:9%}col.vcc{width:8%}col.time{width:8%}col.status{width:12%}col.action{width:12%}\nthead th{height:39px;padding:0 10px;text-align:left;color:#899491;background:#171a1b;border-bottom:1px solid var(--line);font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}\nthead th:first-child,tbody td:first-child{padding-left:17px}\ntbody tr{height:66px;border-bottom:1px solid #242a2b}\ntbody tr:last-child{border-bottom:0}\ntbody tr:hover{background:#1a1f20}\ntbody tr[aria-current=\"true\"]{background:#1b2422;box-shadow:inset 2px 0 0 var(--mint)}\ntbody td{padding:9px 10px;color:#dce3e0;font-size:13px;vertical-align:middle;overflow:hidden;text-overflow:ellipsis}\n.type-cell{display:flex;align-items:center;gap:8px;color:#e8eeeb;font-weight:550;white-space:nowrap}.type-icon{width:24px;height:24px;flex:none;border-radius:6px;display:grid;place-items:center;background:#222829;color:#bdc8c4}.type-icon i{font-size:14px}.type-icon.therm{color:var(--red);background:#311d22}.type-icon.bmc{color:var(--amber);background:#322b1c}.type-icon.route{color:var(--mint);background:#18332d}\nspan.severity{display:inline-flex;align-items:center;gap:6px;color:#dce3e0;font-size:12px;font-weight:600;white-space:nowrap}.sev-dot{width:7px;height:7px;border-radius:50%;background:var(--blue)}span.severity.critical .sev-dot{background:var(--red)}span.severity.warning .sev-dot{background:var(--amber)}span.severity.info .sev-dot{background:var(--blue)}\n.message{line-height:1.35;color:#e1e8e5}.message small{display:block;color:#889390;font-size:12px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.mono{font-family:var(--mono);font-size:12px!important;color:#c9d2ce!important;white-space:nowrap}\n.status-tag{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:#d9e1dd;white-space:nowrap}.status-tag .status-dot{width:6px;height:6px;border-radius:50%;background:var(--amber)}.status-tag.ack{color:#9ca6a2}.status-tag.ack .status-dot{background:#75817d}\n.btn{height:34px;padding:0 10px;border-radius:6px;border:1px solid #414948;background:#222828;color:#f2f7f4;font:600 12px var(--font);white-space:nowrap}.btn:hover{background:#2b3332;border-color:#626d69}.btn.acknowledge{border-color:#476b60;color:#9de9ce;background:#182621}.btn.acknowledge:hover{background:#213a30}.btn:focus-visible,.filter:focus-visible,.search:focus-visible,.nav a:focus-visible,.link:focus-visible{outline:2px solid #8aefcf;outline-offset:2px}\n.list-footer{height:38px;padding:0 17px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#87928e}.list-footer strong{font:500 11px var(--mono);color:#bcc7c2}\n.context{padding:18px 18px 0}\n.context-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.context-head h2{font-size:14px;margin:0;font-weight:650}.icon-button{width:30px;height:30px;border:1px solid #37403f;border-radius:6px;background:#1b2021;color:#b4bfbb;display:grid;place-items:center;font-size:15px}\n.context-type{display:flex;align-items:center;gap:8px;color:#a8b3af;font-size:12px;margin-bottom:9px}.context-type .severity{font-size:11px;text-transform:uppercase;letter-spacing:.03em;color:#ff9aa6}.context h3{font-size:17px;line-height:1.35;margin:0 0 8px;letter-spacing:-.22px}.context-copy{font-size:13px;color:#aab4b0;line-height:1.5;margin:0 0 16px}\n.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px 16px;padding:13px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.detail label{display:block;color:#899491;font-size:11px;margin-bottom:4px}.detail strong{font-size:13px;font-weight:550;color:#e5ece8}.detail .link{color:var(--mint);text-decoration:none;border-bottom:1px solid #31564b}\n.route-block{padding:15px 0 12px}.route-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}.route-top strong{font-size:13px;font-weight:600}.route-top a{font-size:12px;color:var(--mint);text-decoration:none}.stop{position:relative;display:grid;grid-template-columns:19px minmax(0,1fr) auto;gap:9px;align-items:start;padding-bottom:13px}.stop:last-child{padding-bottom:0}.stop:not(:last-child):before{content:'';position:absolute;left:8px;top:17px;bottom:0;width:1px;background:#3e4945}.stop-mark{width:17px;height:17px;border:1px solid #52615b;border-radius:50%;background:#1d2422;color:#bdc8c3;display:grid;place-items:center;font:10px var(--mono);z-index:1}.stop.done .stop-mark{border-color:#427863;color:var(--mint);background:#17332a}.stop.current .stop-mark{border-color:var(--amber);color:#0e1111;background:var(--amber)}.stop-name{font-size:12px;font-weight:550;color:#e1e7e4}.stop-sub{font-size:11px;color:#87938f;margin-top:2px}.stop-time{font:11px var(--mono);color:#aab5b1;white-space:nowrap;text-align:right}.stop.current .stop-name{color:#f4f7f5}.tsb{display:flex;align-items:center;justify-content:space-between;padding:10px 11px;border:1px solid #463c25;border-radius:7px;background:#211e17;margin:2px 0 13px}.tsb span{font-size:12px;color:#b6aa8b}.tsb strong{font:600 13px var(--mono);color:var(--amber)}.model-note{font-size:11px;color:#928a74;margin:-6px 0 13px;line-height:1.4}\n.ack-copy{border-top:1px solid var(--line);padding:13px 0 17px;color:#a8b2ae;font-size:12px;line-height:1.45}.ack-copy strong{color:#e0e7e3;font-weight:600}.context-action{width:100%;height:40px;border-radius:7px;background:#1a3a30;border:1px solid #3c7964;color:#a7f2d7;font:600 13px var(--font);margin-bottom:17px}.context-action:hover{background:#234b3e}.context-action:focus-visible{outline:2px solid #8aefcf;outline-offset:2px}\n.states{margin-top:18px}.states h2{font-size:13px;font-weight:600;color:#aab4b0;margin:0 0 9px}.state-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.state-card{display:flex;gap:10px;align-items:flex-start;min-height:80px;background:#131718;border:1px solid #2a3031;border-radius:8px;padding:11px 12px}.state-card i{margin-top:1px;font-size:16px;color:var(--mint)}.state-card.unavailable i{color:var(--amber)}.state-card strong{display:block;font-size:12px;font-weight:600;margin-bottom:3px}.state-card p{margin:0;color:#9ba6a2;font-size:11px;line-height:1.4}.state-card button{border:0;background:none;color:var(--mint);font:600 11px var(--font);padding:3px 0 0;text-decoration:underline;text-underline-offset:2px}\n@media(max-width:1100px){.topbar{padding:0 22px;gap:22px}.brand{min-width:155px}.page{padding-left:22px;padding-right:22px}.workgrid{grid-template-columns:minmax(0,1fr) 295px}.stat{padding:0 16px}.stat-label{font-size:12px}}\n@media(max-width:780px){.topbar{height:auto;min-height:62px;padding:10px 16px;gap:12px;flex-wrap:wrap}.brand{min-width:0;flex:1}.top-right{gap:8px}.demo-state{font-size:11px;padding:7px 9px}.avatar{display:none}.nav{order:3;flex:0 0 100%;height:43px;overflow-x:auto;gap:2px}.nav a{padding:0 12px;font-size:12px}.page{padding:22px 16px 32px}.page-head{align-items:flex-start;flex-direction:column;gap:8px}.page-head h1{font-size:25px}.page-context{padding:0}.statline{overflow-x:auto;gap:0}.stat{padding:0 14px;min-width:max-content}.stat:first-child{padding-left:0}.stat-label{font-size:11px}.stat-value{font-size:17px}.workgrid{grid-template-columns:1fr;gap:14px}.worklist{order:0}.context-panel{order:1}.toolbar{align-items:stretch}.search{width:100%}.filters{overflow-x:auto;flex-wrap:nowrap;padding:2px 1px 3px}.filter{min-height:40px}.list-head{height:56px;padding:0 13px}.result-note{font-size:11px}.table-scroll{max-height:470px}table{min-width:960px}.context{padding:16px}.states{margin-top:14px}.state-grid{grid-template-columns:1fr}.state-card{min-height:70px}}\n@media(max-width:420px){.page{padding-left:12px;padding-right:12px}.brand{font-size:15px}.brand-mark{width:28px;height:28px}.demo-state{padding:6px 8px}.page-head h1{font-size:23px}.stat{gap:7px;padding:0 10px}.stat-label{font-size:10px}.stat-value{font-size:15px}.filter{padding:0 9px}.result-note{white-space:normal;text-align:right;max-width:120px}.state-grid{gap:8px}}\n</style>\n<div class=\"shell\" data-kid=\"1\" data-name=\"app page shell\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top app bar\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand group with logo\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo monogram tile\">\n                T\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand product name text\">\n                T.E.M.P.O.\n            </span>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"main navigation bar\">\n            <a data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"/dashboard\">\n                <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard layout icon\">\n                </i>\n                Dashboard\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"routes nav link\" href=\"/routes\">\n                <i class=\"ti ti-route\" data-kid=\"1-1-2-2-1\" data-name=\"routes path icon\">\n                </i>\n                Routes\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-2-3\" data-name=\"alerts nav link (active)\" href=\"/alerts\">\n                <i class=\"ti ti-alert-triangle\" data-kid=\"1-1-2-3-1\" data-name=\"alert triangle icon\">\n                </i>\n                Alerts\n            </a>\n            <a data-kid=\"1-1-2-4\" data-name=\"analytics nav link\" href=\"/analytics\">\n                <i class=\"ti ti-chart-bar\" data-kid=\"1-1-2-4-1\" data-name=\"bar chart icon\">\n                </i>\n                Analytics\n            </a>\n        </nav>\n        <div class=\"top-right\" data-kid=\"1-1-3\" data-name=\"top bar right actions group\">\n            <div class=\"demo-state\" data-kid=\"1-1-3-1\" data-name=\"demo mode status badge\">\n                <span class=\"demo-dot\" data-kid=\"1-1-3-1-1\" data-name=\"amber status dot\">\n                </span>\n                Demo scenario · not live\n            </div>\n        </div>\n    </header>\n    <main class=\"page\" data-kid=\"1-2\" data-name=\"main content page area\">\n        <div class=\"page-head\" data-kid=\"1-2-1\" data-name=\"page header with title and note\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page headline\">\n                    Alert center\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page description text\">\n                    Review thermal, quality and route exceptions across the collection round.\n                </p>\n            </div>\n            <div class=\"page-context\" data-kid=\"1-2-1-2\" data-name=\"page context note with icon\">\n                <i class=\"ti ti-database-off\" data-kid=\"1-2-1-2-1\" data-name=\"database-off icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"context note text\">\n                    Sample records shown for layout review\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Alert totals\" class=\"statline\" data-kid=\"1-2-2\" data-name=\"alert totals stat strip\">\n            <div class=\"stat\" data-kid=\"1-2-2-1\" data-name=\"total alerts stat\">\n                <span class=\"stat-label\" data-kid=\"1-2-2-1-1\" data-name=\"total alerts label\">\n                    Total alerts\n                </span>\n                <strong class=\"stat-value\" data-kid=\"1-2-2-1-2\" data-name=\"total alerts value\">\n                    05\n                </strong>\n            </div>\n            <div class=\"stat critical\" data-kid=\"1-2-2-2\" data-name=\"critical alerts stat\">\n                <span class=\"stat-label\" data-kid=\"1-2-2-2-1\" data-name=\"critical alerts label\">\n                    Critical\n                </span>\n                <strong class=\"stat-value\" data-kid=\"1-2-2-2-2\" data-name=\"critical alerts value\">\n                    02\n                </strong>\n            </div>\n            <div class=\"stat warning\" data-kid=\"1-2-2-3\" data-name=\"warning alerts stat\">\n                <span class=\"stat-label\" data-kid=\"1-2-2-3-1\" data-name=\"warning alerts label\">\n                    Warning\n                </span>\n                <strong class=\"stat-value\" data-kid=\"1-2-2-3-2\" data-name=\"warning alerts value\">\n                    02\n                </strong>\n            </div>\n            <div class=\"stat unack\" data-kid=\"1-2-2-4\" data-name=\"unacknowledged alerts stat\">\n                <span class=\"stat-label\" data-kid=\"1-2-2-4-1\" data-name=\"unacknowledged alerts label\">\n                    Unacknowledged\n                </span>\n                <strong class=\"stat-value\" data-kid=\"1-2-2-4-2\" data-name=\"unacknowledged alerts value\">\n                    04\n                </strong>\n            </div>\n        </section>\n        <div class=\"workgrid\" data-kid=\"1-2-3\" data-name=\"work grid layout with list and context panel\">\n            <section aria-labelledby=\"worklist-title\" class=\"worklist\" data-kid=\"1-2-3-1\" data-name=\"alert worklist column\">\n                <div class=\"panel\" data-kid=\"1-2-3-1-1\" data-name=\"worklist panel\">\n                    <div class=\"list-head\" data-kid=\"1-2-3-1-1-1\" data-name=\"worklist panel header\">\n                        <div class=\"panel-title\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"worklist panel title\" id=\"worklist-title\">\n                            Alert worklist\n                        </div>\n                        <div class=\"result-note\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"worklist sample data note\">\n                            <span class=\"dot\" data-kid=\"1-2-3-1-1-1-2-1\" data-name=\"note indicator dot\">\n                            </span>\n                            Demo scenario · not live\n                        </div>\n                    </div>\n                    <div class=\"toolbar\" data-kid=\"1-2-3-1-1-2\" data-name=\"worklist toolbar\">\n                        <div class=\"search\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"search input field\" role=\"search\">\n                            <i class=\"ti ti-search\" data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"search magnifier icon\">\n                            </i>\n                            <span data-kid=\"1-2-3-1-1-2-1-2\" data-name=\"search placeholder text\">\n                                Search message, vehicle or VCC\n                            </span>\n                            <kbd data-kid=\"1-2-3-1-1-2-1-3\" data-name=\"search shortcut hint\">\n                                ⌕\n                            </kbd>\n                        </div>\n                        <div aria-label=\"Filter by severity\" class=\"filters\" data-kid=\"1-2-3-1-1-2-2\" data-name=\"severity filter group\">\n                            <button aria-pressed=\"true\" class=\"filter selected\" data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"all severity filter button (selected)\">\n                                All\n                                <span class=\"count\" data-kid=\"1-2-3-1-1-2-2-1-1\" data-name=\"all severity count\">\n                                    05\n                                </span>\n                            </button>\n                            <button aria-pressed=\"false\" class=\"filter critical-count\" data-kid=\"1-2-3-1-1-2-2-2\" data-name=\"critical severity filter button\">\n                                Critical\n                                <span class=\"count\" data-kid=\"1-2-3-1-1-2-2-2-1\" data-name=\"critical severity count\">\n                                    02\n                                </span>\n                            </button>\n                            <button aria-pressed=\"false\" class=\"filter warning-count\" data-kid=\"1-2-3-1-1-2-2-3\" data-name=\"warning severity filter button\">\n                                Warning\n                                <span class=\"count\" data-kid=\"1-2-3-1-1-2-2-3-1\" data-name=\"warning severity count\">\n                                    02\n                                </span>\n                            </button>\n                            <button aria-pressed=\"false\" class=\"filter\" data-kid=\"1-2-3-1-1-2-2-4\" data-name=\"info severity filter button\">\n                                Info\n                                <span class=\"count\" data-kid=\"1-2-3-1-1-2-2-4-1\" data-name=\"info severity count\">\n                                    01\n                                </span>\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"table-scroll\" data-kid=\"1-2-3-1-1-3\" data-name=\"horizontally scrollable table container\">\n                        <table aria-label=\"Demo alert records\" data-kid=\"1-2-3-1-1-3-1\" data-name=\"alert records data table\">\n                     