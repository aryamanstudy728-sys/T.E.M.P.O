       Example response\n                        </span>\n                    </div>\n                    <div class=\"result-content\" data-kid=\"1-2-4-2-1-2\" data-name=\"panel content body\">\n                        <div class=\"result-state\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"preview state banner\">\n                            <i aria-hidden=\"true\" class=\"ti ti-eye\" data-kid=\"1-2-4-2-1-2-1-1\" data-name=\"eye preview icon\">\n                            </i>\n                            <span data-kid=\"1-2-4-2-1-2-1-2\" data-name=\"preview state text\">\n                                <strong data-kid=\"1-2-4-2-1-2-1-2-1\" data-name=\"preview state emphasis\">\n                                    Preview only\n                                </strong>\n                                · A returned proposal appears here before an operator applies it.\n                            </span>\n                        </div>\n                        <div class=\"impact-grid\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"impact metrics grid\">\n                            <div class=\"impact\" data-kid=\"1-2-4-2-1-2-2-1\" data-name=\"time saved impact block\">\n                                <label data-kid=\"1-2-4-2-1-2-2-1-1\" data-name=\"impact metric label\">\n                                    Potential time saved\n                                </label>\n                                <b data-kid=\"1-2-4-2-1-2-2-1-2\" data-name=\"impact metric value\">\n                                    18 min\n                                </b>\n                                <small data-kid=\"1-2-4-2-1-2-2-1-3\" data-name=\"impact metric caption\">\n                                    Example API result\n                                </small>\n                            </div>\n                            <div class=\"impact\" data-kid=\"1-2-4-2-1-2-2-2\" data-name=\"risk reduction impact block\">\n                                <label data-kid=\"1-2-4-2-1-2-2-2-1\" data-name=\"impact metric label\">\n                                    Risk reduction\n                                </label>\n                                <b data-kid=\"1-2-4-2-1-2-2-2-2\" data-name=\"impact metric value\">\n                                    12.6%\n                                </b>\n                                <small data-kid=\"1-2-4-2-1-2-2-2-3\" data-name=\"impact metric caption\">\n                                    Example API result\n                                </small>\n                            </div>\n                        </div>\n                        <div class=\"change-title\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"proposed changes header row\">\n                            <span data-kid=\"1-2-4-2-1-2-3-1\" data-name=\"proposed changes title\">\n                                Proposed changes\n                            </span>\n                            <span data-kid=\"1-2-4-2-1-2-3-2\" data-name=\"changes count label\">\n                                2 changes\n                            </span>\n                        </div>\n                        <ul class=\"change-list\" data-kid=\"1-2-4-2-1-2-4\" data-name=\"proposed changes list\">\n                            <li data-kid=\"1-2-4-2-1-2-4-1\" data-name=\"reorder stop change item\">\n                                <span class=\"change-mark\" data-kid=\"1-2-4-2-1-2-4-1-1\" data-name=\"change mark badge\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-arrows-sort\" data-kid=\"1-2-4-2-1-2-4-1-1-1\" data-name=\"arrows sort change icon\">\n                                    </i>\n                                </span>\n                                <div class=\"change-copy\" data-kid=\"1-2-4-2-1-2-4-1-2\" data-name=\"change copy block\">\n                                    <strong data-kid=\"1-2-4-2-1-2-4-1-2-1\" data-name=\"change title\">\n                                        Move Center 2 before Center 8\n                                    </strong>\n                                    <p data-kid=\"1-2-4-2-1-2-4-1-2-2\" data-name=\"change description\">\n                                        Serve the 0.4 h estimated buffer earlier in the round.\n                                    </p>\n                                </div>\n                            </li>\n                            <li data-kid=\"1-2-4-2-1-2-4-2\" data-name=\"return cooler change item\">\n                                <span class=\"change-mark\" data-kid=\"1-2-4-2-1-2-4-2-1\" data-name=\"change mark badge\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-2-4-2-1-2-4-2-1-1\" data-name=\"route change icon\">\n                                    </i>\n                                </span>\n                                <div class=\"change-copy\" data-kid=\"1-2-4-2-1-2-4-2-2\" data-name=\"change copy block\">\n                                    <strong data-kid=\"1-2-4-2-1-2-4-2-2-1\" data-name=\"change title\">\n                                        Return to Bulk Milk Cooler 1\n                                    </strong>\n                                    <p data-kid=\"1-2-4-2-1-2-4-2-2-2\" data-name=\"change description\">\n                                        Keep the final destination after the remaining collection stops.\n                                    </p>\n                                </div>\n                            </li>\n                        </ul>\n                    </div>\n                </section>\n                <section aria-labelledby=\"vehicle-summary-title\" class=\"vehicle-panel\" data-kid=\"1-2-4-2-2\" data-name=\"selected vehicle panel\">\n                    <div class=\"rail-head\" data-kid=\"1-2-4-2-2-1\" data-name=\"panel head row\">\n                        <h2 data-kid=\"1-2-4-2-2-1-1\" data-name=\"selected vehicle heading\" id=\"vehicle-summary-title\">\n                            Selected vehicle\n                        </h2>\n                        <span class=\"risk-tag yellow\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"vehicle status tag collecting\">\n                            COLLECTING\n                        </span>\n                    </div>\n                    <div class=\"vehicle-line\" data-kid=\"1-2-4-2-2-2\" data-name=\"vehicle ID row\">\n                        <span data-kid=\"1-2-4-2-2-2-1\" data-name=\"vehicle ID label\">\n                            Vehicle ID\n                        </span>\n                        <strong data-kid=\"1-2-4-2-2-2-2\" data-name=\"vehicle ID value\">\n                            VEH-002\n                        </strong>\n                    </div>\n                    <div class=\"vehicle-line\" data-kid=\"1-2-4-2-2-3\" data-name=\"route progress row\">\n                        <span data-kid=\"1-2-4-2-2-3-1\" data-name=\"route progress label\">\n                            Route progress\n                        </span>\n                        <strong data-kid=\"1-2-4-2-2-3-2\" data-name=\"route progress value\">\n                            1 / 5 stops\n                        </strong>\n                    </div>\n                    <div class=\"vehicle-line\" data-kid=\"1-2-4-2-2-4\" data-name=\"next stop row\">\n                        <span data-kid=\"1-2-4-2-2-4-1\" data-name=\"next stop label\">\n                            Next stop\n                        </span>\n                        <strong data-kid=\"1-2-4-2-2-4-2\" data-name=\"next stop value\">\n                            VCC-008\n                        </strong>\n                    </div>\n                    <div class=\"confidence-note\" data-kid=\"1-2-4-2-2-5\" data-name=\"model confidence note block\">\n                        <strong data-kid=\"1-2-4-2-2-5-1\" data-name=\"note emphasis label\">\n                            Model note\n                        </strong>\n                        <br data-kid=\"1-2-4-2-2-5-2\" data-name=\"line break\"/>\n                        Risk bands shown here use demonstration assumptions. Validate thresholds before operational use.\n                    </div>\n                </section>\n            </aside>\n        </div>\n        <footer class=\"page-footer\" data-kid=\"1-2-5\" data-name=\"page footer bar\">\n            <div class=\"footer-left\" data-kid=\"1-2-5-1\" data-name=\"footer disclaimer cluster\">\n                <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-5-1-1\" data-name=\"info circle icon\">\n                </i>\n                <span data-kid=\"1-2-5-1-2\" data-name=\"demo data disclaimer text\">\n                    Demo route data · no live vehicle feed connected in this view.\n                </span>\n            </div>\n            <div aria-label=\"Risk color legend\" class=\"accessibility-legend\" data-kid=\"1-2-5-2\" data-name=\"risk color legend\">\n                <span class=\"legend-item\" data-kid=\"1-2-5-2-1\" data-name=\"green legend item\">\n                    <i class=\"legend-dot mint\" data-kid=\"1-2-5-2-1-1\" data-name=\"green legend dot\">\n                    </i>\n                    Green\n                </span>\n                <span class=\"legend-item\" data-kid=\"1-2-5-2-2\" data-name=\"yellow legend item\">\n                    <i class=\"legend-dot amber\" data-kid=\"1-2-5-2-2-1\" data-name=\"yellow legend dot\">\n                    </i>\n                    Yellow\n                </span>\n                <span class=\"legend-item\" data-kid=\"1-2-5-2-3\" data-name=\"red legend item\">\n                    <i class=\"legend-dot red\" data-kid=\"1-2-5-2-3-1\" data-name=\"red legend dot\">\n                    </i>\n                    Red\n                </span>\n                <span class=\"legend-item\" data-kid=\"1-2-5-2-4\" data-name=\"unknown legend item\">\n                    <i class=\"legend-dot\" data-kid=\"1-2-5-2-4-1\" data-name=\"unknown grey legend dot\" style=\"background:#87918c\">\n                    </i>\n                    Unknown\n                </span>\n            </div>\n        </footer>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-10T03:33:56.682419+00:00",
      "modified": "2026-10-10T03:36:55.203178+00:00",
      "id": "var_4c868580b063",
      "contentHeight": 1128
    },
    "var_3c00c7f16d48": {
      "type": "variant",
      "label": "Round-led — Analytics",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n:root{--bg:#0a0d0d;--surface:#111515;--surface-raised:#161b1a;--line:#29312f;--line-soft:#202725;--text:#edf2ef;--muted:#9ca8a3;--dim:#697570;--mint:#54dfb5;--mint-soft:#173d32;--amber:#e9b752;--amber-soft:#3b2f16;--red:#f17883;--red-soft:#401e25;--blue:#9da8ff;--focus:#d7f9ee}\nbody{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.45;-webkit-font-smoothing:antialiased}\nbutton,a,input{font:inherit}\na{color:inherit;text-decoration:none}\nbutton:focus-visible,a:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n.app{min-height:100vh;background:var(--bg)}\n.topbar{height:72px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;justify-content:space-between;padding:0 42px;gap:24px;background:#0b0f0e}\n.brand{display:flex;align-items:center;gap:11px;min-width:205px}\n.brand-mark{height:34px;width:34px;border-radius:10px;display:grid;place-items:center;background:var(--mint);color:#08261d;font-size:19px}\n.brand-name{font-family:'Space Grotesk',sans-serif;font-weight:700;letter-spacing:.02em;font-size:16px}\n.brand-name span{color:var(--dim);font-weight:500;margin-left:2px}\n.nav{display:flex;align-items:center;gap:5px;flex:1;height:100%}\n.nav a{position:relative;height:100%;display:flex;align-items:center;padding:0 15px;color:#a3ada8;font-size:14px;font-weight:500;white-space:nowrap}\n.nav a:hover{color:var(--text)}\n.nav a.active{color:var(--text)}\n.nav a.active:after{content:'';position:absolute;left:14px;right:14px;bottom:-1px;height:2px;background:var(--mint);border-radius:2px 2px 0 0}\n.top-meta{display:flex;align-items:center;gap:14px;justify-content:flex-end;min-width:240px}\n.env-tag{display:flex;align-items:center;gap:8px;border:1px solid #584723;background:#211b10;border-radius:999px;padding:7px 11px;color:#efd18e;font-size:12px;font-weight:600;white-space:nowrap}\n.env-dot{width:7px;height:7px;border-radius:50%;background:var(--amber)}\n.user-mark{height:31px;width:31px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;color:#cbd3cf;font-family:'Space Grotesk',sans-serif;font-size:11px}\n.main{max-width:1440px;margin:0 auto;padding:34px 42px 56px}\n.page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:29px}\n.head-copy h1{font-family:'Space Grotesk',sans-serif;font-size:28px;line-height:1.18;letter-spacing:-.035em;font-weight:600;margin:0 0 8px}\n.head-copy p{margin:0;color:#a2aea8;font-size:15px}\n.head-note{color:#8e9a95;font-size:12px;text-align:right;max-width:275px}\n.section-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:0 0 14px}\n.section-head h2{font-family:'Space Grotesk',sans-serif;font-size:16px;line-height:1.25;letter-spacing:-.01em;font-weight:600;margin:0}\n.section-meta{color:var(--muted);font-size:12px}\n.panel{background:var(--surface);border:1px solid var(--line);border-radius:13px;min-width:0}\n.top-grid{display:grid;grid-template-columns:minmax(330px,.79fr) minmax(0,1.38fr);gap:16px;align-items:stretch}\n.risk-panel{padding:21px 22px 20px}\n.risk-summary{display:flex;align-items:flex-end;justify-content:space-between;gap:10px;margin:8px 0 17px}\n.big-count{font-family:'Space Grotesk',sans-serif;font-size:31px;line-height:1;font-weight:600;letter-spacing:-.04em;font-variant-numeric:tabular-nums}\n.big-count small{font-family:'DM Sans',sans-serif;font-size:14px;color:var(--muted);font-weight:500;letter-spacing:0}\n.summary-caption{font-size:12px;color:var(--muted);padding-bottom:2px;text-align:right}\n.summary-caption strong{color:#d7dfda;font-weight:600}\n.stackbar{height:9px;display:flex;gap:3px;margin-bottom:18px}\n.stackbar span{display:block;height:100%;border-radius:99px}\n.stackbar .green{background:var(--mint);width:57.14%}.stackbar .yellow{background:var(--amber);width:28.57%}.stackbar .red{background:var(--red);width:14.29%}\n.risk-lines{display:grid;gap:0}\n.risk-line{display:grid;grid-template-columns:minmax(115px,1fr) 62px 58px;align-items:center;gap:10px;padding:10px 0;border-top:1px solid var(--line-soft)}\n.risk-name{display:flex;align-items:center;gap:9px;font-weight:500}\n.dot{width:8px;height:8px;border-radius:50%;flex:0 0 auto}.dot.green{background:var(--mint)}.dot.yellow{background:var(--amber)}.dot.red{background:var(--red)}\n.risk-num,.risk-pct{font-variant-numeric:tabular-nums;text-align:right}.risk-num{font-weight:600}.risk-pct{font-size:12px;color:var(--muted)}\n.risk-foot{border-top:1px solid var(--line-soft);margin-top:8px;padding-top:13px;color:#a1aca7;font-size:12px;display:flex;align-items:flex-start;gap:8px}\n.risk-foot .ti{color:var(--amber);font-size:15px;flex:none;margin-top:1px}\n.vehicle-panel{padding:21px 22px 18px;display:flex;flex-direction:column}\n.vehicle-panel .section-head{margin-bottom:15px}\n.vehicle-table{width:100%;border-collapse:collapse;table-layout:fixed;font-variant-numeric:tabular-nums}\n.vehicle-table th{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:#89958f;text-align:left;font-weight:600;padding:0 9px 10px;border-bottom:1px solid var(--line);white-space:nowrap}\n.vehicle-table td{padding:14px 9px;border-bottom:1px solid var(--line-soft);vertical-align:middle}\n.vehicle-table tbody tr:last-child td{border-bottom:0}\n.vehicle-table th:first-child,.vehicle-table td:first-child{padding-left:0;width:25%}\n.vehicle-table th:nth-child(2){width:10%}\n.vehicle-table th:nth-child(3),.vehicle-table th:nth-child(4),.vehicle-table th:nth-child(5){width:11%}\n.vehicle-table th:last-child{width:17%;text-align:right;padding-right:0}\n.vehicle-table td:last-child{text-align:right;padding-right:0}\n.vehicle-name{display:flex;align-items:center;gap:10px;font-weight:600;color:#e2e9e5;white-space:nowrap}\n.truck-mark{width:28px;height:28px;display:grid;place-items:center;border-radius:8px;color:#9aa7a1;background:#1c2421;font-size:15px}\n.vehicle-sub{display:block;margin-top:2px;font-size:11px;color:var(--dim);font-weight:400}\n.stops-count{color:#d2dad6}\n.cell-risk{font-weight:600}.cell-risk.green{color:var(--mint)}.cell-risk.yellow{color:var(--amber)}.cell-risk.red{color:var(--red)}.cell-risk.empty{color:#697570}\n.tsb{font-weight:600;white-space:nowrap}.tsb.critical{color:var(--red)}.tsb.watch{color:var(--amber)}\n.vehicle-foot{border-top:1px solid var(--line-soft);margin-top:auto;padding-top:13px;color:#a0aca6;font-size:12px;display:flex;align-items:center;gap:8px}\n.vehicle-foot b{color:var(--red);font-weight:600}\n.volume-section{margin-top:27px}\n.volume-panel{padding:21px 22px 20px;display:grid;grid-template-columns:minmax(250px,.7fr) minmax(0,1.3fr);gap:30px;align-items:center}\n.volume-overview{border-right:1px solid var(--line);padding:3px 27px 3px 0}\n.volume-title{font-family:'Space Grotesk',sans-serif;font-size:16px;font-weight:600;margin:0 0 18px}\n.volume-value{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;font-family:'Space Grotesk',sans-serif;font-variant-numeric:tabular-nums}\n.volume-value strong{font-size:27px;letter-spacing:-.035em;font-weight:600}.volume-value span{color:var(--muted);font-size:14px}\n.volume-label{font-size:12px;color:var(--muted);margin-top:4px}\n.volume-meter{height:8px;border-radius:99px;background:#28302d;margin-top:17px;overflow:hidden}\n.volume-meter span{display:block;width:58.63%;height:100%;background:var(--mint);border-radius:99px}\n.volume-meter-labels{display:flex;justify-content:space-between;font-size:11px;color:#87938d;margin-top:7px;font-variant-numeric:tabular-nums}\n.utilization-list{display:grid;gap:14px}\n.util-row{display:grid;grid-template-columns:minmax(110px,.55fr) minmax(100px,1fr) minmax(118px,.65fr);gap:14px;align-items:center}\n.util-name{font-size:13px;font-weight:600;white-space:nowrap}.util-name small{display:block;font-size:11px;color:var(--dim);font-weight:400;margin-top:1px}\n.util-bar{height:6px;border-radius:99px;background:#27302d;overflow:hidden}.util-bar span{height:100%;display:block;border-radius:99px;background:#4ecda8}\n.util-row:nth-child(2) .util-bar span{background:#4ecda8}.util-row:nth-child(3) .util-bar span{background:#4ecda8}.util-amount{text-align:right;font-size:12px;color:#d0d8d3;font-variant-numeric:tabular-nums;white-space:nowrap}.util-amount span{color:#85918a;margin-left:4px}\n.reference-section{margin-top:28px}\n.reference-intro{display:flex;align-items:baseline;gap:12px;margin-bottom:14px}\n.reference-intro h2{font-family:'Space Grotesk',sans-serif;font-size:16px;margin:0;font-weight:600}\n.reference-intro p{font-size:12px;color:#9ba7a1;margin:0}\n.reference-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:16px;align-items:stretch}\n.reference-panel{padding:19px 21px 20px}\n.ref-title{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:15px}\n.ref-title h3{font-size:14px;margin:0;font-weight:600}\n.model-tag{border:1px solid #554622;background:#211b10;color:#eacb82;font-size:11px;border-radius:999px;padding:4px 8px;white-space:nowrap}\n.threshold-list{display:grid;grid-template-columns:1fr 1fr;column-gap:23px}\n.threshold{min-height:59px;border-top:1px solid var(--line-soft);padding:10px 0 9px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}\n.threshold-label{font-size:12px;color:#abb6b0}.threshold-value{font-size:12px;color:#edf2ef;font-weight:600;text-align:right;white-space:nowrap}\n.threshold-desc{grid-column:1/-1;margin-top:-4px;color:#7e8a84;font-size:11px}\n.formula{font-family:'Space Grotesk',sans-serif;font-size:15px;line-height:1.7;color:#e0e9e4;padding:12px 14px;border:1px solid #293330;border-radius:8px;background:#0d1211;overflow-wrap:anywhere;font-variant-numeric:tabular-nums}\n.formula em{font-style:normal;color:var(--mint)}\n.parameter-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:13px}\n.parameter{padding-top:10px;border-top:1px solid var(--line-soft)}\n.parameter strong{display:block;font-family:'Space Grotesk',sans-serif;font-size:14px;color:#e7eeea;font-variant-numeric:tabular-nums;font-weight:600}\n.parameter span{font-size:11px;color:#89958f;display:block;margin-top:2px}\n.formula-note{margin-top:13px;font-size:11px;color:#a6b1ab;display:flex;gap:7px;line-height:1.5}\n.formula-note .ti{color:var(--amber);font-size:15px;flex:none;margin-top:1px}\n.disclaimer{border-top:1px solid var(--line-soft);padding-top:13px;margin-top:16px;color:#87938d;font-size:11px;line-height:1.55}\n@media(max-width:1050px){.topbar{padding:0 25px}.main{padding-left:25px;padding-right:25px}.top-grid{grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr)}.vehicle-table th,.vehicle-table td{padding-left:6px;padding-right:6px}.volume-panel{gap:20px}.volume-overview{padding-right:18px}}\n@media(max-width:780px){.topbar{height:auto;min-height:64px;padding:12px 18px;flex-wrap:wrap;gap:7px}.brand{min-width:unset}.nav{order:3;flex-basis:100%;height:43px;overflow-x:auto;gap:0}.nav a{padding:0 12px;font-size:13px}.nav a:first-child{padding-left:2px}.nav a.active:after{left:10px;right:10px}.top-meta{min-width:unset}.user-mark{display:none}.main{padding:26px 18px 40px}.page-head{align-items:flex-start;flex-direction:column;margin-bottom:22px;gap:10px}.head-note{text-align:left;max-width:none}.top-grid{grid-template-columns:1fr;gap:12px}.risk-panel,.vehicle-panel{padding:18px}.risk-panel{order:0}.vehicle-panel{order:1}.section-head{align-items:flex-start;flex-direction:column;gap:5px}.section-meta{text-align:left}.volume-section{margin-top:22px}.volume-panel{grid-template-columns:1fr;gap:20px;padding:18px}.volume-overview{border-right:0;border-bottom:1px solid var(--line);padding:0 0 19px}.utilization-list{gap:13px}.reference-section{margin-top:23px}.reference-grid{grid-template-columns:1fr;gap:12px}.reference-intro{align-items:flex-start;flex-direction:column;gap:3px}.reference-panel{padding:17px}.vehicle-table,.vehicle-table tbody,.vehicle-table tr,.vehicle-table td{display:block;width:100%}.vehicle-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.vehicle-table tbody{display:grid;gap:0}.vehicle-table tr{display:grid;grid-template-columns:1fr 1fr;gap:9px 12px;padding:13px 0;border-bottom:1px solid var(--line-soft)}.vehicle-table tr:last-child{border-bottom:0}.vehicle-table td{padding:0;border:0;text-align:left!important}.vehicle-table td:first-child{grid-column:1/-1;width:auto}.vehicle-table td:last-child{padding:0;text-align:left!important}.vehicle-table td:nth-child(2):before{content:'Stops ';color:var(--dim);font-size:11px}.vehicle-table td:nth-child(3):before{content:'Green ';color:var(--dim);font-size:11px}.vehicle-table td:nth-child(4):before{content:'Yellow ';color:var(--dim);font-size:11px}.vehicle-table td:nth-child(5):before{content:'Red ';color:var(--dim);font-size:11px}.vehicle-table td:nth-child(6):before{content:'Lowest TSB ';color:var(--dim);font-size:11px}.vehicle-table th:first-child,.vehicle-table td:first-child{padding-left:0}.vehicle-table td:first-child{margin-bottom:2px}.vehicle-table td:nth-child(6){text-align:left!important}.vehicle-table th:nth-child(6){text-align:left}}\n@media(max-width:480px){.topbar{padding:10px 14px}.main{padding:22px 14px 32px}.head-copy h1{font-size:25px}.env-tag{font-size:11px;padding:6px 8px}.risk-summary{align-items:flex-start;flex-direction:column;gap:5px}.summary-caption{text-align:left}.risk-line{grid-template-columns:1fr 48px 52px}.risk-panel,.vehicle-panel{padding:16px}.volume-panel{padding:16px}.util-row{grid-template-columns:1fr auto;gap:7px 10px}.util-bar{grid-column:1/-1;grid-row:2}.util-amount{grid-column:2;grid-row:1}.threshold-list{grid-template-columns:1fr}.parameter-grid{grid-template-columns:1fr 1fr}.reference-intro p{line-height:1.45}}\n</style>\n<div class=\"app\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"app top bar\">\n        <a aria-label=\"T.E.M.P.O. home\" class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo link\" href=\"#\">\n            <span class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand logo mark tile\">\n                <i aria-hidden=\"true\" class=\"ti ti-droplet\" data-kid=\"1-1-1-1-1\" data-name=\"droplet logo icon\">\n                </i>\n            </span>\n            <span class=\"brand-name\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                T.E.M.P.O\n                <span data-kid=\"1-1-1-2-1\" data-name=\"brand name accent dot\">\n                    .\n                </span>\n            </span>\n        </a>\n        <nav aria-label=\"Primary navigation\" class=\"nav\" data-kid=\"1-1-2\" data-name=\"primary navigation\">\n            <a data-kid=\"1-1-2-1\" data-name=\"dashboard nav link\" href=\"#\">\n                Dashboard\n            </a>\n            <a data-kid=\"1-1-2-2\" data-name=\"routes nav link\" href=\"#\">\n                Routes\n            </a>\n            <a data-kid=\"1-1-2-3\" data-name=\"alerts nav link\" href=\"#\">\n                Alerts\n            </a>\n            <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-2-4\" data-name=\"analytics nav link active\" href=\"#\">\n                Analytics\n            </a>\n        </nav>\n        <div class=\"top-meta\" data-kid=\"1-1-3\" data-name=\"top bar meta group\">\n            <span class=\"env-tag\" data-kid=\"1-1-3-1\" data-name=\"environment demo tag\">\n                <span class=\"env-dot\" data-kid=\"1-1-3-1-1\" data-name=\"environment status dot\">\n                </span>\n                Demo scenario · not live\n            </span>\n        </div>\n    </header>\n    <main class=\"main\" data-kid=\"1-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"page-title\" class=\"page-head\" data-kid=\"1-2-1\" data-name=\"page header section\">\n            <div class=\"head-copy\" data-kid=\"1-2-1-1\" data-name=\"page header copy block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"main page heading\" id=\"page-title\">\n                    Analytics & Insights\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page subtitle question text\">\n                    Where is thermal margin being lost?\n                </p>\n            </div>\n            <div class=\"head-note\" data-kid=\"1-2-1-2\" data-name=\"page disclaimer note text\">\n                Sample fleet figures for layout review. No live readings are shown.\n            </div>\n        </section>\n        <section aria-label=\"Thermal risk review\" data-kid=\"1-2-2\" data-name=\"thermal risk review section\">\n            <div class=\"top-grid\" data-kid=\"1-2-2-1\" data-name=\"risk content top grid\">\n                <article class=\"panel risk-panel\" data-kid=\"1-2-2-1-1\" data-name=\"thermal risk distribution panel\">\n                    <div class=\"section-head\" data-kid=\"1-2-2-1-1-1\" data-name=\"risk panel section heading row\">\n                        <h2 data-kid=\"1-2-2-1-1-1-1\" data-name=\"thermal risk distribution heading\">\n                            Thermal risk distribution\n                        </h2>\n                        <span class=\"section-meta\" data-kid=\"1-2-2-1-1-1-2\" data-name=\"evaluated stops count metadata\">\n                            14 stops evaluated\n                        </span>\n                    </div>\n                    <div class=\"risk-summary\" data-kid=\"1-2-2-1-1-2\" data-name=\"risk summary stat row\">\n                        <div class=\"big-count\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"total stops big count\">\n                            14\n                            <small data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"units label for big count\">\n                                stops\n                            </small>\n                        </div>\n                        <div class=\"summary-caption\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"routes-with-red-risk caption\">\n                            <strong data-kid=\"1-2-2-1-1-2-2-1\" data-name=\"routes-with-red-risk ratio\">\n                                2 of 3\n                            </strong>\n                            routes include a red-risk stop\n                        </div>\n                    </div>\n                    <div aria-label=\"Risk distribution: 8 green, 4 yellow, 2 red stops out of 14\" class=\"stackbar\" data-kid=\"1-2-2-1-1-3\" data-name=\"risk distribution stacked bar\" role=\"img\">\n                        <span class=\"green\" data-kid=\"1-2-2-1-1-3-1\" data-name=\"green segment of risk distribution bar\">\n                        </span>\n                        <span class=\"yellow\" data-kid=\"1-2-2-1-1-3-2\" data-name=\"yellow segment of risk distribution bar\">\n                        </span>\n                        <span class=\"red\" data-kid=\"1-2-2-1-1-3-3\" data-name=\"red segment of risk distribution bar\">\n                        </span>\n                    </div>\n                    <div class=\"risk-lines\" data-kid=\"1-2-2-1-1-4\" data-name=\"risk band breakdown list\">\n                        <div class=\"risk-line\" data-kid=\"1-2-2-1-1-4-1\" data-name=\"green band breakdown row\">\n                            <span class=\"risk-name\" data-kid=\"1-2-2-1-1-4-1-1\" data-name=\"green band label with dot\">\n                                <span class=\"dot green\" data-kid=\"1-2-2-1-1-4-1-1-1\" data-name=\"green status dot\">\n                                </span>\n                                Green band\n                            </span>\n                            <span class=\"risk-num\" data-kid=\"1-2-2-1-1-4-1-2\" data-name=\"green band stops count\">\n                                8 stops\n                            </span>\n                            <span class=\"risk-pct\" data-kid=\"1-2-2-1-1-4-1-3\" data-name=\"green band percentage\">\n                                57.1%\n                            </span>\n                        </div>\n                        <div class=\"risk-line\" data-kid=\"1-2-2-1-1-4-2\" data-name=\"yellow band breakdown row\">\n                            <span class=\"risk-name\" data-kid=\"1-2-2-1-1-4-2-1\" data-name=\"yellow band label with dot\">\n                                <span class=\"dot yellow\" data-kid=\"1-2-2-1-1-4-2-1-1\" data-name=\"yellow status dot\">\n                                </span>\n                                Yellow band\n                            </span>\n                            <span class=\"risk-num\" data-kid=\"1-2-2-1-1-4-2-2\" data-name=\"yellow band stops count\">\n                                4 stops\n                            </span>\n                            <span class=\"risk-pct\" data-kid=\"1-2-2-1-1-4-2-3\" data-name=\"yellow band percentage\">\n                                28.6%\n                            </span>\n                        </div>\n                        <div class=\"risk-line\" data-kid=\"1-2-2-1-1-4-3\" data-name=\"red band breakdown row\">\n                            <span class=\"risk-name\" data-kid=\"1-2-2-1-1-4-3-1\" data-name=\"red band label with dot\">\n                                <span class=\"dot red\" data-kid=\"1-2-2-1-1-4-3-1-1\" data-name=\"red status dot\">\n                                </span>\n                                Red band\n                            </span>\n                            <span class=\"risk-num\" data-kid=\"1-2-2-1-1-4-3-2\" data-name=\"red band stops count\">\n                                2 stops\n                            </span>\n                            <span class=\"risk-pct\" data-kid=\"1-2-2-1-1-4-3-3\" data-name=\"red band percentage\">\n                                14.3%\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"risk-foot\" data-kid=\"1-2-2-1-1-5\" data-name=\"risk footnote disclaimer row\">\n                        <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-2-1-1-5-1\" data-name=\"info circle icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-1-1-5-2\" data-name=\"risk threshold disclaimer text\">\n                            Risk bands reflect estimated TSB thresholds, not a guarantee of product safety.\n                        </span>\n                    </div>\n                </article>\n                <article class=\"panel vehicle-panel\" data-kid=\"1-2-2-1-2\" data-name=\"risk by vehicle panel\">\n                    <div class=\"section-head\" data-kid=\"1-2-2-1-2-1\" data-name=\"vehicle panel section heading row\">\n                        <h2 data-kid=\"1-2-2-1-2-1-1\" data-name=\"risk by vehicle heading\">\n                            Risk by vehicle\n                        </h2>\n                        <span class=\"section-meta\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"vehicle table column metadata text\">\n                            Stop counts · lowest estimated TSB\n                        </span>\n                    </div>\n                    <table class=\"vehicle-table\" data-kid=\"1-2-2-1-2-2\" data-name=\"vehicle risk data table\">\n                        <thead data-kid=\"1-2-2-1-2-2-1\" data-name=\"vehicle table header\">\n                            <tr data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"vehicle table header row\">\n                                <th data-kid=\"1-2-2-1-2-2-1-1-1\" data-name=\"vehicle column header\">\n                                    Vehicle\n                                </th>\n                                <th data-kid=\"1-2-2-1-2-2-1-1-2\" data-name=\"stops column header\">\n                                    Stops\n                                </th>\n                                <th data-kid=\"1-2-2-1-2-2-1-1-3\" data-name=\"green column header\">\n                                    Green\n                                </th>\n                                <th data-kid=\"1-2-2-1-2-2-1-1-4\" data-name=\"yellow column header\">\n                                    Yellow\n                                </th>\n                                <th data-kid=\"1-2-2-1-2-2-1-1-5\" data-name=\"red column header\">\n                                    Red\n                                </th>\n                                <th data-kid=\"1-2-2-1-2-2-1-1-6\" data-name=\"lowest TSB column header\">\n                                    Lowest TSB\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-2-1-2-2-2\" data-name=\"vehicle table body\">\n                            <tr data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"tanker 1 risk row\">\n                                <td data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"tanker 1 name cell\">\n                                    <span class=\"vehicle-name\" data-kid=\"1-2-2-1-2-2-2-1-1-1\" data-name=\"tanker 1 name display\">\n                                        <span class=\"truck-mark\" data-kid=\"1-2-2-1-2-2-2-1-1-1-1\" data-name=\"tanker 1 icon badge\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-2-1-2-2-2-1-1-1-1-1\" data-name=\"truck icon\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-2-2-2-1-1-1-2\" data-name=\"tanker 1 name and code\">\n                                            Tanker 1\n                                            <span class=\"vehicle-sub\" data-kid=\"1-2-2-1-2-2-2-1-1-1-2-1\" data-name=\"tanker 1 vehicle code\">\n                                                VEH-001\n                                            </span>\n                                        </span>\n                                    </span>\n                                </td>\n                                <td class=\"stops-count\" data-kid=\"1-2-2-1-2-2-2-1-2\" data-name=\"tanker 1 stops count\">\n                                    5\n                                </td>\n                                <td class=\"cell-risk green\" data-kid=\"1-2-2-1-2-2-2-1-3\" data-name=\"tanker 1 green stops count\">\n                                    3\n                                </td>\n                                <td class=\"cell-risk yellow\" data-kid=\"1-2-2-1-2-2-2-1-4\" data-name=\"tanker 1 yellow stops count\">\n                                    1\n                                </td>\n                                <td class=\"cell-risk red\" data-kid=\"1-2-2-1-2-2-2-1-5\" data-name=\"tanker 1 red stops count\">\n                                    1\n                                </td>\n                                <td class=\"tsb critical\" data-kid=\"1-2-2-1-2-2-2-1-6\" data-name=\"tanker 1 critical lowest TSB\">\n                                    0.3 h\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"tanker 2 risk row\">\n                                <td data-kid=\"1-2-2-1-2-2-2-2-1\" data-name=\"tanker 2 name cell\">\n                                    <span class=\"vehicle-name\" data-kid=\"1-2-2-1-2-2-2-2-1-1\" data-name=\"tanker 2 name display\">\n                                        <span class=\"truck-mark\" data-kid=\"1-2-2-1-2-2-2-2-1-1-1\" data-name=\"tanker 2 icon badge\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-2-1-2-2-2-2-1-1-1-1\" data-name=\"truck icon\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-2-2-2-2-1-1-2\" data-name=\"tanker 2 name and code\">\n                                            Tanker 2\n                                            <span class=\"vehicle-sub\" data-kid=\"1-2-2-1-2-2-2-2-1-1-2-1\" data-name=\"tanker 2 vehicle code\">\n                                                VEH-002\n                                            </span>\n                                        </span>\n                                    </span>\n                                </td>\n                                <td class=\"stops-count\" data-kid=\"1-2-2-1-2-2-2-2-2\" data-name=\"tanker 2 stops count\">\n                                    5\n                                </td>\n                                <td class=\"cell-risk green\" data-kid=\"1-2-2-1-2-2-2-2-3\" data-name=\"tanker 2 green stops count\">\n                                    3\n                                </td>\n                                <td class=\"cell-risk yellow\" data-kid=\"1-2-2-1-2-2-2-2-4\" data-name=\"tanker 2 yellow stops count\">\n                                    2\n                                </td>\n                                <td class=\"cell-risk empty\" data-kid=\"1-2-2-1-2-2-2-2-5\" data-name=\"tanker 2 red stops count placeholder\">\n                                    —\n                                </td>\n                                <td class=\"tsb watch\" data-kid=\"1-2-2-1-2-2-2-2-6\" data-name=\"tanker 2 watch lowest TSB\">\n                                    0.7 h\n                                </td>\n                            </tr>\n                            <tr data-kid=\"1-2-2-1-2-2-2-3\" data-name=\"tanker 3 risk row\">\n                                <td data-kid=\"1-2-2-1-2-2-2-3-1\" data-name=\"tanker 3 name cell\">\n                                    <span class=\"vehicle-name\" data-kid=\"1-2-2-1-2-2-2-3-1-1\" data-name=\"tanker 3 name display\">\n                                        <span class=\"truck-mark\" data-kid=\"1-2-2-1-2-2-2-3-1-1-1\" data-name=\"tanker 3 icon badge\">\n                                            <i aria-hidden=\"true\" class=\"ti ti-truck\" data-kid=\"1-2-2-1-2-2-2-3-1-1-1-1\" data-name=\"truck icon\">\n                                            </i>\n                                        </span>\n                                        <span data-kid=\"1-2-2-1-2-2-2-3-1-1-2\" data-name=\"tanker 3 name and code\">\n                                            Tanker 3\n                                            <span class=\"vehicle-sub\" data-kid=\"1-2-2-1-2-2-2-3-1-1-2-1\" data-name=\"tanker 3 vehicle code\">\n                                                VEH-003\n                                            </span>\n                                        </span>\n                                    </span>\n                                </td>\n                                <td class=\"stops-count\" data-kid=\"1-2-2-1-2-2-2-3-2\" data-name=\"tanker 3 stops count\">\n                                    4\n                                </td>\n                                <td class=\"cell-risk green\" data-kid=\"1-2-2-1-2-2-2-3-3\" data-name=\"tanker 3 green stops count\">\n                                    2\n                                </td>\n                                <td class=\"cell-risk yellow\" data-kid=\"1-2-2-1-2-2-2-3-4\" data-name=\"tanker 3 yellow stops count\">\n                                    1\n                                </td>\n                                <td class=\"cell-risk red\" data-kid=\"1-2-2-1-2-2-2-3-5\" data-name=\"tanker 3 red stops count\">\n                                    1\n                                </td>\n                                <td class=\"tsb critical\" data-kid=\"1-2-2-1-2-2-2-3-6\" data-name=\"tanker 3 critical lowest TSB\">\n                                    0.4 h\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <div class=\"vehicle-foot\" data-kid=\"1-2-2-1-2-3\" data-name=\"vehicle panel critical routes footnote\">\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-narrow-right\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"arrow right navigation icon\">\n                        </i>\n                        <span data-kid=\"1-2-2-1-2-3-2\" data-name=\"critical routes call to action text\">\n                            Critical stops appear on\n                            <b data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"critical routes count emphasis\">\n                                2 routes\n                            </b>\n                            ; compare remaining buffer before dispatch.\n                        </span>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section aria-labelledby=\"volume-title\" class=\"volume-section\" data-kid=\"1-2-3\" data-name=\"vehicle volume and capacity section\">\n            <div class=\"panel volume-panel\" data-kid=\"1-2-3-1\" data-name=\"volume panel layout\">\n                <div class=\"volume-overview\" data-kid=\"1-2-3-1-1\" data-name=\"volume summary left column\">\n                    <h2 class=\"volume-title\" data-kid=\"1-2-3-1-1-1\" data-name=\"fleet volume heading\" id=\"volume-title\">\n                        Fleet volume & capacity\n                    </h2>\n                    <div class=\"volume-value\" data-kid=\"1-2-3-1-1-2\" data-name=\"combined volume value display\">\n                        <strong data-kid=\"1-2-3-1-1-2-1\" data-name=\"current fleet volume value\">\n                            12,840 L\n                        </strong>\n                        <span data-kid=\"1-2-3-1-1-2-2\" data-name=\"combined capacity reference\">\n                            / 21,900 L\n                        </span>\n                    </div>\n                    <div class=\"volume-label\" data-kid=\"1-2-3-1-1-3\" data-name=\"combined volume meter label\">\n                        Current volume / combined vehicle capacity\n                    </div>\n                    <div aria-label=\"12,840 liters of 21,900 liters capacity, 58.6 percent\" class=\"volume-meter\" data-kid=\"1-2-3-1-1-4\" data-name=\"combined volume utilization bar\" role=\"img\">\n                        <span data-kid=\"1-2-3-1-1-4-1\" data-name=\"combined volume filled bar\">\n                        </span>\n                    </div>\n                    <div class=\"volume-meter-labels\" data-kid=\"1-2-3-1-1-5\" data-name=\"volume meter min max labels\">\n                        <span data-kid=\"1-2-3-1-1-5-1\" data-name=\"volume meter zero label\">\n                            0 L\n                        </span>\n                        <span data-kid=\"1-2-3-1-1-5-2\" data-name=\"volume meter utilization percentage\">\n                            58.6% utilized\n                        </span>\n                        <span data-kid=\"1-2-3-1-1-5-3\" data-name=\"volume meter capacity label\">\n                            21,900 L\n                        </span>\n                    </div>\n                </div>\n                <div aria-label=\"Volume by vehicle\" class=\"utilization-list\" data-kid=\"1-2-3-1-2\" data-name=\"per-vehicle utilization list\">\n                    <div class=\"util-row\" data-kid=\"1-2-3-1-2-1\" data-name=\"tanker 1 utilization row\">\n                        <div class=\"util-name\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"tanker 1 utilization label\">\n                            Tanker 1\n                            <small data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"tanker 1 vehicle code label\">\n                                VEH-001\n                            </small>\n                        </div>\n                        <div aria-label=\"71.3 percent of capacity\" class=\"util-bar\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"tanker 1 utilization bar\" role=\"img\">\n                            <span data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"tanker 1 utilization filled bar\" style=\"width:71.3%\">\n                            </span>\n                        </div>\n                        <div class=\"util-amount\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"tanker 1 utilization amount\">\n                            5,420 L\n                            <span data-kid=\"1-2-3-1-2-1-3-1\" data-name=\"tanker 1 capacity reference\">\n                                / 7,600 L\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"util-row\" data-kid=\"1-2-3-1-2-2\" data-name=\"tanker 2 utilization row\">\n                        <div class=\"util-name\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"tanker 2 utilization label\">\n                            Tanker 2\n                            <small data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"tanker 2 vehicle code label\">\n                                VEH-002\n                            </small>\n                        </div>\n                        <div aria-label=\"64.2 percent of capacity\" class=\"util-bar\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"tanker 2 utilization bar\" role=\"img\">\n                            <span data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"tanker 2 utilization filled bar\" style=\"width:64.2%\">\n                            </span>\n                        </div>\n                        <div class=\"util-amount\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"tanker 2 utilization amount\">\n                            4,880 L\n                            <span data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"tanker 2 capacity reference\">\n                                / 7,600 L\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"util-row\" data-kid=\"1-2-3-1-2-3\" data-name=\"tanker 3 utilization row\">\n                        <div class=\"util-name\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"tanker 3 utilization label\">\n                            Tanker 3\n                            <small data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"tanker 3 vehicle code label\">\n                                VEH-003\n                            </small>\n                        </div>\n                        <div aria-label=\"37.9 percent of capacity\" class=\"util-bar\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"tanker 3 utilization bar\" role=\"img\">\n                            <span data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"tanker 3 utilization filled bar\" style=\"width:37.9%\">\n                            </span>\n                        </div>\n                        <div class=\"util-amount\" data-kid=\"1-2-3-1-2-3-3\" data-name=\"tanker 3 utilization amount\">\n                            2,540 L\n                            <span data-kid=\"1-2-3-1-2-3-3-1\" data-name=\"tanker 3 capacity reference\">\n                                / 6,700 L\n                            </span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"reference-heading\" class=\"reference-section\" data-kid=\"1-2-4\" data-name=\"model and quality reference section\">\n            <div class=\"reference-intro\" data-kid=\"1-2-4-1\" data-name=\"reference section intro row\">\n                <h2 data-kid=\"1-2-4-1-1\" data-name=\"model and quality reference heading\" id=\"reference-heading\">\n                    Model & quality reference\n                </h2>\n                <p data-kid=\"1-2-4-1-2\" data-name=\"reference section description\">\n                    Screening inputs for this demo; verify against local standards before operational use.\n                </p>\n            </div>\n            <div class=\"reference-grid\" data-kid=\"1-2-4-2\" data-name=\"reference panels grid\">\n                <article class=\"panel reference-panel\" data-kid=\"1-2-4-2-1\" data-name=\"adulteration screening panel\">\n                    <div class=\"ref-title\" data-kid=\"1-2-4-2-1-1\" data-name=\"adulteration panel heading row\">\n                        <h3 data-kid=\"1-2-4-2-1-1-1\" data-name=\"adulteration screening thresholds heading\">\n                            Adulteration screening thresholds\n                        </h3>\n                        <span class=\"model-tag\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"estimates model tag\">\n                            Estimates\n                        </span>\n                    </div>\n                    <div class=\"threshold-list\" data-kid=\"1-2-4-2-1-2\" data-name=\"adulteration threshold list\">\n                        <div class=\"threshold\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"volume change threshold item\">\n                            <span class=\"threshold-label\" data-kid=\"1-2-4-2-1-2-1-1\" data-name=\"volume change threshold label\">\n                                Volume change\n                            </span>\n                            <span class=\"threshold-value\" data-kid=\"1-2-4-2-1-2-1-2\" data-name=\"volume change threshold value\">\n                                > +2.0%\n                            </span>\n                            <span class=\"threshold-desc\" data-kid=\"1-2-4-2-1-2-1-3\" data-name=\"volume change threshold description\">\n                                Flag for possible water addition\n                            </span>\n                        </div>\n                        <div class=\"threshold\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"fat change threshold item\">\n                            <span class=\"threshold-label\" data-kid=\"1-2-4-2-1-2-2-1\" data-name=\"fat change threshold label\">\n                                Fat change\n                            </span>\n                            <span class=\"threshold-value\" data-kid=\"1-2-4-2-1-2-2-2\" data-name=\"fat change threshold value\">\n                                > 0.3% drop\n                            </span>\n                            <span class=\"threshold-desc\" data-kid=\"1-2-4-2-1-2-2-3\" data-name=\"fat change threshold description\">\n                                Flag for dilution / skimming review\n                            </span>\n                        </div>\n                        <div class=\"threshold\" data-kid=\"1-2-4-2-1-2-3\" data-name=\"SNF change threshold item\">\n                            <span class=\"threshold-label\" data-kid=\"1-2-4-2-1-2-3-1\" data-name=\"SNF change threshold label\">\n                                SNF change\n                            </span>\n                            <span class=\"threshold-value\" data-kid=\"1-2-4-2-1-2-3-2\" data-name=\"SNF change threshold value\">\n                                > 0.3% drop\n                            </span>\n                            <span class=\"threshold-desc\" data-kid=\"1-2-4-2-1-2-3-3\" data-name=\"SNF change threshold description\">\n                                Flag for dilution review\n                            </span>\n                        </div>\n                        <div class=\"threshold\" data-kid=\"1-2-4-2-1-2-4\" data-name=\"density threshold item\">\n                            <span class=\"threshold-label\" data-kid=\"1-2-4-2-1-2-4-1\" data-name=\"density threshold label\">\n                                Density\n                            </span>\n                            <span class=\"threshold-value\" data-kid=\"1-2-4-2-1-2-4-2\" data-name=\"density threshold value\">\n                                < 1.026 g/cm³\n                            </span>\n                            <span class=\"threshold-desc\" data-kid=\"1-2-4-2-1-2-4-3\" data-name=\"density threshold description\">\n                                Trigger a contamination check\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"disclaimer\" data-kid=\"1-2-4-2-1-3\" data-name=\"adulteration disclaimer footnote\">\n                        A threshold crossing indicates a screening flag only; it does not confirm adulteration.\n                    </div>\n                </article>\n                <article class=\"panel reference-panel\" data-kid=\"1-2-4-2-2\" data-name=\"TSB thermal safety buffer panel\">\n                    <div class=\"ref-title\" data-kid=\"1-2-4-2-2-1\" data-name=\"TSB panel heading row\">\n                        <h3 data-kid=\"1-2-4-2-2-1-1\" data-name=\"thermal safety buffer heading\">\n                            Thermal Safety Buffer (TSB)\n                        </h3>\n                        <span class=\"model-tag\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"TSB model estimates tag\">\n                            Model estimates\n                        </span>\n                    </div>\n                    <div class=\"formula\" data-kid=\"1-2-4-2-2-2\" data-name=\"TSB formula expression\">\n                        TSB\n                        <sub data-kid=\"1-2-4-2-2-2-1\" data-name=\"TSB hours unit subscript\">\n                            hours\n                        </sub>\n                        =\n                        <em data-kid=\"1-2-4-2-2-2-2\" data-name=\"TSB numerator expression\">\n                            (θ\n                            <sub data-kid=\"1-2-4-2-2-2-2-1\" data-name=\"theta critical subscript\">\n                                critical\n                            </sub>\n                            − (T\n                            <sub data-kid=\"1-2-4-2-2-2-2-2\" data-name=\"T initial subscript\">\n                                initial\n                            </sub>\n                            − T\n                            <sub data-kid=\"1-2-4-2-2-2-2-3\" data-name=\"T base subscript\">\n                                base\n                            </sub>\n                            ))\n                        </em>\n                        /\n                        <em data-kid=\"1-2-4-2-2-2-3\" data-name=\"TSB denominator expression\">\n                            (k × (T\n                            <sub data-kid=\"1-2-4-2-2-2-3-1\" data-name=\"T ambient subscript\">\n                                ambient\n                            </sub>\n                            − T\n                            <sub data-kid=\"1-2-4-2-2-2-3-2\" data-name=\"T base subscript\">\n                                base\n                            </sub>\n                            ) × β\n                            <sub data-kid=\"1-2-4-2-2-2-3-3\" data-name=\"insulation factor subscript\">\n                                insulation\n                            </sub>\n                            )\n                        </em>\n                    </div>\n                    <div class=\"parameter-grid\" data-kid=\"1-2-4-2-2-3\" data-name=\"TSB parameter grid\">\n                        <div class=\"parameter\" data-kid=\"1-2-4-2-2-3-1\" data-name=\"theta critical parameter card\">\n                            <strong data-kid=\"1-2-4-2-2-3-1-1\" data-name=\"theta critical value\">\n                                850 °C·h\n                            </strong>\n                            <span data-kid=\"1-2-4-2-2-3-1-2\" data-name=\"theta critical parameter name\">\n                                θ critical\n                            </span>\n                        </div>\n                        <div class=\"parameter\" data-kid=\"1-2-4-2-2-3-2\" data-name=\"base temperature parameter card\">\n                            <strong data-kid=\"1-2-4-2-2-3-2-1\" data-name=\"base temperature value\">\n                                4 °C\n                            </strong>\n                            <span data-kid=\"1-2-4-2-2-3-2-2\" data-name=\"base temperature parameter name\">\n                                Base temperature\n                            </span>\n                        </div>\n                        <div class=\"parameter\" data-kid=\"1-2-4-2-2-3-3\" data-name=\"degradation constant k parameter card\">\n                            <strong data-kid=\"1-2-4-2-2-3-3-1\" data-name=\"degradation constant value\">\n                                0.15\n                            </strong>\n                            <span data-kid=\"1-2-4-2-2-3-3-2\" data-name=\"degradation constant parameter name\">\n                                Degradation constant k\n                            </span>\n                        </div>\n                        <div class=\"parameter\" data-kid=\"1-2-4-2-2-3-4\" data-name=\"insulation factor beta parameter card\">\n                            <strong data-kid=\"1-2-4-2-2-3-4-1\" data-name=\"insulation factor value\">\n                                0.4–1.0\n                            </strong>\n                            <span data-kid=\"1-2-4-2-2-3-4-2\" data-name=\"insulation factor parameter name\">\n                                Insulation factor β\n                            </span>\n                        </div>\n                    </div>\n                    <div class=\"formula-note\" data-kid=\"1-2-4-2-2-4\" data-name=\"TSB model formula note\">\n                        <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-2-4-2-2-4-1\" data-name=\"alert triangle icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-2-2-4-2\" data-name=\"TSB estimate disclaimer text\">\n                            Illustrative model inputs; TSB is an estimate and should not be treated as a safety certification.\n                        </span>\n                    </div>\n                    <div class=\"disclaimer\" data-kid=\"1-2-4-2-2-5\" data-name=\"TSB banding disclaimer footnote\">\n                        Current bands: green > 2.5 h · yellow 0.5–2.5 h · red < 0.5 h. Values are assumptions for this demo scenario.\n                    </div>\n                </article>\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-10T03:33:56.730193+00:00",
      "modified": "2026-10-10T03:35:44.281949+00:00",
      "id": "var_3c00c7f16d48",
      "contentHeight": 1152
    },
    "var_1f023231850d": {
      "type": "variant",
      "label": "Map-led Dispatch — Dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 9240,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n.tempo-screen{--bg:#0b0e0d;--surface:#111615;--surface-raised:#151b19;--line:#29322f;--line-soft:#202825;--text:#edf2ef;--muted:#99a6a0;--subtle:#717f78;--mint:#45d9b1;--mint-dim:#143a30;--red:#f07183;--red-dim:#391d25;--amber:#e9bd58;--amber-dim:#332b19;min-height:100vh;background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.5;overflow-x:clip}.tempo-screen *{box-sizing:border-box}.mono{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums}.app-header{height:74px;border-bottom:1px solid var(--line-soft);display:flex;align-items:center;padding:0 44px;gap:48px;background:#0d1110}.brand{display:flex;align-items:center;gap:11px;min-width:225px}.brand-mark{width:34px;height:34px;border-radius:10px;background:var(--mint);display:grid;place-items:center;color:#07110e;font-size:18px;font-weight:700;letter-spacing:-.06em}.brand-name{font-size:17px;font-weight:700;letter-spacing:-.035em}.brand-sub{font-size:11px;color:var(--muted);margin-top:1px}.top-nav{display:flex;align-items:center;gap:8px;height:100%;flex:1}.top-nav a{height:42px;display:flex;align-items:center;gap:9px;padding:0 14px;color:#a8b1ac;text-decoration:none;border-radius:7px;font-weight:600;font-size:13px;white-space:nowrap}.top-nav a i{font-size:17px;color:#89958f}.top-nav a.active{color:#f1f7f3;background:#17211e;box-shadow:inset 0 -2px 0 var(--mint)}.top-nav a.active i{color:var(--mint)}.nav-count{font:500 11px 'IBM Plex Mono',monospace;color:var(--red);margin-left:1px}.header-state{display:flex;align-items:center;justify-content:flex-end;gap:11px;white-space:nowrap}.state-demo,.state-offline{display:inline-flex;align-items:center;gap:8px;border-radius:6px;padding:7px 10px;font-size:11px;font-weight:600;letter-spacing:.01em}.state-demo{color:var(--amber);background:#211e16;border:1px solid #3c3421}.state-offline{color:#d1a0a7;background:#21171a;border:1px solid #3c262c}.state-demo:before,.state-offline:before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor;flex-shrink:0}.page-wrap{max-width:1490px;margin:0 auto;padding:28px 44px 56px}.page-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22px;gap:20px}.page-head h1{font-size:25px;line-height:1.2;letter-spacing:-.045em;margin:0;font-weight:700}.page-head p{color:var(--muted);margin:6px 0 0;font-size:14px}.head-note{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px}.head-note i{font-size:17px;color:var(--amber)}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:20px}.metric{padding:15px 24px 15px 0;position:relative;min-width:0}.metric:not(:first-child){padding-left:24px}.metric:not(:last-child):after{content:'';position:absolute;right:0;top:16px;bottom:16px;width:1px;background:var(--line)}.metric-label{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px;font-weight:500}.metric-value{display:flex;align-items:baseline;gap:8px;margin-top:6px;font:600 24px/1.15 'IBM Plex Mono',monospace;letter-spacing:-.04em}.metric-value small{font:500 12px 'DM Sans',sans-serif;color:var(--muted);letter-spacing:0}.metric-value.critical{color:var(--red)}.metric-value.accent{color:var(--mint)}.metric-detail{font-size:11px;color:var(--subtle);margin-top:4px}.demo-strip{min-height:34px;display:flex;align-items:center;gap:9px;padding:7px 11px;color:#c9baa0;background:#191712;border:1px solid #332c1d;border-radius:6px;font-size:12px;margin-bottom:16px}.demo-strip i{color:var(--amber);font-size:16px;flex:none}.work-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:16px;align-items:stretch}.map-panel,.selected-panel,.alerts-panel,.bmc-panel,.fleet-panel{background:var(--surface);border:1px solid var(--line);border-radius:10px}.map-panel{min-width:0;overflow:hidden}.map-head{height:54px;padding:0 17px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line-soft);gap:10px}.panel-title{font-size:14px;font-weight:600;letter-spacing:-.01em;margin:0}.panel-meta{display:flex;align-items:center;gap:11px;color:var(--muted);font-size:11px}.map-tag{display:flex;align-items:center;gap:6px;color:#b6c5bd;background:#18201d;border:1px solid #29342f;border-radius:5px;padding:4px 8px;font-size:10px}.map-tag i{font-size:13px;color:var(--amber)}.icon-button{width:32px;height:32px;border:1px solid var(--line);border-radius:6px;background:#151b19;color:#d5ded9;display:grid;place-items:center;font-size:16px}.map-canvas{position:relative;height:414px;overflow:hidden;background:#151b19;background-image:radial-gradient(ellipse at 51% 43%,#202925 0,#171e1b 44%,#121715 100%)}.map-canvas:after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,rgba(10,14,13,.02),rgba(10,14,13,.1))}.map-svg{width:100%;height:100%;position:absolute;inset:0}.map-label{font:11px 'DM Sans',sans-serif;fill:#718078;letter-spacing:.025em}.map-label.major{font-size:13px;fill:#a9b4ae;font-weight:600}.map-road{fill:none;stroke:#2a3530;stroke-width:10;stroke-linecap:round;opacity:.66}.map-road-core{fill:none;stroke:#1d2723;stroke-width:6;stroke-linecap:round}.map-local{fill:none;stroke:#27322e;stroke-width:2;opacity:.78}.map-suburban{fill:#17221d;stroke:#243029;stroke-width:1}.map-route{fill:none;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}.route-critical{stroke:var(--red);stroke-dasharray:2 0}.route-watch{stroke:var(--amber);stroke-dasharray:7 7;opacity:.87}.route-normal{stroke:var(--mint);stroke-dasharray:5 6;opacity:.82}.map-marker{position:absolute;z-index:2;transform:translate(-50%,-50%);display:flex;align-items:center