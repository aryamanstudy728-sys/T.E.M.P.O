amily:'IBM Plex Mono',monospace;font-size:12px;color:#d7dfda;font-weight:500}.extra-mobile .unknown{color:#89948e}.stage{font-size:10px}.risk-tag{min-height:28px}.reroute{height:40px}.no-action{display:none}.ledger-foot{align-items:flex-start;font-size:12px;line-height:1.4}.rail{grid-template-columns:1fr}.vehicle-panel{grid-column:auto}.page-footer{align-items:flex-start;flex-direction:column}.accessibility-legend{gap:9px 12px}.result-panel{order:0}.vehicle-panel{order:1}.route-order-hint{display:none}}\n@media(max-width:380px){.nav-link{padding:0 8px}.nav-link span{font-size:12px}.feed-state{font-size:11px}.stop-row{grid-template-columns:30px minmax(0,1fr) auto;column-gap:7px}.risk-tag{padding:0 6px;font-size:10px}.stop-name strong{font-size:13px}}\n</style>\n<style>\n    .extra-mobile{display:none}\n</style>\n<div class=\"route-ui\" data-kid=\"1\" data-name=\"route management dashboard root\">\n    <header class=\"topbar\" data-kid=\"1-1\" data-name=\"top application bar\">\n        <div class=\"brand\" data-kid=\"1-1-1\" data-name=\"brand logo cluster\">\n            <div class=\"brand-mark\" data-kid=\"1-1-1-1\" data-name=\"brand monogram tile\">\n                T\n            </div>\n            <span data-kid=\"1-1-1-2\" data-name=\"brand wordmark\">\n                T.E.M.P.O.\n            </span>\n        </div>\n        <nav aria-label=\"Main navigation\" class=\"main-nav\" data-kid=\"1-1-2\" data-name=\"main primary navigation\">\n            <a class=\"nav-link\" data-kid=\"1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#dashboard\">\n                <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard\" data-kid=\"1-1-2-1-1\" data-name=\"dashboard grid icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"dashboard nav label\">\n                    Dashboard\n                </span>\n            </a>\n            <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-2-2\" data-name=\"routes navigation link active\" href=\"#routes\">\n                <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-1-2-2-1\" data-name=\"route icon\">\n                </i>\n                <span data-kid=\"1-1-2-2-2\" data-name=\"routes nav label\">\n                    Routes\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-3\" data-name=\"alerts navigation link\" href=\"#alerts\">\n                <i aria-hidden=\"true\" class=\"ti ti-alert-triangle\" data-kid=\"1-1-2-3-1\" data-name=\"alert triangle icon\">\n                </i>\n                <span data-kid=\"1-1-2-3-2\" data-name=\"alerts nav label\">\n                    Alerts\n                </span>\n            </a>\n            <a class=\"nav-link\" data-kid=\"1-1-2-4\" data-name=\"analytics navigation link\" href=\"#analytics\">\n                <i aria-hidden=\"true\" class=\"ti ti-chart-bar\" data-kid=\"1-1-2-4-1\" data-name=\"bar chart icon\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\" data-name=\"analytics nav label\">\n                    Analytics\n                </span>\n            </a>\n        </nav>\n        <div class=\"header-right\" data-kid=\"1-1-3\" data-name=\"header right actions area\">\n            <div aria-label=\"Data state: demo data, not live\" class=\"feed-state\" data-kid=\"1-1-3-1\" data-name=\"feed data state badge\">\n                <span class=\"state-dot\" data-kid=\"1-1-3-1-1\" data-name=\"feed state warning dot\">\n                </span>\n                <span data-kid=\"1-1-3-1-2\" data-name=\"feed state label text\">\n                    Demo data · not live\n                </span>\n            </div>\n        </div>\n    </header>\n    <main class=\"content\" data-kid=\"1-2\" data-name=\"main content wrapper\">\n        <section class=\"page-head\" data-kid=\"1-2-1\" data-name=\"page title header row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title block\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page heading\">\n                    Route management\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page subtitle text\">\n                    Review the collection sequence and protect thermal buffer at each stop.\n                </p>\n            </div>\n            <div class=\"route-order-hint\" data-kid=\"1-2-1-2\" data-name=\"route ordering hint\">\n                <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-2-1-2-1\" data-name=\"route icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"route ordering hint label\">\n                    Ordered by planned arrival\n                </span>\n            </div>\n        </section>\n        <div class=\"demo-note\" data-kid=\"1-2-2\" data-name=\"demographic data disclaimer note\" role=\"note\">\n            <i aria-hidden=\"true\" class=\"ti ti-info-circle\" data-kid=\"1-2-2-1\" data-name=\"info circle icon\">\n            </i>\n            <span data-kid=\"1-2-2-2\" data-name=\"disclaimer body text\">\n                <strong data-kid=\"1-2-2-2-1\" data-name=\"disclaimer emphasis label\">\n                    Demonstration route.\n                </strong>\n                Stops, times and volumes are simulated. TSB thresholds are model estimates, not validated safety limits.\n            </span>\n        </div>\n        <section aria-label=\"Route controls\" class=\"controls\" data-kid=\"1-2-3\" data-name=\"route controls bar\">\n            <div class=\"select-side\" data-kid=\"1-2-3-1\" data-name=\"vehicle selector row\">\n                <label class=\"vehicle-label\" data-kid=\"1-2-3-1-1\" data-name=\"vehicle field label\" for=\"vehicle-select\">\n                    Vehicle\n                </label>\n                <div class=\"vehicle-select-wrap\" data-kid=\"1-2-3-1-2\" data-name=\"vehicle select wrapper\">\n                    <select class=\"vehicle-select\" data-kid=\"1-2-3-1-2-1\" data-name=\"vehicle selection dropdown\" id=\"vehicle-select\">\n                        <option data-kid=\"1-2-3-1-2-1-1\" data-name=\"vehicle option tanker 2\">\n                            Tanker 2 · VEH-002\n                        </option>\n                        <option data-kid=\"1-2-3-1-2-1-2\" data-name=\"vehicle option tanker 1\">\n                            Tanker 1 · VEH-001\n                        </option>\n                        <option data-kid=\"1-2-3-1-2-1-3\" data-name=\"vehicle option tanker 3\">\n                            Tanker 3 · VEH-003\n                        </option>\n                    </select>\n                    <i aria-hidden=\"true\" class=\"ti ti-chevron-down\" data-kid=\"1-2-3-1-2-2\" data-name=\"select chevron down icon\">\n                    </i>\n                </div>\n                <div class=\"route-meta\" data-kid=\"1-2-3-1-3\" data-name=\"route metadata summary\">\n                    <strong data-kid=\"1-2-3-1-3-1\" data-name=\"route metadata label\">\n                        Collection round\n                    </strong>\n                    <span class=\"sep\" data-kid=\"1-2-3-1-3-2\" data-name=\"metadata separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-3-1-3-3\" data-name=\"metadata stop count\">\n                        4 village stops\n                    </span>\n                    <span class=\"sep\" data-kid=\"1-2-3-1-3-4\" data-name=\"metadata separator dot\">\n                        ·\n                    </span>\n                    <span data-kid=\"1-2-3-1-3-5\" data-name=\"metadata return destination\">\n                        Bulk Milk Cooler 1 return\n                    </span>\n                </div>\n            </div>\n            <button class=\"btn-primary\" data-kid=\"1-2-3-2\" data-name=\"optimize route call-to-action button\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-2-3-2-1\" data-name=\"route icon\">\n                </i>\n                Optimize route\n            </button>\n        </section>\n        <div class=\"workspace\" data-kid=\"1-2-4\" data-name=\"main workspace grid\">\n            <section aria-labelledby=\"stop-ledger-title\" class=\"ledger\" data-kid=\"1-2-4-1\" data-name=\"collection sequence ledger panel\">\n                <div class=\"ledger-head\" data-kid=\"1-2-4-1-1\" data-name=\"ledger header row\">\n                    <div class=\"ledger-title\" data-kid=\"1-2-4-1-1-1\" data-name=\"ledger title cluster\">\n                        <h2 data-kid=\"1-2-4-1-1-1-1\" data-name=\"ledger title heading\" id=\"stop-ledger-title\">\n                            Collection sequence\n                        </h2>\n                        <span class=\"count\" data-kid=\"1-2-4-1-1-1-2\" data-name=\"ledger stop count badge\">\n                            5 stops\n                        </span>\n                    </div>\n                    <div class=\"route-total\" data-kid=\"1-2-4-1-1-2\" data-name=\"route completion summary\">\n                        <i aria-hidden=\"true\" class=\"ti ti-circle-check\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"completion check icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-1-1-2-2\" data-name=\"completed count text\">\n                            1 completed\n                        </span>\n                        <span data-kid=\"1-2-4-1-1-2-3\" data-name=\"completion separator dot\" style=\"color:#58625d\">\n                            ·\n                        </span>\n                        <span data-kid=\"1-2-4-1-1-2-4\" data-name=\"remaining stops text\">\n                            3 collection stops remaining\n                        </span>\n                    </div>\n                </div>\n                <div aria-hidden=\"true\" class=\"column-head\" data-kid=\"1-2-4-1-2\" data-name=\"ledger column header row\">\n           