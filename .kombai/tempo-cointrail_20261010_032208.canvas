ar\" data-kid=\"1-1\" data-name=\"app top navigation bar\">\n        <div class=\"top-left\" data-kid=\"1-1-1\" data-name=\"top bar left group\">\n            <div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"app brand with logo and name\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo mark\">\n                    T\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"app name text\">\n                    T.E.M.P.O.\n                </span>\n            </div>\n            <nav aria-label=\"Primary navigation\" class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"dashboard navigation link\" href=\"#dashboard\">\n                    Dashboard\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"routes navigation link\" href=\"#routes\">\n                    Routes\n                </a>\n                <a aria-current=\"page\" class=\"active\" data-kid=\"1-1-1-2-3\" data-name=\"alerts navigation link (active page)\" href=\"#alerts\">\n                    Alerts\n                </a>\n                <a data-kid=\"1-1-1-2-4\" data-name=\"analytics navigation link\" href=\"#analytics\">\n                    Analytics\n                </a>\n            </nav>\n        </div>\n        <div class=\"top-actions\" data-kid=\"1-1-2\" data-name=\"top bar right actions\">\n            <div class=\"dataset-badge\" data-kid=\"1-1-2-1\" data-name=\"demo scenario dataset badge\">\n                <i class=\"ti ti-database-off\" data-kid=\"1-1-2-1-1\" data-name=\"disconnected database icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"demo scenario label text\">\n                    Demo scenario · not live\n                </span>\n            </div>\n            <span class=\"profile-chip\" data-kid=\"1-1-2-2\" data-name=\"user role profile chip\">\n                Dispatcher\n            </span>\n        </div>\n    </header>\n    <main class=\"page\" data-kid=\"1-2\" data-name=\"main page content\">\n        <div class=\"page-heading\" data-kid=\"1-2-1\" data-name=\"page heading row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title and subtitle container\">\n                <h1 data-kid=\"1-2-1-1-1\" data-name=\"page title\">\n                    Alert center\n                </h1>\n                <p data-kid=\"1-2-1-1-2\" data-name=\"page subtitle text\">\n                    Review milk-safety, route, and facility events.\n                </p>\n            </div>\n            <div class=\"heading-note\" data-kid=\"1-2-1-2\" data-name=\"live feed unavailable note\">\n                <i class=\"ti ti-clock-exclamation\" data-kid=\"1-2-1-2-1\" data-name=\"clock with exclamation icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"live feed unavailable label\">\n                    Live alert feed unavailable\n                </span>\n            </div>\n        </div>\n        <div class=\"data-notice\" data-kid=\"1-2-2\" data-name=\"demo data warning notice\" role=\"status\">\n            <i class=\"ti ti-alert-triangle\" data-kid=\"1-2-2-1\" data-name=\"warning triangle icon\">\n            </i>\n            <div data-kid=\"1-2-2-2\" data-name=\"notice text container\">\n                <strong data-kid=\"1-2-2-2-1\" data-name=\"notice headline\">\n                    Live alerts are unavailable.\n                </strong>\n                <span data-kid=\"1-2-2-2-2\" data-name=\"notice description text\">\n                    Demo records are shown for layout only; they do not describe current route or milk conditions.\n                </span>\n            </div>\n        </div>\n        <section aria-label=\"Alert totals\" class=\"metrics\" data-kid=\"1-2-3\" data-name=\"alert metrics summary panel\">\n            <div class=\"metric\" data-kid=\"1-2-3-1\" data-name=\"total alerts metric\">\n                <span class=\"metric-label\" data-kid=\"1-2-3-1-1\" data-name=\"total alerts label\">\n                    Total alerts\n                </span>\n                <span class=\"metric-value\" data-kid=\"1-2-3-1-2\" data-name=\"total alerts count\">\n                    06\n                </span>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-3-2\" data-name=\"critical alerts metric\">\n                <span class=\"metric-label\" data-kid=\"1-2-3-2-1\" data-name=\"critical alerts label\">\n                    Critical\n                </span>\n                <span class=\"metric-value critical\" data-kid=\"1-2-3-2-2\" data-name=\"critical alerts count\">\n                    02\n                </span>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-3-3\" data-name=\"warning alerts metric\">\n                <span class=\"metric-label\" data-kid=\"1-2-3-3-1\" data-name=\"warning alerts label\">\n                    Warning\n                </span>\n                <span class=\"metric-value warning\" data-kid=\"1-2-3-3-2\" data-name=\"warning alerts count\">\n                    02\n                </span>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-3-4\" data-name=\"info alerts metric\">\n                <span class=\"metric-label\" data-kid=\"1-2-3-4-1\" data-name=\"info alerts label\">\n                    Info\n                </span>\n                <span class=\"metric-value info\" data-kid=\"1-2-3-4-2\" data-name=\"info alerts count\">\n                    02\n                </span>\n            </div>\n            <div class=\"metric\" data-kid=\"1-2-3-5\" data-name=\"unacknowledged alerts metric\">\n                <span class=\"metric-label\" data-kid=\"1-2-3-5-1\" data-name=\"unacknowledged alerts label\">\n                    Unacknowledged\n                </span>\n                <span class=\"metric-value mint\" data-kid=\"1-2-3-5-2\" data-name=\"unacknowledged alerts count\">\n                    03\n                </span>\n            </div>\n        </section>\n        <div class=\"work-grid\" data-kid=\"1-2-4\" data-name=\"work area two-column grid\">\n            <section aria-labelledby=\"all-alerts-title\" class=\"work-panel\" data-kid=\"1-2-4-1\" data-name=\"alerts list panel\">\n                <div class=\"panel-head\" data-kid=\"1-2-4-1-1\" data-name=\"alerts panel header\">\n                    <span class=\"panel-title\" data-kid=\"1-2-4-1-1-1\" data-name=\"alerts panel title\" id=\"all-alerts-title\">\n                        All alerts\n                    </span>\n                    <span class=\"panel-meta\" data-kid=\"1-2-4-1-1-2\" data-name=\"alerts record count meta\">\n                        6 demo records\n                    </span>\n                </div>\n                <div class=\"controls\" data-kid=\"1-2-4-1-2\" data-name=\"alerts controls bar\">\n                    <label class=\"searchbox\" data-kid=\"1-2-4-1-2-1\" data-name=\"alerts search field\">\n                        <i class=\"ti ti-search\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"search icon\">\n                        </i>\n                        <input aria-label=\"Search alerts\" data-kid=\"1-2-4-1-2-1-2\" data-name=\"search input\" id=\"alert-search\" placeholder=\"Search message, vehicle, or VCC\" type=\"search\"/>\n                    </label>\n                    <div aria-label=\"Filter by severity\" class=\"filters\" data-kid=\"1-2-4-1-2-2\" data-name=\"severity filter group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"filter-btn active\" data-filter=\"all\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"show all filter button\">\n                            All\n                            <span data-kid=\"1-2-4-1-2-2-1-1\" data-name=\"all filter count\">\n                                06\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"filter-btn\" data-filter=\"critical\" data-kid=\"1-2-4-1-2-2-2\" data-name=\"critical filter button\">\n                            Critical\n                            <span data-kid=\"1-2-4-1-2-2-2-1\" data-name=\"critical filter count\">\n                                02\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"filter-btn\" data-filter=\"warning\" data-kid=\"1-2-4-1-2-2-3\" data-name=\"warning filter button\">\n                            Warning\n                            <span data-kid=\"1-2-4-1-2-2-3-1\" data-name=\"warning filter count\">\n                                02\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"filter-btn\" data-filter=\"info\" data-kid=\"1-2-4-1-2-2-4\" data-name=\"info filter button\">\n                            Info\n                            <span data-kid=\"1-2-4-1-2-2-4-1\" data-name=\"info filter count\">\n                                02\n                            </span>\n                        </button>\n                    </div>\n                    <span class=\"result-count\" data-dynamic=\"true\" data-kid=\"1-2-4-1-2-3\" data-name=\"visible result count text\" data-reason=\"text rewritten by filter/search handler to reflect matching row count\" id=\"result-count\">\n                        Showing 6\n                    </span>\n                </div>\n                <div class=\"table-scroll\" data-kid=\"1-2-4-1-3\" data-name=\"alerts table scroll wrapper\">\n                    <table aria-label=\"Alert records in demo scenario\" class=\"alert-table\" data-kid=\"1-2-4-1-3-1\" data-name=\"alerts data table\">\n                        <colgroup data-kid=\"1-2-4-1-3-1-1\" data-name=\"table column definitions\">\n                            <col data-kid=\"1-2-4-1-3-1-1-1\" d