    },
    "var_09c7116f7812": {
      "type": "variant",
      "label": "Map-led Dispatch — Routes",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 16940,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css');\n#tempo-shell{--canvas:#0c0f10;--surface:#121718;--surface-raised:#171d1e;--surface-soft:#1b2222;--line:#293132;--line-strong:#384242;--ink:#e9efed;--muted:#a0aaa7;--quiet:#75817e;--mint:#47d8bb;--mint-dim:#173c36;--mint-ink:#8aefda;--yellow:#e5b94e;--yellow-dim:#3b321c;--red:#f17483;--red-dim:#421f27;--neutral-pill:#222929;min-height:100vh;background:var(--canvas);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.45;font-variant-numeric:tabular-nums;}\n#tempo-shell *{box-sizing:border-box;}\n#tempo-shell a{color:inherit;text-decoration:none;}\n#tempo-shell button,#tempo-shell select{font:inherit;}\n#tempo-shell button:focus-visible,#tempo-shell a:focus-visible,#tempo-shell select:focus-visible{outline:2px solid var(--mint);outline-offset:3px;}\n#tempo-shell .mono{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums;}\n#tempo-shell .topbar{height:68px;border-bottom:1px solid var(--line);background:#0e1112;}\n#tempo-shell .topbar-inner{max-width:1440px;height:100%;margin:0 auto;padding:0 30px;display:flex;align-items:center;gap:34px;}\n#tempo-shell .brand{display:flex;align-items:center;gap:10px;min-width:208px;font-weight:700;letter-spacing:-.035em;font-size:17px;}\n#tempo-shell .brand-mark{width:32px;height:32px;border-radius:9px;background:var(--mint);display:grid;place-items:center;color:#0c1715;font-size:16px;font-weight:700;}\n#tempo-shell .brand-sub{font-size:11px;font-weight:500;letter-spacing:0;color:var(--muted);margin-left:2px;}\n#tempo-shell .nav{display:flex;align-items:center;gap:5px;height:100%;}\n#tempo-shell .nav-link{height:100%;display:flex;align-items:center;gap:9px;padding:0 15px;color:var(--muted);font-size:14px;position:relative;white-space:nowrap;}\n#tempo-shell .nav-link:hover{color:var(--ink);background:rgba(255,255,255,.025);}\n#tempo-shell .nav-link.active{color:var(--ink);font-weight:600;}\n#tempo-shell .nav-link.active::after{content:'';position:absolute;bottom:-1px;left:15px;right:15px;height:2px;background:var(--mint);}\n#tempo-shell .nav-link i{font-size:17px;color:var(--quiet);}\n#tempo-shell .nav-link.active i{color:var(--mint);}\n#tempo-shell .shell-status{margin-left:auto;display:inline-flex;align-items:center;gap:9px;color:#f0b0b7;background:#281a1d;border:1px solid #543036;border-radius:999px;padding:8px 12px;font-size:13px;font-weight:600;white-space:nowrap;}\n#tempo-shell .status-dot{width:7px;height:7px;border-radius:50%;background:var(--red);}\n#tempo-shell .content{max-width:1440px;padding:28px 30px 48px;margin:0 auto;}\n#tempo-shell .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:21px;}\n#tempo-shell .page-title{font-size:27px;line-height:1.15;letter-spacing:-.045em;font-weight:700;margin:0 0 6px;}\n#tempo-shell .page-desc{margin:0;color:var(--muted);font-size:14px;}\n#tempo-shell .head-actions{display:flex;align-items:center;gap:10px;}\n#tempo-shell .vehicle-select{height:42px;min-width:208px;padding:0 13px;border:1px solid var(--line-strong);border-radius:10px;background:var(--surface);color:var(--ink);display:flex;align-items:center;justify-content:space-between;gap:20px;}\n#tempo-shell .vehicle-select strong{font-weight:600;}\n#tempo-shell .vehicle-select .vehicle-id{display:block;color:var(--muted);font:11px 'IBM Plex Mono',monospace;line-height:1.4;margin-top:1px;}\n#tempo-shell .primary-button{height:42px;border:0;border-radius:9px;background:var(--mint);color:#091512;padding:0 17px;font-weight:700;display:inline-flex;align-items:center;gap:9px;white-space:nowrap;}\n#tempo-shell .primary-button:hover{background:#69e5cc;}\n#tempo-shell .demo-banner{display:flex;align-items:center;gap:12px;padding:12px 15px;border:1px solid #3c3421;background:#211d14;border-radius:10px;margin-bottom:14px;color:#e6d8ad;}\n#tempo-shell .demo-flag{font-size:13px;font-weight:700;color:var(--yellow);white-space:nowrap;display:flex;align-items:center;gap:8px;}\n#tempo-shell .demo-flag i{font-size:16px;}\n#tempo-shell .demo-copy{font-size:13px;color:#c7bd9d;}\n#tempo-shell .state-note{color:var(--muted);font-size:13px;margin:-2px 0 18px;}\n#tempo-shell .priority-strip{display:flex;align-items:center;gap:13px;padding:13px 15px;border:1px solid #57323a;border-radius:10px;background:linear-gradient(90deg,rgba(98,37,49,.36),rgba(24,22,22,.34));margin-bottom:19px;}\n#tempo-shell .priority-icon{width:34px;height:34px;border-radius:9px;background:#3e2027;color:var(--red);display:grid;place-items:center;flex-shrink:0;font-size:17px;}\n#tempo-shell .priority-copy{flex:1;min-width:0;}\n#tempo-shell .priority-title{font-size:14px;font-weight:700;color:#f4dfe2;}\n#tempo-shell .priority-desc{font-size:13px;color:#c9afb3;margin-top:2px;}\n#tempo-shell .priority-desc strong{color:#ffc2c8;font-weight:600;}\n#tempo-shell .reroute-button{height:36px;border:1px solid #94505c;border-radius:8px;background:#3a2026;color:#ffd9dd;padding:0 13px;display:inline-flex;align-items:center;gap:7px;font-weight:600;font-size:13px;white-space:nowrap;}\n#tempo-shell .reroute-button:hover{background:#4a252d;}\n#tempo-shell .main-grid{display:grid;grid-template-columns:minmax(0,1fr) 344px;gap:18px;align-items:start;}\n#tempo-shell .table-panel{border:1px solid var(--line);border-radius:12px;background:var(--surface);overflow:hidden;}\n#tempo-shell .panel-head{padding:17px 18px 14px;display:flex;align-items:flex-start;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);}\n#tempo-shell .panel-title{margin:0;font-size:15px;font-weight:700;letter-spacing:-.01em;}\n#tempo-shell .panel-subtitle{font-size:13px;color:var(--muted);margin-top:3px;}\n#tempo-shell .route-count{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:13px;white-space:nowrap;}\n#tempo-shell .route-count strong{color:var(--ink);font-weight:600;}\n#tempo-shell .table-wrap{overflow-x:auto;}\n#tempo-shell table{width:100%;min-width:870px;border-collapse:collapse;text-align:left;}\n#tempo-shell thead th{background:#151a1b;color:#a8b1ae;font-size:12px;font-weight:600;padding:11px 10px;border-bottom:1px solid var(--line);white-space:nowrap;}\n#tempo-shell thead th:first-child,#tempo-shell tbody td:first-child{padding-left:18px;}\n#tempo-shell tbody td{padding:13px 10px;border-bottom:1px solid #222a2b;font-size:13px;vertical-align:middle;white-space:nowrap;}\n#tempo-shell tbody tr:last-child td{border-bottom:0;}\n#tempo-shell tbody tr.priority-row{background:linear-gradient(90deg,rgba(79,33,42,.3),rgba(79,33,42,.08));}\n#tempo-shell tbody tr:hover{background-color:#1a2021;}\n#tempo-shell .seq{color:var(--quiet);font:12px 'IBM Plex Mono',monospace;}\n#tempo-shell .stop-name{font-weight:600;color:var(--ink);white-space:normal;min-width:158px;}\n#tempo-shell .stop-id{display:block;color:var(--quiet);font:11px 'IBM Plex Mono',monospace;margin-top:3px;}\n#tempo-shell .time{font:12px 'IBM Plex Mono',monospace;color:#d7dfdc;}\n#tempo-shell .actual-recorded{color:var(--mint-ink);}\n#tempo-shell .empty-data{color:var(--quiet);font-size:12px;}\n#tempo-shell .volume{font:12px 'IBM Plex Mono',monospace;color:var(--ink);}\n#tempo-shell .temp{font:12px 'IBM Plex Mono',monospace;color:#dfe5e2;}\n#tempo-shell .estimate-mark{color:var(--yellow);font-size:11px;vertical-align:super;margin-left:2px;}\n#tempo-shell .tsb{font:12px 'IBM Plex Mono',monospace;font-weight:600;}\n#tempo-shell .tsb.safe{color:var(--mint-ink);}\n#tempo-shell .tsb.watch{color:#f0cf79;}\n#tempo-shell .tsb.critical{color:#ff9aa4;}\n#tempo-shell .risk-label{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;}\n#tempo-shell .risk-dot{width:7px;height:7px;border-radius:50%;display:inline-block;}\n#tempo-shell .risk-label.safe{color:var(--mint-ink);}.risk-label.safe .risk-dot{background:var(--mint);}\n#tempo-shell .risk-label.watch{color:#f0cf79;}.risk-label.watch .risk-dot{background:var(--yellow);}\n#tempo-shell .risk-label.critical{color:#ff9aa4;}.risk-label.critical .risk-dot{background:var(--red);}\n#tempo-shell .risk-label.pending{color:#aab4b1;}.risk-label.pending .risk-dot{background:#7c8985;}\n#tempo-shell .risk-label.destination{color:#bdc7c3;}.risk-label.destination .risk-dot{background:#697571;}\n#tempo-shell .table-foot{padding:12px 18px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:16px;color:var(--muted);font-size:12px;}\n#tempo-shell .legend{display:flex;align-items:center;gap:15px;flex-wrap:wrap;}\n#tempo-shell .legend-item{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}\n#tempo-shell .legend .risk-dot{width:6px;height:6px;}\n#tempo-shell .table-note{color:var(--quiet);text-align:right;}\n#tempo-shell .rail{display:flex;flex-direction:column;gap:14px;}\n#tempo-shell .rail-panel{border:1px solid var(--line);border-radius:12px;background:var(--surface);overflow:hidden;}\n#tempo-shell .rail-heading{display:flex;align-items:center;justify-content:space-between;padding:15px 16px;border-bottom:1px solid var(--line);}\n#tempo-shell .rail-heading h2{margin:0;font-size:14px;font-weight:700;}\n#tempo-shell .map-label{font-size:11px;color:var(--muted);display:flex;align-items:center;gap:6px;}\n#tempo-shell .map-stage{height:204px;position:relative;overflow:hidden;background:#111819;}\n#tempo-shell .map-stage::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(72,87,81,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(72,87,81,.09) 1px,transparent 1px);background-size:32px 32px;opacity:.42;}\n#tempo-shell .map-tag{position:absolute;z-index:1;background:#101616d9;border:1px solid #303938;border-radius:6px;padding:4px 7px;font-size:11px;color:#b4bfbb;}\n#tempo-shell .map-tag.pune{left:14px;top:12px;}\n#tempo-shell .map-tag.collector{right:12px;bottom:10px;color:#d9e2de;font-size:10px;}\n#tempo-shell .map-stage svg{position:absolute;inset:0;width:100%;height:100%;}\n#tempo-shell .map-foot{display:flex;justify-content:space-between;align-items:center;padding:10px 15px 12px;font-size:12px;color:var(--muted);}\n#tempo-shell .map-key{display:flex;align-items:center;gap:12px;}\n#tempo-shell .map-key span{display:inline-flex;align-items:center;gap:6px;}\n#tempo-shell .line-key{width:15px;height:2px;display:inline-block;background:var(--mint);}\n#tempo-shell .line-key.planned{background:var(--yellow);}\n#tempo-shell .vehicle-summary{padding:15px 16px 16px;}\n#tempo-shell .vehicle-summary-title{font-size:14px;font-weight:700;display:flex;align-items:center;gap:9px;}\n#tempo-shell .truck-mark{width:30px;height:30px;border-radius:8px;background:#173d36;color:var(--mint);display:grid;place-items:center;font-size:17px;}\n#tempo-shell .vehicle-summary-meta{font:11px 'IBM Plex Mono',monospace;color:var(--muted);margin-top:2px;}\n#tempo-shell .summary-stats{display:grid;grid-template-columns:1fr 1fr;gap:0;margin-top:15px;border-top:1px solid var(--line);padding-top:13px;}\n#tempo-shell .summary-stat + .summary-stat{border-left:1px solid var(--line);padding-left:14px;}\n#tempo-shell .summary-stat span{display:block;color:var(--muted);font-size:12px;}\n#tempo-shell .summary-stat strong{display:block;font:600 15px 'IBM Plex Mono',monospace;margin-top:4px;}\n#tempo-shell .simulation{padding:0;}\n#tempo-shell .simulation-head{padding:15px 16px 12px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px;border-bottom:1px solid var(--line);}\n#tempo-shell .simulation-head h2{margin:0;font-size:14px;font-weight:700;}\n#tempo-shell .sim-tag{font-size:11px;color:#e6ce89;background:#342e1b;border:1px solid #554824;border-radius:6px;padding:4px 7px;white-space:nowrap;}\n#tempo-shell .simulation-content{padding:13px 16px 15px;}\n#tempo-shell .change-line{display:flex;align-items:flex-start;gap:9px;color:#e2e8e5;font-size:13px;line-height:1.45;}\n#tempo-shell .change-icon{flex:none;width:19px;height:19px;border-radius:50%;background:#263a34;color:var(--mint);display:grid;place-items:center;font-size:12px;margin-top:1px;}\n#tempo-shell .change-line strong{font-weight:700;}\n#tempo-shell .change-reason{color:var(--muted);font-size:12px;margin:5px 0 12px 28px;line-height:1.4;}\n#tempo-shell .sim-metrics{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);padding-top:11px;gap:8px;}\n#tempo-shell .sim-metric span{display:block;font-size:12px;color:var(--muted);}\n#tempo-shell .sim-metric strong{display:block;font:600 16px 'IBM Plex Mono',monospace;margin-top:3px;}\n#tempo-shell .sim-note{font-size:11px;color:var(--quiet);line-height:1.45;margin-top:11px;}\n#tempo-shell .threshold-note{font-size:12px;color:var(--muted);line-height:1.5;margin-top:2px;}\n#tempo-shell .threshold-note strong{color:#e2ce96;font-weight:600;}\n#tempo-shell .route-mobile-hint{display:none;}\n@media(max-width:1050px){#tempo-shell .main-grid{grid-template-columns:minmax(0,1fr) 310px;}#tempo-shell .content{padding-left:22px;padding-right:22px;}#tempo-shell .topbar-inner{padding:0 22px;gap:18px;}#tempo-shell .brand{min-width:170px;}#tempo-shell .nav-link{padding:0 10px;}}\n@media(max-width:820px){#tempo-shell .topbar{height:auto;min-height:62px;}#tempo-shell .topbar-inner{padding:0 16px;flex-wrap:wrap;gap:0;}#tempo-shell .brand{min-width:0;height:62px;margin-right:auto;}#tempo-shell .nav{order:3;width:100%;height:47px;overflow-x:auto;border-top:1px solid var(--line);}#tempo-shell .nav-link{height:47px;padding:0 13px;}#tempo-shell .shell-status{margin-left:0;margin-right:0;padding:7px 10px;}#tempo-shell .content{padding:22px 16px 36px;}#tempo-shell .main-grid{grid-template-columns:1fr;}#tempo-shell .rail{display:grid;grid-template-columns:1fr 1fr;}#tempo-shell .rail-panel:first-child{grid-column:1/-1;}#tempo-shell .page-head{align-items:flex-start;flex-direction:column;}#tempo-shell .head-actions{width:100%;justify-content:space-between;}}\n@media(max-width:560px){#tempo-shell .content{padding:18px 12px 30px;}#tempo-shell .page-title{font-size:24px;}#tempo-shell .head-actions{align-items:stretch;flex-direction:column;}#tempo-shell .vehicle-select,#tempo-shell .primary-button{width:100%;justify-content:space-between;}#tempo-shell .demo-banner{align-items:flex-start;flex-direction:column;gap:4px;}#tempo-shell .priority-strip{align-items:flex-start;flex-wrap:wrap;padding:12px;}#tempo-shell .priority-copy{min-width:calc(100% - 50px);}#tempo-shell .reroute-button{margin-left:47px;}#tempo-shell .panel-head{padding:14px 12px;flex-direction:column;gap:8px;}#tempo-shell .table-wrap{position:relative;}#tempo-shell table{min-width:860px;}#tempo-shell thead th:first-child,#tempo-shell tbody td:first-child{position:sticky;left:0;z-index:2;background:#151a1b;}#tempo-shell tbody tr.priority-row td:first-child{background:#2b1b20;}#tempo-shell .route-mobile-hint{display:block;color:var(--quiet);font-size:12px;padding:9px 12px 0;}#tempo-shell .table-foot{align-items:flex-start;flex-direction:column;padding:12px;}#tempo-shell .table-note{text-align:left;}#tempo-shell .rail{display:flex;}#tempo-shell .rail-panel:first-child{grid-column:auto;}#tempo-shell .map-stage{height:190px;}#tempo-shell .priority-desc{line-height:1.5;}}\n</style>\n<div data-kid=\"1\" id=\"tempo-shell\">\n    <header class=\"topbar\" data-kid=\"1-1\">\n        <div class=\"topbar-inner\" data-kid=\"1-1-1\">\n            <a aria-label=\"T.E.M.P.O. dispatch home\" class=\"brand\" data-kid=\"1-1-1-1\" href=\"#\">\n                <span class=\"brand-mark\" data-kid=\"1-1-1-1-1\">\n                    T\n                </span>\n                <span data-kid=\"1-1-1-1-2\">\n                    T.E.M.P.O.\n                </span>\n                <span class=\"brand-sub\" data-kid=\"1-1-1-1-3\">\n                    Dispatch\n                </span>\n            </a>\n            <nav aria-label=\"Main navigation\" class=\"nav\" data-kid=\"1-1-1-2\">\n                <a class=\"nav-link\" data-kid=\"1-1-1-2-1\" href=\"#\">\n                    <i class=\"ti ti-layout-dashboard\" data-kid=\"1-1-1-2-1-1\">\n                    </i>\n                    Dashboard\n                </a>\n                <a aria-current=\"page\" class=\"nav-link active\" data-kid=\"1-1-1-2-2\" href=\"#\">\n                    <i class=\"ti ti-route\" data-kid=\"1-1-1-2-2-1\">\n                    </i>\n                    Routes\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-1-2-3\" href=\"#\">\n                    <i class=\"ti ti-alert-triangle\" data-kid=\"1-1-1-2-3-1\">\n                    </i>\n                    Alerts\n                </a>\n                <a class=\"nav-link\" data-kid=\"1-1-1-2-4\" href=\"#\">\n                    <i class=\"ti ti-chart-bar\" data-kid=\"1-1-1-2-4-1\">\n                    </i>\n                    Analytics\n                </a>\n            </nav>\n            <div aria-label=\"Data availability: unavailable\" class=\"shell-status\" data-dynamic=\"true\" data-kid=\"1-1-1-3\" data-name=\"API status indicator\" data-reason=\"status label and aria-label updated based on API connectivity\">\n                <span class=\"status-dot\" data-kid=\"1-1-1-3-1\">\n                </span>\n                API unavailable\n            </div>\n        </div>\n    </header>\n    <main class=\"content\" data-kid=\"1-2\">\n        <div class=\"page-head\" data-kid=\"1-2-1\">\n            <div data-kid=\"1-2-1-1\">\n                <h1 class=\"page-title\" data-kid=\"1-2-1-1-1\">\n                    Route management\n                </h1>\n                <p class=\"page-desc\" data-kid=\"1-2-1-1-2\">\n                    Review the collection sequence and act on stops with limited thermal margin.\n                </p>\n            </div>\n            <div class=\"head-actions\" data-kid=\"1-2-1-2\">\n                <button aria-label=\"Selected vehicle: Tanker 02\" class=\"vehicle-select\" data-kid=\"1-2-1-2-1\" type=\"button\">\n                    <span data-kid=\"1-2-1-2-1-1\">\n                        <strong data-kid=\"1-2-1-2-1-1-1\">\n                            Tanker 02\n                        </strong>\n                        <span class=\"vehicle-id\" data-kid=\"1-2-1-2-1-1-2\">\n                            VEH-002 · Selected vehicle\n                        </span>\n                    </span>\n                    <i class=\"ti ti-chevron-down\" data-kid=\"1-2-1-2-1-2\" style=\"font-size:16px;color:var(--muted)\">\n                    </i>\n                </button>\n                <button class=\"primary-button\" data-kid=\"1-2-1-2-2\" type=\"button\">\n                    <i class=\"ti ti-route\" data-kid=\"1-2-1-2-2-1\" style=\"font-size:17px\">\n                    </i>\n                    Optimize route\n                </button>\n            </div>\n        </div>\n        <div class=\"demo-banner\" data-kid=\"1-2-2\" role=\"note\">\n            <span class=\"demo-flag\" data-kid=\"1-2-2-1\">\n                <i class=\"ti ti-alert-triangle\" data-kid=\"1-2-2-1-1\">\n                </i>\n                Demo scenario · not live\n            </span>\n            <span class=\"demo-copy\" data-kid=\"1-2-2-2\">\n                Route values below are sample scenario data for review—not current dispatch readings.\n            </span>\n        </div>\n        <p class=\"state-note\" data-dynamic=\"true\" data-kid=\"1-2-3\" data-name=\"API unavailability disclaimer\" data-reason=\"text displayed when API data is unreachable\">\n            API data is unavailable. Current route, vehicle status and freshness are unknown; sample values are shown only to demonstrate the route workflow.\n        </p>\n        <section aria-label=\"Priority stop action\" class=\"priority-strip\" data-kid=\"1-2-4\">\n            <span class=\"priority-icon\" data-kid=\"1-2-4-1\">\n                <i class=\"ti ti-thermometer\" data-kid=\"1-2-4-1-1\">\n                </i>\n            </span>\n            <div class=\"priority-copy\" data-kid=\"1-2-4-2\">\n                <div class=\"priority-title\" data-kid=\"1-2-4-2-1\">\n                    Critical unvisited stop · Village Collection Center 3\n                </div>\n                <div class=\"priority-desc\" data-kid=\"1-2-4-2-2\">\n                    Sequence 03 · estimated arrival 05:44 ·\n                    <strong data-kid=\"1-2-4-2-2-1\">\n                        0.4 h modeled TSB\n                    </strong>\n                    falls below the prototype’s estimated 0.5 h red-band threshold.\n                </div>\n            </div>\n            <button class=\"reroute-button\" data-kid=\"1-2-4-3\" type=\"button\">\n                <i class=\"ti ti-route\" data-kid=\"1-2-4-3-1\" style=\"font-size:15px\">\n                </i>\n                Reroute\n            </button>\n        </section>\n        <div class=\"main-grid\" data-kid=\"1-2-5\">\n            <section aria-labelledby=\"stops-title\" class=\"table-panel\" data-kid=\"1-2-5-1\">\n                <div class=\"panel-head\" data-kid=\"1-2-5-1-1\">\n                    <div data-kid=\"1-2-5-1-1-1\">\n                        <h2 class=\"panel-title\" data-kid=\"1-2-5-1-1-1-1\" id=\"stops-title\">\n                            Collection route\n                        </h2>\n                        <div class=\"panel-subtitle\" data-kid=\"1-2-5-1-1-1-2\">\n                            Tanker 02 · village pickups followed by Bulk Milk Cooler 1\n                        </div>\n                    </div>\n                    <div class=\"route-count\" data-kid=\"1-2-5-1-1-2\">\n                        <strong data-kid=\"1-2-5-1-1-2-1\">\n                            5\n                        </strong>\n                        stops\n                        <span aria-hid