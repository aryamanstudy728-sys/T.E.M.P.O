      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n@import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap\");\n</style>\n<div class=\"min-h-screen bg-[#0c0f0e] font-['DM_Sans',sans-serif] text-[#eef3f1]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"sticky top-0 z-20 border-b border-[#252b28] bg-[#0c0f0e]/95 backdrop-blur-sm\" data-kid=\"1-1\" data-name=\"sticky site header\">\n        <div class=\"mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-8 py-4 max-md:px-4\" data-kid=\"1-1-1\" data-name=\"header inner toolbar\">\n            <div class=\"flex min-w-0 items-center gap-9\" data-kid=\"1-1-1-1\" data-name=\"header left group with logo and nav\">\n                <a class=\"flex shrink-0 items-center gap-3 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#56dfbf]\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#54ddbb] font-['Space_Grotesk',sans-serif] text-lg font-bold text-[#10201b]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand monogram badge\">\n                        T\n                    </span>\n                    <span class=\"font-['Space_Grotesk',sans-serif] text-lg font-semibold tracking-tight\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name text\">\n                        T.E.M.P.O.\n                    </span>\n                </a>\n                <nav aria-label=\"Main navigation\" class=\"flex items-center gap-1 max-md:hidden\" data-kid=\"1-1-1-1-2\" data-name=\"main navigation bar\">\n                    <a class=\"rounded-lg px-4 py-2.5 text-sm font-medium text-[#a4afaa] hover:bg-[#171d1a] hover:text-white focus-visible:outline-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-1-1-1-2-1\" data-name=\"operations nav link\" href=\"#\">\n                        Operations\n                    </a>\n                    <a class=\"rounded-lg px-4 py-2.5 text-sm font-medium text-[#a4afaa] hover:bg-[#171d1a] hover:text-white focus-visible:outline-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-1-1-1-2-2\" data-name=\"routes nav link\" href=\"#\">\n                        Routes\n                    </a>\n                    <a aria-current=\"page\" class=\"rounded-lg bg-[#1d2824] px-4 py-2.5 text-sm font-semibold text-[#6de5c6] focus-visible:outline-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-1-1-1-2-3\" data-name=\"active alerts nav link with badge\" href=\"#\">\n                        Alerts\n                        <span class=\"ml-1 tabular-nums text-[#f4c15c]\" data-kid=\"1-1-1-1-2-3-1\" data-name=\"alerts count badge\">\n                            04\n                        </span>\n                    </a>\n                    <a class=\"rounded-lg px-4 py-2.5 text-sm font-medium text-[#a4afaa] hover:bg-[#171d1a] hover:text-white focus-visible:outline-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-1-1-1-2-4\" data-name=\"analytics nav link\" href=\"#\">\n                        Analytics\n                    </a>\n                </nav>\n            </div>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-2\" data-name=\"header right group\">\n                <span class=\"inline-flex min-h-11 items-center gap-2 rounded-full border border-[#51452b] bg-[#211d13] px-3.5 text-[13px] font-medium text-[#f3d28a]\" data-kid=\"1-1-1-2-1\" data-name=\"demo scenario status pill\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#efbd58]\" data-kid=\"1-1-1-2-1-1\" data-name=\"demo status indicator dot\">\n                    </span>\n                    Demo scenario · not live\n                </span>\n                <button aria-label=\"Open menu\" class=\"hidden h-11 w-11 items-center justify-center rounded-lg border border-[#303733] text-lg text-[#d7dfdb] focus-visible:outline-2 focus-visible:outline-[#56dfbf] max-md:flex\" data-kid=\"1-1-1-2-2\" data-name=\"mobile menu button\">\n                    <i class=\"ti ti-menu-2\" data-kid=\"1-1-1-2-2-1\" data-name=\"menu hamburger icon\" style=\"width:20px;height:20px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1440px] px-8 pb-12 pt-8 max-md:px-4 max-md:pt-6\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"mb-7 flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-1\" data-name=\"page header title row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title group\">\n                <h1 class=\"font-['Space_Grotesk',sans-serif] text-[30px] font-semibold leading-tight tracking-[-0.035em]\" data-dynamic=\"true\" data-kid=\"1-2-1-1-1\" data-name=\"page headline\" data-reason=\"replaced at runtime by template-rendered page title\">\n                    Alert center\n                </h1>\n                <p class=\"mt-2 text-[15px] text-[#a6b0ac]\" data-kid=\"1-2-1-1-2\" data-name=\"page subtitle text\">\n                    Review thermal, collection and route exceptions.\n                </p>\n            </div>\n            <div class=\"flex items-center gap-2 text-[13px] text-[#a6b0ac]\" data-kid=\"1-2-1-2\" data-name=\"disclaimer notice row\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#171d1a] text-[#7ce6ca]\" data-kid=\"1-2-1-2-1\" data-name=\"disclaimer icon badge\">\n                    <i class=\"ti ti-info-circle\" data-kid=\"1-2-1-2-1-1\" data-name=\"info circle icon\" style=\"width:16px;height:16px\">\n                    </i>\n                </span>\n                Acknowledgement records review; it does not resolve risk.\n            </div>\n        </div>\n        <section aria-label=\"Alert totals\" class=\"mb-7 flex flex-wrap items-center gap-x-10 gap-y-4 border-y border-[#252b28] py-4 max-md:gap-x-6\" data-kid=\"1-2-2\" data-name=\"alert totals summary bar\">\n            <div class=\"min-w-[110px]\" data-kid=\"1-2-2-1\" data-name=\"total alerts stat\">\n                <div class=\"text-[13px] text-[#a1aba6]\" data-kid=\"1-2-2-1-1\" data-name=\"total alerts label\">\n                    Total alerts\n                </div>\n                <div class=\"mt-1 font-['Space_Grotesk',sans-serif] text-[24px] font-semibold tabular-nums\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"total alerts value\" data-reason=\"replaced at runtime by template-rendered count\">\n                    05\n                </div>\n            </div>\n            <div class=\"min-w-[110px]\" data-kid=\"1-2-2-2\" data-name=\"critical alerts stat\">\n                <div class=\"text-[13px] text-[#a1aba6]\" data-kid=\"1-2-2-2-1\" data-name=\"critical alerts label\">\n                    Critical\n                </div>\n                <div class=\"mt-1 flex items-baseline gap-2 font-['Space_Grotesk',sans-serif] text-[24px] font-semibold tabular-nums text-[#ff7b8b]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-2\" data-name=\"critical alerts value\" data-reason=\"replaced at runtime by template-rendered count\">\n                    02\n                    <span class=\"text-[13px] font-medium text-[#a1aba6]\" data-kid=\"1-2-2-2-2-1\" data-name=\"critical unit label\">\n                        alerts\n                    </span>\n                </div>\n            </div>\n            <div class=\"min-w-[110px]\" data-kid=\"1-2-2-3\" data-name=\"warning alerts stat\">\n                <div class=\"text-[13px] text-[#a1aba6]\" data-kid=\"1-2-2-3-1\" data-name=\"warning alerts label\">\n                    Warning\n                </div>\n                <div class=\"mt-1 flex items-baseline gap-2 font-['Space_Grotesk',sans-serif] text-[24px] font-semibold tabular-nums text-[#f1c35f]\" data-dynamic=\"true\" data-kid=\"1-2-2-3-2\" data-name=\"warning alerts value\" data-reason=\"replaced at runtime by template-rendered count\">\n                    02\n                    <span class=\"text-[13px] font-medium text-[#a1aba6]\" data-kid=\"1-2-2-3-2-1\" data-name=\"warning unit label\">\n                        alerts\n                    </span>\n                </div>\n            </div>\n            <div class=\"min-w-[145px]\" data-kid=\"1-2-2-4\" data-name=\"unacknowledged alerts stat\">\n                <div class=\"text-[13px] text-[#a1aba6]\" data-kid=\"1-2-2-4-1\" data-name=\"unacknowledged alerts label\">\n                    Unacknowledged\n                </div>\n                <div class=\"mt-1 flex items-baseline gap-2 font-['Space_Grotesk',sans-serif] text-[24px] font-semibold tabular-nums text-[#75e2c4]\" data-dynamic=\"true\" data-kid=\"1-2-2-4-2\" data-name=\"unacknowledged alerts value\" data-reason=\"replaced at runtime by template-rendered count\">\n                    04\n                    <span class=\"text-[13px] font-medium text-[#a1aba6]\" data-kid=\"1-2-2-4-2-1\" data-name=\"unacknowledged unit label\">\n                        need review\n                    </span>\n                </div>\n            </div>\n            <div class=\"ml-auto max-md:ml-0\" data-kid=\"1-2-2-5\" data-name=\"sidebar samples group\">\n                <span class=\"inline-flex items-center gap-2 rounded-md border border-[#303733] px-3 py-2 text-[13px] text-[#c3cdc8]\" data-kid=\"1-2-2-5-1\" data-name=\"sample records pill\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#efbd58]\" data-kid=\"1-2-2-5-1-1\" data-name=\"sample records dot\">\n                    </span>\n                    Sample records only\n                </span>\n            </div>\n        </section>\n        <div class=\"grid grid-cols-[minmax(0,1fr)_340px] items-start gap-7 max-lg:grid-cols-[minmax(0,1fr)_300px] max-md:grid-cols-1 max-md:gap-6\" data-kid=\"1-2-3\" data-name=\"main two-column layout\">\n            <section aria-labelledby=\"worklist-heading\" class=\"min-w-0\" data-kid=\"1-2-3-1\" data-name=\"alert worklist section\">\n                <div class=\"mb-5 flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-3-1-1\" data-name=\"worklist header row\">\n                    <div data-kid=\"1-2-3-1-1-1\" data-name=\"worklist heading group\">\n                        <h2 class=\"font-['Space_Grotesk',sans-serif] text-[18px] font-semibold\" data-dynamic=\"true\" data-kid=\"1-2-3-1-1-1-1\" data-name=\"worklist heading\" data-reason=\"replaced at runtime by template-rendered title\" id=\"worklist-heading\">\n                            Alert worklist\n                        </h2>\n                        <p class=\"mt-1 text-[13px] text-[#a1aba6]\" data-kid=\"1-2-3-1-1-1-2\" data-name=\"worklist record summary text\">\n                            Unacknowledged records first · 1 acknowledged record in history\n                        </p>\n                    </div>\n                    <button class=\"inline-flex min-h-11 items-center gap-2 rounded-lg border border-[#303733] px-3.5 text-[13px] font-medium text-[#d4ddd8] hover:bg-[#171d1a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-1-1-2\" data-name=\"filter options button\">\n                        <i class=\"ti ti-adjustments-horizontal text-[16px]\" data-kid=\"1-2-3-1-1-2-1\" data-name=\"slider filter icon\" style=\"width:16px;height:16px\">\n                        </i>\n                        Filter options\n                    </button>\n                </div>\n                <div class=\"mb-4 flex flex-wrap items-center gap-3\" data-kid=\"1-2-3-1-2\" data-name=\"worklist search and filter bar\">\n                    <label class=\"relative min-w-[260px] flex-1 max-md:min-w-full\" data-kid=\"1-2-3-1-2-1\" data-name=\"search field wrapper\">\n                        <span class=\"sr-only\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"search screen-reader label\">\n                            Search alerts\n                        </span>\n                        <i class=\"ti ti-search absolute left-3.5 top-1/2 -translate-y-1/2 text-[17px] text-[#89948f]\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"search magnifier icon\" style=\"width:17px;height:17px\">\n                        </i>\n                        <input class=\"h-12 w-full rounded-lg border border-[#343c38] bg-[#121614] pl-11 pr-4 text-[14px] text-[#eef3f1] placeholder:text-[#89948f] focus:border-[#58dcb9] focus:outline-2 focus:outline-[#58dcb9]/50\" data-kid=\"1-2-3-1-2-1-3\" data-name=\"search input field\" placeholder=\"Search message, vehicle or VCC\" type=\"search\"/>\n                    </label>\n                    <div aria-label=\"Filter by severity\" class=\"flex flex-wrap gap-2\" data-kid=\"1-2-3-1-2-2\" data-name=\"severity filter group\" role=\"group\">\n                        <button aria-pressed=\"true\" class=\"min-h-11 rounded-full bg-[#d9e7e1] px-4 text-[13px] font-semibold text-[#15201b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"all severity filter button\">\n                            All\n                            <span class=\"ml-1 tabular-nums\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"all severity count\">\n                                5\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 rounded-full border border-[#303733] px-4 text-[13px] font-medium text-[#c3cdc8] hover:bg-[#1b211e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"critical severity filter button\">\n                            Critical\n                            <span class=\"ml-1 tabular-nums text-[#ff8a98]\" data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"critical severity count\">\n                                2\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 rounded-full border border-[#303733] px-4 text-[13px] font-medium text-[#c3cdc8] hover:bg-[#1b211e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"warning severity filter button\">\n                            Warning\n                            <span class=\"ml-1 tabular-nums text-[#f2c45f]\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"warning severity count\">\n                                2\n                            </span>\n                        </button>\n                        <button aria-pressed=\"false\" class=\"min-h-11 rounded-full border border-[#303733] px-4 text-[13px] font-medium text-[#c3cdc8] hover:bg-[#1b211e] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#56dfbf]\" data-kid=\"1-2-3-1-2-2-4\" data-name=\"info severity filter button\">\n                            Info\n                            <span class=\"ml-1 tabular-nums\" data-kid=\"1-2-3-1-2-2-4-1\" data-name=\"info severity count\">\n                                1\n                            </span>\n                        </button>\n                    </div>\n                </div>\n                <div class=\"overflow-hidden rounded-xl border border-[#303733] bg-[#111513]\" data-kid=\"1-2-3-1-3\" data-name=\"alert worklist table card\">\n                    <div class=\"flex items-center justify-between border-b border-[#303733] px-5 py-3.5 max-md:px-4\" data-kid=\"1-2-3-1-3-1\" data-name=\"table group header row\">\n                        <div class=\"flex items-center gap-2 text-[13px] font-semibold text-[#dce5e0]\" data-kid=\"1-2-3-1-3-1-1\" data-name=\"needs acknowledgment group label\">\n                            <span class=\"h-2 w-2 rounded-full bg-[#f0c05d]\" data-kid=\"1-2-3-1-3-1-1-1\" data-name=\"warning indicator dot\">\n                            </span>\n                            Needs acknowledgment\n                            <span class=\"font-normal tabular-nums text-[#97a39d]\" data-kid=\"1-2-3-1-3-1-1-2\" data-name=\"needs acknowledgment count\">\n                                4\n                            </span>\n                        </div>\n                        <span class=\"text-[13px] text-[#97a39d]\" data-kid=\"1-2-3-1-3-1-2\" data-name=\"table sort note\">\n                            Sorted by severity, then time\n                        </span>\n                    </div>\n                    <div class=\"overflow-x-auto max-md:hidden\" data-kid=\"1-2-3-1-3-2\" data-name=\"table scroll container\">\n                        <table class=\"w-full min-w-[760px] border-collapse text-left\" data-kid=\"1-2-3-1-3-2-1\" data-name=\"alert worklist table\">\n                            <thead class=\"bg-[#151a17] text-[12px] font-medium text-[#aab5af]\" data-kid=\"1-2-3-1-3-2-1-1\" data-name=\"table header\">\n                                <tr data-kid=\"1-2-3-1-3-2-1-1-1\" data-name=\"table header row\">\n                                    <th class=\"px-4 py-3 font-medium\" data-kid=\"1-2-3-1-3-2-1-1-1-1\" data-name=\"type severity column header\">\n                                        Type / severity\n                                    </th>\n                                    <th class=\"px-4 py-3 font-medium\" data-kid=\"1-2-3-1-3-2-1-1-1-2\" data-name=\"alert column header\">\n                                        Alert\n                                    </th>\n                                    <th class=\"px-4 py-3 font-medium\" data-kid=\"1-2-3-1-3-2-1-1-1-3\" data-name=\"vehicle vcc column header\">\n                                        Vehicle · VCC\n                                    </th>\n                                    <th class=\"px-4 py-3 font-medium